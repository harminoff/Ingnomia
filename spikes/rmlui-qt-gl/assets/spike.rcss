body {
    width: 100%;
    height: 100%;
    margin: 0;
    color: #f2eadb;
    font-family: LatoLatin;
    font-size: 17dp;
    pointer-events: none;
    nav: auto;
}

#world-label {
    position: absolute;
    left: 18dp;
    bottom: 18dp;
    padding: 8dp 12dp;
    color: #f5c46c;
    background-color: #171d1cbb;
    border-width: 1dp;
    border-color: #9e7040;
}

.panel {
    pointer-events: auto;
    position: absolute;
    width: 620dp;
    max-height: 90%;
    right: 28dp;
    top: 24dp;
    padding: 22dp;
    overflow: hidden;
    background-color: #1f2727f2;
    border-width: 2dp;
    border-color: #9e7040;
    border-radius: 10dp;
    box-shadow: 0 12dp 30dp #000a;
}

h1, h2, p, footer { display: block; }
h1, h2, p { margin: 0 0 10dp 0; }
h1 { color: #f5c46c; font-size: 28dp; }
h2 { color: #d7b178; font-size: 20dp; }
.status { color: #bac7c2; }

.proof-row {
    display: flex;
    flex-direction: row;
    gap: 18dp;
    margin: 14dp 0;
}

.proof-image {
    width: 112dp;
    height: 112dp;
    border-width: 2dp;
    border-color: #6ba8a0;
}

button, input {
    display: block;
    min-width: 210dp;
    margin: 5dp 0;
    padding: 8dp 12dp;
    color: #f2eadb;
    background-color: #374442;
    border-width: 1dp;
    border-color: #778784;
    tab-index: auto;
    nav: auto;
}

button:hover { background-color: #4b5d59; border-color: #f5c46c; }
button:active { background-color: #26302e; }
button:focus-visible, input:focus-visible { border-width: 3dp; border-color: #77d7c8; }

.clip-frame {
    height: 210dp;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 12dp;
    background-color: #141a1a;
    border-width: 1dp;
    border-color: #53605e;
}

.clip-content { display: block; width: 540dp; min-height: 520dp; }
.clip-content h2, .clip-content p { width: 520dp; }

.transformed-clip {
    width: 260dp;
    height: 70dp;
    margin: 20dp 0;
    padding: 12dp;
    overflow: hidden;
    transform: rotate(2deg);
    border-radius: 18dp;
    background-color: #5f3f55;
    box-shadow: 0 5dp 16dp #000a;
}

footer { margin-top: 12dp; color: #91a19c; font-size: 14dp; }
