set(ROOT "${CMAKE_CURRENT_LIST_DIR}/../..")
file(READ "${ROOT}/content/rmlui/windows/population_manager.rml" POP)
file(READ "${ROOT}/content/rmlui/windows/inventory_browser.rml" INV)
file(READ "${ROOT}/content/rmlui/windows/management6b.rcss" STYLE)
file(READ "${ROOT}/src/gui/ui/screens/management6b/Management6BText.h" TEXT)
file(READ "${ROOT}/src/gui/ui/screens/management6b/Management6BRmlBinding.cpp" BINDING)
foreach(ID population_root population_heading population_close population_search population_tab_citizens population_tab_professions population_tab_schedules population_rows profession_rows schedule_rows schedule_set_none schedule_set_eat schedule_set_sleep schedule_set_training creature_detail creature_attributes creature_needs creature_equipment population_loading population_page_status)
  if(NOT POP MATCHES "id=\"${ID}\"")
    message(FATAL_ERROR "Population RML missing ${ID}")
  endif()
endforeach()
foreach(ID inventory_root inventory_heading inventory_close inventory_search inventory_filter_owned inventory_category_tabs inventory_rows inventory_refresh inventory_sort_name inventory_sort_total inventory_sort_value inventory_toggle_watch inventory_column_head inventory_page_status)
  if(NOT INV MATCHES "id=\"${ID}\"")
    message(FATAL_ERROR "Inventory RML missing ${ID}")
  endif()
endforeach()
foreach(NEEDLE "management6b.rcss" "data-l10n=" "data-l10n-placeholder=" "role=\"listbox\"" "role=\"grid\"" "role=\"tree\"" "tab-index=\"0\"")
  if(NOT POP MATCHES "${NEEDLE}" AND NOT INV MATCHES "${NEEDLE}")
    message(FATAL_ERROR "Management 6B RML missing localization/accessibility contract ${NEEDLE}")
  endif()
endforeach()
foreach(NEEDLE "l-m6b-window" "l-m6b-schedule" "l-m6b-depth-material" "l-m6b-row__sprite" "l-m6b-row__sprite-image" "l-m6b-inventory__metric" "l-m6b-inventory-row" "l-m6b-inventory-tabs" "scrollbarvertical" "slidertrack" "sliderbar" "sliderarrowdec" "sliderarrowinc" "overflow-y: scroll" "pointer-events: auto" "overflow: auto")
  if(NOT STYLE MATCHES "${NEEDLE}")
    message(FATAL_ERROR "Management 6B RCSS missing classic workbench rule ${NEEDLE}")
  endif()
endforeach()
foreach(NEEDLE "inventorySprite" "/tilesheet/" "spriteSheet" "spriteWidth" "spriteHeight" "sprite--empty")
  if(NOT BINDING MATCHES "${NEEDLE}")
    message(FATAL_ERROR "Management 6B inventory binding missing thumbnail rule ${NEEDLE}")
  endif()
endforeach()
if(NOT BINDING MATCHES "l-m6b-inventory__metric" OR NOT BINDING MATCHES "l-m6b-inventory-row")
  message(FATAL_ERROR "Management 6B inventory binding does not emit aligned metric columns")
endif()
foreach(NEEDLE "management.population.title" "management.population.schedule_note" "management.inventory.title" "management.inventory.tab_all" "management.inventory.filter_owned" "management.inventory.watching_selected" "management.inventory.row_summary" "management.inventory.column.resource" "status.refreshing")
  if(NOT TEXT MATCHES "${NEEDLE}")
    message(FATAL_ERROR "Management 6B owned localization catalog missing ${NEEDLE}")
  endif()
endforeach()
foreach(FORBIDDEN "onclick=" "onchange=" "generateRandomData" "job backlog" "health alert" "reserved total" "in transit" "inventory history")
  if(POP MATCHES "${FORBIDDEN}" OR INV MATCHES "${FORBIDDEN}")
    message(FATAL_ERROR "Unsupported or inline behavior present: ${FORBIDDEN}")
  endif()
endforeach()
message(STATUS "Management 6B RML contract verified")
