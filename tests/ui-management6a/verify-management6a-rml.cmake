set(ROOT "${CMAKE_CURRENT_LIST_DIR}/../..")
set(ALL_RML)
foreach(FILE IN ITEMS content/rmlui/windows/workshop_manager.rml content/rmlui/windows/stockpile_manager.rml content/rmlui/panels/agriculture_manager.rml)
  file(READ "${ROOT}/${FILE}" RML)
  string(APPEND ALL_RML "${RML}")
  string(REGEX MATCHALL "id=\"[^\"]+\"" IDS "${RML}")
  set(SEEN)
  foreach(ID IN LISTS IDS)
    list(FIND SEEN "${ID}" INDEX)
    if(NOT INDEX EQUAL -1)
      message(FATAL_ERROR "Duplicate RML ID in ${FILE}: ${ID}")
    endif()
    list(APPEND SEEN "${ID}")
  endforeach()
  foreach(NEEDLE "/templates/management_window.rml" "<template src=\"management-window\">" "management6a.rcss" "l-m6a-root is-hidden" "_loading" "_empty" "_error" "_close" "_locate")
    string(FIND "${RML}" "${NEEDLE}" POS)
    if(POS EQUAL -1)
      message(FATAL_ERROR "Missing management 6A RML contract ${NEEDLE} in ${FILE}")
    endif()
  endforeach()
endforeach()
file(READ "${ROOT}/content/rmlui/windows/workshop_manager.rml" WORKSHOP_RML)
file(READ "${ROOT}/content/rmlui/panels/agriculture_manager.rml" AGRICULTURE_RML)
# Agriculture is a Windows property sheet (Stage 11); priority is omitted because FarmingManager does not implement it.
foreach(NEEDLE "w98-sheet" "w98-buttonbar" "agriculture_ok" "agriculture_cancel" "agriculture_apply" "c-connected-tabs" "agriculture_view_general" "agriculture_view_plots" "agriculture_view_queue" "agriculture_view_crops" "agriculture_view_animals" "agriculture_view_food" "agriculture_plot_grid" "aria-multiselectable=\"true\"" "agriculture_plot_crop" "agriculture_plot_assign" "agriculture_plot_default" "agriculture_plot_queue" "agriculture_plot_repeat" "agriculture_plot_orders" "agriculture_order_up" "agriculture_order_remove" "agriculture_farm_catalog" "agriculture_animals" "agriculture_male_cap" "agriculture_female_cap" "agriculture_foods" "agriculture_name" "agriculture_toggle_suspended" "agriculture_toggle_harvest" "agriculture_toggle_pick" "agriculture_toggle_pasture_harvest" "agriculture_locate" ">Center on Map</button>")
  string(FIND "${AGRICULTURE_RML}" "${NEEDLE}" POS)
  if(POS EQUAL -1)
    message(FATAL_ERROR "Agriculture property-sheet contract missing: ${NEEDLE}")
  endif()
endforeach()
foreach(NEEDLE "agriculture_priority" "agriculture_next_animal" "agriculture_toggle_first_food" "agriculture_male_cap_up")
  string(FIND "${AGRICULTURE_RML}" "${NEEDLE}" POS)
  if(NOT POS EQUAL -1)
    message(FATAL_ERROR "Agriculture must not offer cycling or unimplemented controls: ${NEEDLE}")
  endif()
endforeach()
# The workshop is a Windows property sheet: its list boxes scroll instead of paging.
foreach(NEEDLE "_refresh" "_search")
  string(FIND "${WORKSHOP_RML}" "${NEEDLE}" POS)
  if(POS EQUAL -1)
    message(FATAL_ERROR "Missing workshop list contract ${NEEDLE}")
  endif()
endforeach()
foreach(NEEDLE "w98-sheet" "w98-buttonbar" "workshop_ok" "workshop_cancel" "workshop_apply" "workshop_trade_execute" "workshop_trade_merchant" "workshop_trade_settlement")
  string(FIND "${WORKSHOP_RML}" "${NEEDLE}" POS)
  if(POS EQUAL -1)
    message(FATAL_ERROR "Missing workshop property-sheet contract: ${NEEDLE}")
  endif()
endforeach()
foreach(NEEDLE "workshop_product_selection" "workshop_order_mode" "workshop_queue_once" "workshop_job_selection" "workshop_job_mode")
  string(FIND "${WORKSHOP_RML}" "${NEEDLE}" POS)
  if(POS EQUAL -1)
    message(FATAL_ERROR "Missing placed-workshop order editor contract: ${NEEDLE}")
  endif()
endforeach()
file(READ "${ROOT}/content/rmlui/windows/stockpile_manager.rml" STOCKPILE_RML)
# Stage 21a: the Stockpile is a Windows 98 property sheet like the workshop (OK / Cancel / Apply, fixed pages).
foreach(NEEDLE "class=\"c-window l-m6a-panel w98-sheet\"" "w98-caption" "c-connected-tabs w98-tabs" "role=\"tablist\"" "role=\"tab\"" "role=\"tabpanel\""
    ">Contents</button>" ">Allow List</button>" ">General</button>" "stockpile_ok" "stockpile_cancel" "stockpile_apply" "w98-button--default"
    "stockpile_content_search" "stockpile_content_category" "stockpile_allow_search" "stockpile_allow_category" "(All)" "w98-listview" "w98-listview__heading"
    "stockpile_rows" "stockpile_filters" "aria-multiselectable=\"true\"" "stockpile_rule_scope" ">Allow All<" ">Block All<"
    "w98-combo" "role=\"combobox\"" "stockpile_template_name" "stockpile_template_toggle" "stockpile_template_options" ">Load<" ">Save<" "stockpile_template_note"
    "stockpile_name" "stockpile_priority" "stockpile_priority_up" "stockpile_priority_down" "(1 is the highest priority)" "stockpile_toggle_pull" "stockpile_toggle_allow_pull"
    "stockpile_toggle_suspended" "Suspend deliveries" ">Center on Map</button>" "stockpile_summary")
  string(FIND "${STOCKPILE_RML}" "${NEEDLE}" POS)
  if(POS EQUAL -1)
    message(FATAL_ERROR "Stockpile property sheet contract missing: ${NEEDLE}")
  endif()
endforeach()
# Retired Stage 09 surfaces: header filter combos, section headings and help, the bulk review and the staged-name pair.
foreach(FORBIDDEN "c-excel-filter-combo" "c-excel-header" "c-m6a-section-heading" "c-m6a-help" "stockpile_apply_basics" "stockpile_revert_basics" "stockpile_template_update"
    "stockpile_template_confirmation" "stockpile_restore_filter_search" "stockpile_tooltip" "stockpile_object_state" "l-stockpile-rail-button" "stockpile_refresh" "stockpile_page_previous" "view_split")
  string(FIND "${STOCKPILE_RML}" "${FORBIDDEN}" POS)
  if(NOT POS EQUAL -1)
    message(FATAL_ERROR "Retired Stockpile surface remains: ${FORBIDDEN}")
  endif()
endforeach()
string(FIND "${STOCKPILE_RML}" "id=\"stockpile_view_contents\"" CONTENTS_VIEW_POS)
string(FIND "${STOCKPILE_RML}" "id=\"stockpile_view_allow\"" ALLOW_VIEW_POS)
string(FIND "${STOCKPILE_RML}" "id=\"stockpile_view_settings\"" SETTINGS_VIEW_POS)
if(CONTENTS_VIEW_POS EQUAL -1 OR ALLOW_VIEW_POS EQUAL -1 OR SETTINGS_VIEW_POS EQUAL -1 OR NOT CONTENTS_VIEW_POS LESS ALLOW_VIEW_POS OR NOT ALLOW_VIEW_POS LESS SETTINGS_VIEW_POS)
  message(FATAL_ERROR "Stockpile tabs must be ordered Contents, Allow List, General")
endif()
file(READ "${ROOT}/content/rmlui/screens/management6a.rcss" RCSS)
file(READ "${ROOT}/content/rmlui/styles/components.rcss" SHARED_REPORT_RCSS)
string(APPEND RCSS "${SHARED_REPORT_RCSS}")
# Every Windows 98 sheet, the farm included, uses the template's 16 px scroll bar.
file(READ "${ROOT}/tools/win98-style/win98_classic.template.rcss" WIN98_TEMPLATE)
string(FIND "${WIN98_TEMPLATE}" ".w98-sheet scrollbarvertical { width: @16@" FARM_SCROLLBAR_WIDTH)
if(FARM_SCROLLBAR_WIDTH EQUAL -1)
  message(FATAL_ERROR "Farm scrollbars must leave crop rows available to pointer input")
endif()
foreach(NEEDLE "pointer-events: none" "pointer-events: auto" "overflow-y: auto" "overflow-x: auto" "display: flex" "flex-direction: column" "height: 100%" "min-height: 0" ".c-m6a-filter-icon" ".c-m6a-filter-icon-image" ".is-selected" ".is-error" ".c-m6a-blocker" ".c-m6a-section-heading" "min-width: 100%" "height: 34dp" "text-overflow: clip" "white-space: nowrap")
  string(FIND "${RCSS}" "${NEEDLE}" POS)
  if(POS EQUAL -1)
    message(FATAL_ERROR "Missing management 6A input/responsive/state style: ${NEEDLE}")
  endif()
endforeach()
foreach(FORBIDDEN "estimated time" "items per hour" "hauling backlog" "editable limit")
  string(TOLOWER "${ALL_RML}" LOWER_RML)
  string(FIND "${LOWER_RML}" "${FORBIDDEN}" POS)
  if(NOT POS EQUAL -1)
    message(FATAL_ERROR "Fabricated unsupported management datum: ${FORBIDDEN}")
  endif()
endforeach()
file(READ "${ROOT}/content/rmlui/screens/management6a.rcss" ROUTE_RCSS)
# RmlUi now supports media queries; Stage 09 checks actual minimum-size layout at four densities.
foreach(NEEDLE "workshop_product_selection" "workshop_order_mode" "workshop_queue_once" "workshop_job_selection" "workshop_job_mode")
  string(FIND "${WORKSHOP_RML}" "${NEEDLE}" POS)
  if(POS EQUAL -1)
    message(FATAL_ERROR "Missing placed-workshop order editor contract: ${NEEDLE}")
  endif()
endforeach()
message(STATUS "Management 6A RML IDs, state surfaces, keyboard buttons, and map ownership passed")

foreach(REMOVED stockpile_filter_pager stockpile_filter_previous stockpile_filter_next)
  if(STOCKPILE_RML MATCHES "id=\"${REMOVED}\"")
    message(FATAL_ERROR "Allow list must scroll without pagination: ${REMOVED}")
  endif()
endforeach()
