foreach(NEEDLE ".c-stockpile-template-confirmation { z-index: 200; }" ".c-m6a-blocker { position: absolute" "pointer-events: auto")
  string(FIND "${RCSS}" "${NEEDLE}" POS)
  if(POS EQUAL -1)
    message(FATAL_ERROR "Stockpile overwrite confirmation must stack above and intercept the template toolbar: ${NEEDLE}")
  endif()
endforeach()
foreach(NEEDLE "pointer-events: none" "pointer-events: auto" "overflow-y: auto" "overflow-x: auto" "display: flex" "flex-direction: column" "height: 100%" "min-height: 0" ".c-m6a-filter-icon" ".c-m6a-filter-icon-image" ".is-selected" ".is-error" ".c-m6a-blocker" ".c-m6a-filter-depth-0" ".c-m6a-filter-depth-3" ".c-m6a-section-heading" ".c-m6a-content-material" "min-width: 100%" "height: 34dp" "text-overflow: clip" "white-space: nowrap" "word-break: normal")
  string(FIND "${RCSS}" "${NEEDLE}" POS)
  if(POS EQUAL -1)
    message(FATAL_ERROR "Missing management 6A input/responsive/state style: ${NEEDLE}")
  endif()
endforeach()
foreach(FORBIDDEN "estimated time" "items per hour" "hauling backlog" "editable limit")
  string(TOLOWER "${ALL_RML}" LOWER_RML)
  string(FIND "${LOWER_RML}" "${FORBIDDEN}" POS)
  if(NOT POS EQUAL -1)
    message(FATAL_ERROR "Fabricated unsupported management datum: ${FORBIDDEN}")
  endif()
endforeach()
string(FIND "${RCSS}" "@media" UNSUPPORTED_MEDIA)
if(NOT UNSUPPORTED_MEDIA EQUAL -1)
  message(FATAL_ERROR "Unsupported RmlUi @media rule remains in management 6A styles")
endif()
foreach(NEEDLE "workshop_product_selection" "c-workshop-editor" "workshop_queue_once" "workshop_add_order" "workshop_job_selection")
  string(FIND "${WORKSHOP_RML}" "${NEEDLE}" POS)
  if(POS EQUAL -1)
    message(FATAL_ERROR "Missing placed-workshop order editor contract: ${NEEDLE}")
  endif()
endforeach()
foreach(NEEDLE ".c-workshop-editor" ".c-workshop-mode-button" ".c-workshop-material-button" ".is-shortage")
  string(FIND "${RCSS}" "${NEEDLE}" POS)
  if(POS EQUAL -1)
    message(FATAL_ERROR "Missing placed-workshop Windows 98 editor style: ${NEEDLE}")
  endif()
endforeach()
message(STATUS "Management 6A RML IDs, state surfaces, keyboard buttons, and map ownership passed")

foreach(REMOVED stockpile_filter_pager stockpile_filter_previous stockpile_filter_next)
  if(STOCKPILE_RML MATCHES "id=\"${REMOVED}\"")
    message(FATAL_ERROR "Allow list must scroll without pagination: ${REMOVED}")
  endif()
endforeach()
