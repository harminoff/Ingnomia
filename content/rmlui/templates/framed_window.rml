<template name="framed-window" content="window-content">
<head>
    <link type="text/rcss" href="../styles/base.rcss" />
    <link type="text/rcss" href="../styles/components.rcss" />
</head>
<body class="c-window">
    <div class="c-title-bar">
        <div class="c-title-bar__mark" aria-hidden="true"></div>
        <div class="c-title-bar__title" title="A deliberately long workbench title used to verify truncation and full-title recovery on hover">A deliberately long workbench title used to verify truncation and full-title recovery on hover</div>
        <button class="c-button c-window__close" title="Close sample window"><span class="c-window__close-content"><span class="c-chrome-glyph c-chrome-glyph--close" aria-hidden="true"></span><span>Close</span></span></button>
    </div>
    <div id="window-content" class="c-window__body"></div>
</body>
</template>
