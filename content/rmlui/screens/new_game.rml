<rml>
<head>
    <title>Custom Game</title>
    <link type="text/rcss" href="/styles/base.rcss" />
    <link type="text/rcss" href="/styles/components.rcss" />
    <link type="text/rcss" href="/screens/win98_classic.rcss" />
    <link type="text/rcss" href="/screens/shell.rcss" />
    <link type="text/rcss" href="/styles/accessibility.rcss" />
</head>
<body class="l-shell-screen l-shell-desktop">
  <!-- Custom Game wizard (Stage 18): Welcome, three interior pages, Completion (PDF p.304-309). Every page starts
       from the recommended settings. < Back and Next > are adjacent; Finish takes the place of Next on the last page;
       Cancel returns to the main menu. -->
  <section id="new-wizard" class="w98-sheet w98-wizard l-new-game-wizard" role="dialog" aria-labelledby="new-caption">
    <div class="w98-caption"><h1 id="new-caption" class="c-title-bar__title" data-l10n="win98.new_game.caption">Custom Game</h1></div>
    <section id="new-loading" class="w98-wizard__body u-hidden"><p class="w98-text" data-l10n="win98.new_game.loading_setup_choices">Loading setup choices...</p></section>
    <section id="new-form" class="w98-col w98-grow">
        <section id="new-panel-welcome" class="w98-row w98-row--fill w98-grow l-wizard-exterior" role="group" aria-labelledby="new-title-welcome">
          <div class="l-wizard-watermark"></div>
          <div class="w98-col w98-grow l-wizard-exterior__body">
            <p id="new-title-welcome" class="l-wizard-exterior__title" data-l10n="win98.new_game.title_welcome">Welcome to the Custom Game Wizard</p>
            <p class="w98-text" data-l10n="win98.new_game.this_wizard_shapes_a_new">This wizard shapes a new world and your starting settlement.</p>
            <div class="w98-gap"></div>
            <p class="w98-text" data-l10n="win98.new_game.every_page_starts_with_the">Every page starts with the recommended settings, so you can change only what you want.</p>
            <div class="w98-gap"></div>
            <p class="w98-text" data-l10n="win98.new_game.to_continue_click_next">To continue, click Next.</p>
          </div>
        </section>
        <section id="new-panel-world" class="w98-col w98-grow l-wizard-page u-hidden" role="group" aria-labelledby="new-title-world">
          <div class="w98-wizard__header"><p id="new-title-world" class="w98-wizard__title" data-l10n="win98.new_game.title_world">World</p><p class="w98-text" data-l10n="win98.new_game.how_large_and_how_deep">How large and how deep should the world be?</p></div>
          <div class="w98-wizard__body">
            <div class="w98-line"><label class="w98-label w98-label--wide" for="new-world-size" data-l10n="win98.new_game.world_size">World size:</label><input id="new-world-size" class="w98-slider" type="range" min="1" max="300" step="1" /><div class="c-numeric-editor w98-spin"><input id="new-world-size-exact" class="w98-field c-numeric-editor__input" type="text" inputmode="numeric" min="1" max="300" aria-label="World size" aria-describedby="new-world-size-exact-error" /><div class="c-numeric-editor__arrows"><button id="new-world-size-exact-up" class="c-numeric-editor__up" aria-label="Increase World size" /><button id="new-world-size-exact-down" class="c-numeric-editor__down" aria-label="Decrease World size" /></div></div><span class="w98-text l-new-game-unit" data-l10n="win98.new_game.tiles">tiles</span></div>
            <p id="new-world-size-exact-error" class="w98-text l-shell-error u-hidden" role="status"></p>
            <div class="w98-line"><label class="w98-label w98-label--wide" for="new-z-levels" data-l10n="win98.new_game.z_levels">Levels:</label><input id="new-z-levels" class="w98-slider" type="range" min="71" max="200" step="1" /><div class="c-numeric-editor w98-spin"><input id="new-z-levels-exact" class="w98-field c-numeric-editor__input" type="text" inputmode="numeric" min="71" max="200" aria-label="Levels" aria-describedby="new-z-levels-exact-error" /><div class="c-numeric-editor__arrows"><button id="new-z-levels-exact-up" class="c-numeric-editor__up" aria-label="Increase Levels" /><button id="new-z-levels-exact-down" class="c-numeric-editor__down" aria-label="Decrease Levels" /></div></div><span class="w98-text l-new-game-unit" data-l10n="win98.new_game.levels">levels</span></div>
            <p id="new-z-levels-exact-error" class="w98-text l-shell-error u-hidden" role="status"></p>
            <div class="w98-line"><label class="w98-label w98-label--wide" for="new-ground" data-l10n="win98.new_game.ground">Ground level:</label><input id="new-ground" class="w98-slider" type="range" min="7" max="192" step="1" /><div class="c-numeric-editor w98-spin"><input id="new-ground-exact" class="w98-field c-numeric-editor__input" type="text" inputmode="numeric" min="7" max="192" aria-label="Ground level" aria-describedby="new-ground-exact-error" /><div class="c-numeric-editor__arrows"><button id="new-ground-exact-up" class="c-numeric-editor__up" aria-label="Increase Ground level" /><button id="new-ground-exact-down" class="c-numeric-editor__down" aria-label="Decrease Ground level" /></div></div><span class="w98-text l-new-game-unit" data-l10n="win98.new_game.levels">levels</span></div>
            <p id="new-ground-exact-error" class="w98-text l-shell-error u-hidden" role="status"></p>
            <div class="w98-line"><label class="w98-label w98-label--wide" for="new-flatness" data-l10n="win98.new_game.flatness">Flatness:</label><input id="new-flatness" class="w98-slider" type="range" min="0" max="20" step="1" /><div class="c-numeric-editor w98-spin"><input id="new-flatness-exact" class="w98-field c-numeric-editor__input" type="text" inputmode="numeric" min="0" max="20" aria-label="Flatness" aria-describedby="new-flatness-exact-error" /><div class="c-numeric-editor__arrows"><button id="new-flatness-exact-up" class="c-numeric-editor__up" aria-label="Increase Flatness" /><button id="new-flatness-exact-down" class="c-numeric-editor__down" aria-label="Decrease Flatness" /></div></div><span class="w98-text l-new-game-unit" data-l10n="win98.new_game.of_20">of 20</span></div>
            <p id="new-flatness-exact-error" class="w98-text l-shell-error u-hidden" role="status"></p>
          </div>
        </section>
        <section id="new-panel-settlement" class="w98-col w98-grow l-wizard-page u-hidden" role="group" aria-labelledby="new-title-settlement">
          <div class="w98-wizard__header"><p id="new-title-settlement" class="w98-wizard__title" data-l10n="win98.new_game.title_settlement">Settlement</p><p class="w98-text" data-l10n="win98.new_game.what_is_your_kingdom_called">What is your kingdom called, and how does it begin?</p></div>
          <div class="w98-wizard__body">
            <div class="w98-line"><label class="w98-label w98-label--wide" for="new-kingdom-name" data-l10n="win98.new_game.kingdom_name">Kingdom name:</label><input id="new-kingdom-name" class="w98-field w98-field--wide" type="text" /><button id="new-random-name" class="w98-button" data-l10n="win98.new_game.random_name">Random Name</button></div>
            <div class="w98-line"><label class="w98-label w98-label--wide" for="new-seed" data-l10n="win98.new_game.seed">Seed:</label><input id="new-seed" class="w98-field w98-field--wide" type="text" /><button id="new-random-seed" class="w98-button" data-l10n="win98.new_game.random_seed">Random Seed</button></div>
            <div class="w98-line"><label class="w98-label w98-label--wide" for="new-gnomes" data-l10n="win98.new_game.gnomes">Gnomes:</label><input id="new-gnomes" class="w98-slider" type="range" min="1" max="100" step="1" /><div class="c-numeric-editor w98-spin"><input id="new-gnomes-exact" class="w98-field c-numeric-editor__input" type="text" inputmode="numeric" min="1" max="100" aria-label="Gnomes" aria-describedby="new-gnomes-exact-error" /><div class="c-numeric-editor__arrows"><button id="new-gnomes-exact-up" class="c-numeric-editor__up" aria-label="Increase Gnomes" /><button id="new-gnomes-exact-down" class="c-numeric-editor__down" aria-label="Decrease Gnomes" /></div></div><span class="w98-text l-new-game-unit" data-l10n="win98.new_game.settlers">settlers</span></div>
            <p id="new-gnomes-exact-error" class="w98-text l-shell-error u-hidden" role="status"></p>
            <div class="w98-line"><label class="w98-label w98-label--wide" for="new-start-zone" data-l10n="win98.new_game.start_zone">Starting zone:</label><input id="new-start-zone" class="w98-slider" type="range" min="0" max="20" step="1" /><div class="c-numeric-editor w98-spin"><input id="new-start-zone-exact" class="w98-field c-numeric-editor__input" type="text" inputmode="numeric" min="0" max="20" aria-label="Starting zone" aria-describedby="new-start-zone-exact-error" /><div class="c-numeric-editor__arrows"><button id="new-start-zone-exact-up" class="c-numeric-editor__up" aria-label="Increase Starting zone" /><button id="new-start-zone-exact-down" class="c-numeric-editor__down" aria-label="Decrease Starting zone" /></div></div><span class="w98-text l-new-game-unit" data-l10n="win98.new_game.from_center">from center</span></div>
            <p id="new-start-zone-exact-error" class="w98-text l-shell-error u-hidden" role="status"></p>
            <label class="w98-check"><input id="new-peaceful" class="checkbox" type="checkbox" /><span data-l10n="win98.new_game.peaceful_beginning_no_raids_or">Peaceful beginning (no raids or invasions)</span></label>
          </div>
        </section>
        <section id="new-panel-terrain" class="w98-col w98-grow l-wizard-page u-hidden" role="group" aria-labelledby="new-title-terrain">
          <div class="w98-wizard__header"><p id="new-title-terrain" class="w98-wizard__title" data-l10n="win98.new_game.title_terrain">Terrain and Life</p><p class="w98-text" data-l10n="win98.new_game.how_much_water_plant_life">How much water, plant life and wildlife should the world have?</p></div>
          <div class="w98-wizard__body">
            <div class="w98-line"><label class="w98-label w98-label--wide" for="new-ocean-size" data-l10n="win98.new_game.ocean_size">Ocean size:</label><input id="new-ocean-size" class="w98-slider" type="range" min="0" max="15" step="1" /><div class="c-numeric-editor w98-spin"><input id="new-ocean-size-exact" class="w98-field c-numeric-editor__input" type="text" inputmode="numeric" min="0" max="15" aria-label="Ocean size" aria-describedby="new-ocean-size-exact-error" /><div class="c-numeric-editor__arrows"><button id="new-ocean-size-exact-up" class="c-numeric-editor__up" aria-label="Increase Ocean size" /><button id="new-ocean-size-exact-down" class="c-numeric-editor__down" aria-label="Decrease Ocean size" /></div></div><span class="w98-text l-new-game-unit" data-l10n="win98.new_game.of_15">of 15</span></div>
            <p id="new-ocean-size-exact-error" class="w98-text l-shell-error u-hidden" role="status"></p>
            <div class="w98-line"><label class="w98-label w98-label--wide" for="new-rivers" data-l10n="win98.new_game.rivers">Rivers:</label><input id="new-rivers" class="w98-slider" type="range" min="0" max="10" step="1" /><div class="c-numeric-editor w98-spin"><input id="new-rivers-exact" class="w98-field c-numeric-editor__input" type="text" inputmode="numeric" min="0" max="10" aria-label="Rivers" aria-describedby="new-rivers-exact-error" /><div class="c-numeric-editor__arrows"><button id="new-rivers-exact-up" class="c-numeric-editor__up" aria-label="Increase Rivers" /><button id="new-rivers-exact-down" class="c-numeric-editor__down" aria-label="Decrease Rivers" /></div></div><span class="w98-text l-new-game-unit" data-l10n="win98.new_game.rivers_2">rivers</span></div>
            <p id="new-rivers-exact-error" class="w98-text l-shell-error u-hidden" role="status"></p>
            <div class="w98-line"><label class="w98-label w98-label--wide" for="new-river-size" data-l10n="win98.new_game.river_size">River size:</label><input id="new-river-size" class="w98-slider" type="range" min="0" max="20" step="1" /><div class="c-numeric-editor w98-spin"><input id="new-river-size-exact" class="w98-field c-numeric-editor__input" type="text" inputmode="numeric" min="0" max="20" aria-label="River size" aria-describedby="new-river-size-exact-error" /><div class="c-numeric-editor__arrows"><button id="new-river-size-exact-up" class="c-numeric-editor__up" aria-label="Increase River size" /><button id="new-river-size-exact-down" class="c-numeric-editor__down" aria-label="Decrease River size" /></div></div><span class="w98-text l-new-game-unit" data-l10n="win98.new_game.tiles_wide">tiles wide</span></div>
            <p id="new-river-size-exact-error" class="w98-text l-shell-error u-hidden" role="status"></p>
            <div class="w98-line"><label class="w98-label w98-label--wide" for="new-tree-density" data-l10n="win98.new_game.tree_density">Trees:</label><input id="new-tree-density" class="w98-slider" type="range" min="0" max="100" step="1" /><div class="c-numeric-editor w98-spin"><input id="new-tree-density-exact" class="w98-field c-numeric-editor__input" type="text" inputmode="numeric" min="0" max="100" aria-label="Trees" aria-describedby="new-tree-density-exact-error" /><div class="c-numeric-editor__arrows"><button id="new-tree-density-exact-up" class="c-numeric-editor__up" aria-label="Increase Trees" /><button id="new-tree-density-exact-down" class="c-numeric-editor__down" aria-label="Decrease Trees" /></div></div><span class="w98-text l-new-game-unit" data-l10n="win98.new_game.cover">% cover</span></div>
            <p id="new-tree-density-exact-error" class="w98-text l-shell-error u-hidden" role="status"></p>
            <div class="w98-line"><label class="w98-label w98-label--wide" for="new-plant-density" data-l10n="win98.new_game.plant_density">Plants:</label><input id="new-plant-density" class="w98-slider" type="range" min="0" max="100" step="1" /><div class="c-numeric-editor w98-spin"><input id="new-plant-density-exact" class="w98-field c-numeric-editor__input" type="text" inputmode="numeric" min="0" max="100" aria-label="Plants" aria-describedby="new-plant-density-exact-error" /><div class="c-numeric-editor__arrows"><button id="new-plant-density-exact-up" class="c-numeric-editor__up" aria-label="Increase Plants" /><button id="new-plant-density-exact-down" class="c-numeric-editor__down" aria-label="Decrease Plants" /></div></div><span class="w98-text l-new-game-unit" data-l10n="win98.new_game.cover">% cover</span></div>
            <p id="new-plant-density-exact-error" class="w98-text l-shell-error u-hidden" role="status"></p>
            <div class="w98-line"><label class="w98-label w98-label--wide" for="new-wild-animals" data-l10n="win98.new_game.wild_animals">Wild animals:</label><input id="new-wild-animals" class="w98-slider" type="range" min="0" max="500" step="1" /><div class="c-numeric-editor w98-spin"><input id="new-wild-animals-exact" class="w98-field c-numeric-editor__input" type="text" inputmode="numeric" min="0" max="500" aria-label="Wild animals" aria-describedby="new-wild-animals-exact-error" /><div class="c-numeric-editor__arrows"><button id="new-wild-animals-exact-up" class="c-numeric-editor__up" aria-label="Increase Wild animals" /><button id="new-wild-animals-exact-down" class="c-numeric-editor__down" aria-label="Decrease Wild animals" /></div></div><span class="w98-text l-new-game-unit" data-l10n="win98.new_game.animals">animals</span></div>
            <p id="new-wild-animals-exact-error" class="w98-text l-shell-error u-hidden" role="status"></p>
          </div>
        </section>
        <section id="new-panel-review" class="w98-row w98-row--fill w98-grow l-wizard-exterior u-hidden" role="group" aria-labelledby="new-title-review">
          <div class="l-wizard-watermark"></div>
          <div class="w98-col w98-grow l-wizard-exterior__body">
            <p id="new-title-review" class="l-wizard-exterior__title" data-l10n="win98.new_game.title_review">Completing the Custom Game Wizard</p>
            <p class="w98-text" data-l10n="win98.new_game.you_chose_these_settings">You chose these settings:</p>
            <div class="w98-gap"></div>
            <div class="w98-line"><span class="w98-label" data-l10n="win98.new_game.kingdom">Kingdom:</span><p id="new-summary-kingdom" class="w98-text w98-grow"></p></div>
            <div class="w98-line"><span class="w98-label" data-l10n="win98.new_game.seed_2">Seed:</span><p id="new-summary-seed" class="w98-text w98-grow"></p></div>
            <div class="w98-line"><span class="w98-label" data-l10n="win98.new_game.settlement">Settlement:</span><p id="new-summary-settlement" class="w98-text w98-grow"></p></div>
            <div class="w98-line"><span class="w98-label" data-l10n="win98.new_game.world">World:</span><p id="new-summary-world" class="w98-text w98-grow"></p></div>
            <div class="w98-line"><span class="w98-label" data-l10n="win98.new_game.life">Life:</span><p id="new-summary-life" class="w98-text w98-grow"></p></div>
            <div class="w98-gap"></div>
            <p class="w98-text" data-l10n="win98.new_game.to_create_the_kingdom_click">To create the kingdom, click Finish.</p>
          </div>
        </section>
    </section>
    <p id="new-validation" class="w98-text l-shell-error u-hidden">Some settings are out of range. <span id="new-validation-detail"></span></p>
    <div class="w98-wizard__buttons"><button id="new-back" class="w98-button" data-l10n="win98.new_game.back">&lt; Back</button><button id="new-next" class="w98-button" data-default-action="true" data-l10n="win98.new_game.next">Next &gt;</button><button id="new-start" class="w98-button" data-default-action="true" data-l10n="win98.new_game.start">Finish</button><button id="shell-back" class="w98-button w98-wizard__gap" data-l10n="win98.common.cancel">Cancel</button></div>
  </section>
</body>
</rml>
