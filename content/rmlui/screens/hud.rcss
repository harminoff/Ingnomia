.l-hud-root.is-inspecting .l-hud-tools { transform: translate(0, 0); }
.l-hud-root { position: absolute; left: 0; top: 0; width: 100%; height: 100%; pointer-events: none; color: #e7e2d7; }
.l-hud-top { position: absolute; left: 12dp; right: 12dp; top: 10dp; min-height: 46dp; padding: 8dp 12dp; display: flex; gap: 18dp; align-items: center; pointer-events: auto; background-color: #20262b; border: 1dp #626b70; }
.l-hud-settlement, .l-hud-controls, .l-hud-overlays { display: flex; gap: 7dp; align-items: center; }
.l-hud-watch { margin-left: auto; }
.l-hud-tools { position: absolute; left: 12dp; top: 76dp; max-width: 210dp; padding: 8dp; pointer-events: auto; background-color: #20262b; border: 1dp #626b70; }
.l-hud-tools .c-button { display: block; width: 100%; margin-bottom: 4dp; }
.l-hud-build { height: 200dp; max-height: 200dp; overflow-y: scroll; }
.l-hud-hints { position: absolute; left: 12dp; right: 12dp; bottom: 10dp; min-height: 32dp; padding: 7dp 12dp; display: flex; gap: 18dp; pointer-events: auto; background-color: #20262b; border: 1dp #626b70; }
.l-hud-modal { position: absolute; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(8,10,12,0.72); display: flex; align-items: center; justify-content: center; pointer-events: auto; }
.l-hud-modal .c-modal { width: 520dp; max-height: 75%; padding: 22dp; background-color: #20262b; border: 2dp #b78947; }
.l-hud-modal { z-index: 40; }
.is-hidden { display: none; }

/* Compact RCT2-style in-game chrome: blue rails and silver tool shelf keep
   the map dominant while making management controls feel like a toolbar. */
.l-hud-root { color: #142333; background-color: transparent; }
.l-hud-top {
    left: 0;
    right: 0;
    top: 0;
    min-height: 52dp;
    padding: 4dp 8dp;
    gap: 6dp;
    background-color: #cbd5d9;
    border-width: 2dp;
    border-top-color: #f7faf8;
    border-left-color: #f7faf8;
    border-right-color: #4d6476;
    border-bottom-color: #4d6476;
}
.l-hud-z-controls, .l-hud-controls, .l-hud-summary { display: flex; gap: 3dp; align-items: center; }
.l-hud-z-controls { flex: 0 0 auto; }
.l-hud-center { flex: 1 1 auto; min-width: 150dp; display: flex; justify-content: center; align-items: center; gap: 6dp; }
.l-hud-world-name { flex: 1 1 auto; min-width: 64dp; max-width: 220dp; color: #173d59; text-align: right; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 13dp; }
.l-hud-controls { flex: 0 0 auto; }
.l-hud-summary { flex: 0 1 auto; min-width: 0; max-width: 44%; gap: 5dp; color: #173d59; white-space: nowrap; overflow: hidden; }
.l-hud-summary span { display: inline-block; }
.l-hud-settlement, .l-hud-overlays { gap: 3dp; }
.l-hud-watch { margin-left: auto; color: #173d59; font-size: 11dp; }
.c-hud-watch-row { display: inline-flex; align-items: center; gap: 4dp; min-width: 72dp; margin-left: 3dp; padding: 3dp 5dp; color: #173d59; background-color: #dbe5e7; border-width: 1dp; border-top-color: #f7faf8; border-left-color: #f7faf8; border-right-color: #4d6476; border-bottom-color: #4d6476; }
.c-hud-watch-row:hover { background-color: #e6c56a; }
.c-hud-watch-label { max-width: 120dp; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.l-hud-sidebar-center {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 170dp;
    display: flex;
    flex-direction: column;
    justify-content: center;
    pointer-events: none;
    z-index: 3;
}
.l-hud-tools {
    position: relative;
    left: auto;
    top: auto;
    bottom: auto;
    flex: 0 0 auto;
    margin: 0;
    transform: translate(-100%, 0);
    transition: transform 0.65s cubic-out;
    width: 170dp;
    max-width: 170dp;
    padding: 5dp;
    color: #000000;
    background-color: #c0c0c0;
    border-width: 2dp;
    border-top-color: #ffffff;
    border-left-color: #ffffff;
    border-right-color: #404040;
    border-bottom-color: #404040;
    max-height: 84%;
    overflow-y: auto;
    z-index: 3;
}
.l-hud-sidebar-edge {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 34dp;
    pointer-events: auto;
    z-index: 2;
}
.c-hud-sidebar-notch-mark {
    position: absolute;
    left: 0;
    top: 50%;
    width: 23dp;
    height: 38dp;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    color: #000000;
    background-color: #c0c0c0;
    border-width: 2dp;
    border-left-width: 0;
    border-top-color: #ffffff;
    border-right-color: #404040;
    border-bottom-color: #404040;
    font-size: 18dp;
    line-height: 22dp;
    font-weight: bold;
    decorator: text(">" #000000);
}
.l-hud-sidebar-edge:hover + .l-hud-sidebar-center .l-hud-tools,
.l-hud-tools:hover {
    transform: translate(0, 0);
}
.l-hud-tools .c-hud-shelf-heading { margin-top: 6dp; padding-top: 5dp; border-top: 1dp #808080; }
.l-hud-tools .c-button { margin-bottom: 2dp; min-height: 27dp; padding: 4dp 6dp; color: #000000; background-color: #c0c0c0; border-width: 2dp; border-top-color: #ffffff; border-left-color: #ffffff; border-right-color: #404040; border-bottom-color: #404040; border-radius: 0; text-align: left; }
.l-hud-tools .c-button:hover { background-color: #d4d0c8; }
.l-hud-tools .c-button:active, .l-hud-tools .c-button.is-selected { background-color: #d4d0c8; border-top-color: #404040; border-left-color: #404040; border-right-color: #ffffff; border-bottom-color: #ffffff; }
.l-hud-tools .c-button:focus-visible { border-color: #000080; }
.c-hud-shelf-heading { display: block; margin: 3dp 2dp 4dp; color: #000000; font-size: 10dp; font-weight: bold; text-transform: uppercase; letter-spacing: 0.6dp; }
.l-hud-build { height: 180dp; max-height: 180dp; }
/* The map owns the lower edge now; keep the legacy hint nodes bound but remove
   the full-width footer from the game view. */
.l-hud-build-categories {
    position: absolute;
    left: 184dp;
    top: 52dp;
    width: 450dp;
    padding: 5dp;
    pointer-events: auto;
    background-color: #cbd5d9;
    border-width: 2dp;
    border-top-color: #f7faf8;
    border-left-color: #f7faf8;
    border-right-color: #4d6476;
    border-bottom-color: #4d6476;
}
.l-hud-build-categories header { display: flex; align-items: baseline; gap: 8dp; color: #173d59; margin-bottom: 4dp; }
.c-hud-build-category-hint { color: #526a78; font-size: 11dp; }
.l-hud-build-tabs {
    display: block;
    height: 64dp;
    max-height: 64dp;
    padding: 4dp 3dp 0;
    overflow: hidden;
    white-space: nowrap;
    background-color: #aebdc4;
    border-bottom-width: 2dp;
    border-bottom-color: #718591;
}
.l-hud-build-tab-row { display: block; height: 30dp; white-space: nowrap; }
.l-hud-build-tabs .c-hud-build-tab {
    display: inline-block;
    width: 84dp;
    min-width: 84dp;
    max-width: 84dp;
    height: 29dp;
    min-height: 29dp;
    padding: 4dp 5dp;
    margin: 0 -1dp -2dp 0;
    color: #1b344b;
    background-color: #cbd5d9;
    border-width: 2dp;
    border-top-color: #f7faf8;
    border-left-color: #f7faf8;
    border-right-color: #718591;
    border-bottom-color: #718591;
    border-radius: 0;
    font-size: 11dp;
    vertical-align: top;
    text-align: center;
}
.l-hud-build-tabs .c-hud-build-tab:hover { color: #142333; background-color: #d6e0e4; }
.l-hud-build-tabs .c-hud-build-tab.is-selected { height: 32dp; min-height: 32dp; padding-top: 5dp; color: #142333; background-color: #e5e9e5; border-top-color: #ffffff; border-left-color: #ffffff; border-right-color: #718591; border-bottom-color: #e5e9e5; }
#hud_build_catalog {
    position: absolute;
    left: 184dp;
    top: 128dp;
    width: 450dp;
    height: 360dp;
    max-height: 360dp;
    padding: 3dp;
    background-color: #aebdc4;
    border-width: 2dp;
    border-top-color: #f7faf8;
    border-left-color: #f7faf8;
    border-right-color: #4d6476;
    border-bottom-color: #4d6476;
}
#hud_build_catalog .c-hud-build-catalog-header {
    display: flex;
    width: 440dp;
    align-items: baseline;
    gap: 8dp;
    justify-content: space-between;
    padding: 3dp 5dp 5dp;
    color: #173d59;
    border-bottom-width: 1dp;
    border-bottom-color: #718793;
}
#hud_build_catalog .c-hud-build-catalog-header strong { flex: 0 0 auto; }
#hud_build_catalog .c-hud-build-catalog-header span { flex: 1 1 auto; min-width: 0; overflow: hidden; color: #526a78; font-size: 11dp; white-space: nowrap; text-overflow: ellipsis; }
#hud_build_items {
    height: 320dp;
    width: 440dp;
    overflow-y: scroll;
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    gap: 4dp;
    padding: 5dp;
}
#hud_build_catalog .c-hud-build-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    width: 136dp;
    min-width: 136dp;
    height: 58dp;
    min-height: 58dp;
    margin: 0;
    padding: 4dp;
    text-align: left;
    vertical-align: top;
    background-color: #cbd5d9;
    border-width: 2dp;
    border-top-color: #f7faf8;
    border-left-color: #f7faf8;
    border-right-color: #4d6476;
    border-bottom-color: #4d6476;
}
#hud_build_catalog .c-hud-build-sprite {
    position: relative;
    display: block;
    flex: 0 0 auto;
    width: 44dp;
    height: 44dp;
    margin-right: 5dp;
    overflow: hidden;
    background-color: #9fb4bd;
    border-width: 1dp;
    border-color: #587484;
}
#hud_build_catalog .c-hud-build-sprite-image {
    position: absolute;
    display: block;
    max-width: none;
}
#hud_build_catalog .c-hud-build-row:hover {
    background-color: #d6e8f2;
}
#hud_build_catalog .c-hud-build-row.is-selected,
#hud_build_catalog .c-hud-build-row:active {
    background-color: #e6c56a;
    border-top-color: #fff1ad;
    border-left-color: #fff1ad;
    border-right-color: #80601f;
    border-bottom-color: #80601f;
}
#hud_build_catalog .c-hud-build-row.is-unavailable { color: #6a777b; background-color: #b5c0c3; opacity: 0.72; }
#hud_build_catalog .c-hud-build-row.is-unavailable .c-hud-build-name { color: #5d686b; }
#hud_build_catalog .c-hud-build-material.is-unavailable { color: #7b3024; font-weight: bold; }
#hud_build_catalog .c-hud-build-empty { margin: 8dp 6dp; color: #526a78; font-size: 11dp; }
#hud_build_catalog .c-hud-build-card {
    display: block;
    width: 200dp;
    min-width: 200dp;
    max-width: 200dp;
    height: 216dp;
    min-height: 216dp;
    max-height: 216dp;
    flex: 0 0 200dp;
    overflow: hidden;
    padding: 2dp;
    background-color: #cbd5d9;
    border-width: 1dp;
    border-top-color: #f7faf8;
    border-left-color: #f7faf8;
    border-right-color: #4d6476;
    border-bottom-color: #4d6476;
}
#hud_build_catalog .c-hud-build-card .c-hud-build-row { width: 100%; max-width: 100%; min-width: 0; margin: 0; }
#hud_build_catalog .c-hud-build-requirements { display: block; width: 100%; min-width: 0; padding: 3dp 2dp 1dp; }
#hud_build_catalog .c-hud-build-requirement { display: block; margin-bottom: 3dp; color: #30485c; font-size: 10dp; }
#hud_build_catalog .c-hud-build-requirement > span { display: block; overflow: hidden; }
#hud_build_catalog .c-hud-build-material-select { display: block; width: 100%; min-width: 0; max-width: 100%; height: 24dp; min-height: 24dp; margin-top: 2dp; padding: 1dp 3dp; color: #1c2d3b; background-color: #eef2ef; border-width: 2dp; border-top-color: #f7faf8; border-left-color: #f7faf8; border-right-color: #4d6476; border-bottom-color: #4d6476; box-sizing: border-box; }
#hud_build_catalog .c-hud-build-material-select:hover,
#hud_build_catalog .c-hud-build-material-select:focus-visible { background-color: #d6e8f2; border-top-color: #ffffff; border-left-color: #ffffff; }
#hud_build_catalog .c-hud-build-material-select selectvalue { display: block; width: auto; height: 20dp; margin-right: 20dp; padding: 1dp 3dp; color: #1c2d3b; background-color: transparent; overflow: hidden; line-height: 18dp; }
#hud_build_catalog .c-hud-build-material-select selectarrow { width: 20dp; height: 20dp; color: #1c2d3b; background-color: #aebdc4; border-left-width: 1dp; border-left-color: #4d6476; font-size: 12dp; font-weight: bold; line-height: 18dp; text-align: center; decorator: text("v"); }
#hud_build_catalog .c-hud-build-material-select:hover selectarrow,
#hud_build_catalog .c-hud-build-material-select:focus-visible selectarrow,
#hud_build_catalog .c-hud-build-material-select:active selectarrow { background-color: #e6c56a; color: #1c2d3b; }
#hud_build_catalog .c-hud-build-material-select selectbox { width: 100%; max-width: 100%; margin-top: 2dp; padding: 2dp; color: #1c2d3b; background-color: #dbe5e7; border-width: 2dp; border-top-color: #f7faf8; border-left-color: #f7faf8; border-right-color: #4d6476; border-bottom-color: #4d6476; box-sizing: border-box; }
#hud_build_catalog .c-hud-build-material-select selectbox option { min-height: 20dp; padding: 2dp 4dp; color: #1c2d3b; background-color: #eef2ef; }
#hud_build_catalog .c-hud-build-material-select selectbox option:hover { background-color: #d6e8f2; }
#hud_build_catalog .c-hud-build-material-select selectbox option:checked { color: #1c2d3b; background-color: #e6c56a; border-left-width: 2dp; border-left-color: #80601f; }
.c-hud-status { color: #7b3024; font-weight: bold; }

/* The build picker is one movable workbench. Keeping the category rail and
   catalog in the same flex column prevents the lower list from covering the
   tabs, while the catalog itself remains scrollable for large DBs. */
.l-hud-build-panel {
    position: absolute;
    left: 184dp;
    top: 52dp;
    bottom: auto;
    width: 450dp;
    height: 600dp;
    min-height: 600dp;
    max-height: 600dp;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    pointer-events: auto;
    overflow: hidden;
    background-color: #cbd5d9;
    border-width: 2dp;
    border-top-color: #f7faf8;
    border-left-color: #f7faf8;
    border-right-color: #4d6476;
    border-bottom-color: #4d6476;
}
.l-hud-build-panel .l-hud-build-categories {
    position: relative;
    left: auto;
    top: auto;
    width: auto;
    padding: 5dp;
    flex: 0 0 auto;
    background-color: transparent;
    border-width: 0;
}
.c-hud-build-drag-handle { display: flex; flex: 1; align-items: center; cursor: move; }
.c-hud-build-drag-handle > * { pointer-events: none; }
.l-hud-build-categories > .c-title-bar { display: flex; align-items: center; gap: 0; margin: -5dp -5dp 5dp; }
.c-hud-build-category-hint { display: block; margin: 2dp 2dp 5dp; color: #526a78; font-size: 11dp; }

.l-hud-build-panel #hud_build_catalog {
    position: relative;
    left: auto;
    top: auto;
    width: auto;
    height: auto;
    max-height: none;
    min-height: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 3dp;
    background-color: #aebdc4;
    border-width: 0;
    border-top-width: 2dp;
    border-top-color: #4d6476;
}
.l-hud-build-panel #hud_build_items { width: auto; height: auto; min-height: 0; flex: 1; overflow-y: scroll; }

/* RmlUi lays out dynamic inner-RML more reliably when the two workbench
   regions have explicit bounds instead of being nested flex children. */
.l-hud-build-panel { display: block; }
.l-hud-build-panel .l-hud-build-categories { position: absolute; left: 0; top: 0; right: 2dp; width: auto; }
.l-hud-build-panel #hud_build_catalog { position: absolute; left: 2dp; right: 2dp; top: 122dp; bottom: 4dp; width: auto; height: auto; display: block; overflow: hidden; box-sizing: border-box; }
.l-hud-build-panel #hud_build_catalog .c-hud-build-catalog-header { position: absolute; left: 0; right: 0; top: 0; width: auto; height: 28dp; }
.l-hud-build-panel #hud_build_items { position: absolute; left: 0; right: 0; top: 28dp; bottom: 4dp; display: flex; flex-direction: row; flex-wrap: wrap; align-content: flex-start; align-items: flex-start; justify-content: flex-start; gap: 4dp; width: auto; min-width: 0; max-width: none; min-height: 0; height: auto; max-height: none; padding: 5dp; overflow-y: auto; overflow-x: hidden; box-sizing: border-box; }
.l-hud-build-panel #hud_build_items .c-hud-build-card { flex: 1 1 200dp; width: auto; min-width: 180dp; max-width: 280dp; height: auto; min-height: 188dp; max-height: none; }
.l-hud-build-panel #hud_build_items scrollbarvertical { width: 16dp; margin-right: 0; background-color: #c0c0c0; border-left-width: 1dp; border-left-color: #718591; }
.l-hud-build-panel #hud_build_items scrollbarvertical slidertrack { background-color: #dfdfdf; border-left: 2dp #808080; border-right: 1dp #ffffff; }
.l-hud-build-panel #hud_build_items scrollbarvertical sliderbar { min-height: 48dp; margin-left: 2dp; width: 14dp; background-color: #c0c0c0; border-width: 2dp; border-top-color: #ffffff; border-left-color: #ffffff; border-right-color: #404040; border-bottom-color: #404040; }
/* Keep the dynamically generated catalog in the same input island as the
   category rail. RmlUi does not infer child hit-testing from the absolute
   workbench container consistently after SetInnerRML(). */
.l-hud-build-panel #hud_build_catalog,
.l-hud-build-panel #hud_build_items,
.l-hud-build-panel .c-hud-build-card,
.l-hud-build-panel .c-hud-build-row,
.l-hud-build-panel .c-hud-build-action,
.l-hud-build-panel .c-hud-build-material-select { pointer-events: auto; }
.c-hud-build-glyph {
    display: inline-block;
    width: 38dp;
    height: 38dp;
    margin-right: 5dp;
    padding-top: 5dp;
    color: #244a62;
    background-color: #9fb4bd;
    border-width: 1dp;
    border-color: #587484;
    font-size: 22dp;
    line-height: 28dp;
    text-align: center;
    vertical-align: middle;
}
.c-hud-build-copy { display: inline-block; width: 82dp; vertical-align: middle; }
.c-hud-build-name { display: block; color: #142333; font-size: 12dp; line-height: 16dp; overflow: hidden; }
.c-hud-build-material { display: block; color: #526a78; font-size: 10dp; line-height: 13dp; overflow: hidden; }
.c-hud-build-actions { display: flex; flex-direction: row; flex-wrap: wrap; gap: 4dp; margin-top: 4dp; }
.c-hud-build-action { font-size: 12dp; padding: 2dp 6dp; }
.c-hud-build-action:disabled { color: #697579; background-color: #aab6ba; border-color: #7b8b92; }
.l-hud-mine-menu { position: absolute; left: 646dp; top: 52dp; width: 232dp; padding: 7dp; pointer-events: auto; background-color: #cbd5d9; border-width: 2dp; border-top-color: #f7faf8; border-left-color: #f7faf8; border-right-color: #4d6476; border-bottom-color: #4d6476; }
.l-hud-mine-menu header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 5dp; color: #173d59; }
.l-hud-mine-menu > .c-title-bar { margin: -7dp -7dp 7dp; color: #ffffff; }
.l-hud-mine-menu > .c-title-bar,
.l-hud-action-menu > .c-title-bar,
.l-hud-kingdom-panel > .c-title-bar,
.l-hud-build-categories > .c-title-bar { width: auto; }
.l-hud-mine-menu .c-title-bar__drag-handle,
.l-hud-action-menu .c-title-bar__drag-handle,
.l-hud-kingdom-panel .c-title-bar__drag-handle,
.l-hud-build-categories .c-title-bar__drag-handle { flex: 1 1 auto; min-width: 0; }
.l-hud-mine-menu .c-title-bar > .c-button,
.l-hud-action-menu .c-title-bar > .c-button,
.l-hud-kingdom-panel .c-title-bar > .c-button,
.l-hud-build-categories .c-title-bar > .c-button { flex: 0 0 auto; }
.l-hud-mine-menu .c-title-bar__mark,
.l-hud-action-menu .c-title-bar__mark,
.l-hud-kingdom-panel .c-title-bar__mark,
.l-hud-build-categories .c-title-bar__mark {
    display: flex;
    flex: 0 0 20dp;
    width: 20dp;
    height: 20dp;
    margin-right: 6dp;
    align-items: center;
    justify-content: center;
    color: #f1ca4f;
    background-color: transparent;
    font-size: 15dp;
    font-weight: bold;
    line-height: 20dp;
    text-align: center;
}
.l-hud-mine-menu p { margin: 3dp 0 7dp; color: #30485c; font-size: 11dp; }
.l-hud-mine-menu .c-button { display: block; width: 100%; margin-bottom: 3dp; min-height: 27dp; padding: 4dp 6dp; text-align: left; }
.l-hud-mine-menu .c-button--compact { width: auto; min-height: 22dp; padding: 2dp 6dp; margin: 0; }
.l-hud-mine-menu .c-button.is-selected { background-color: #e6c56a; color: #1c2d3b; border-top-color: #fff1ad; border-left-color: #fff1ad; border-right-color: #80601f; border-bottom-color: #80601f; }
.l-hud-action-menu { position: absolute; left: 646dp; top: 52dp; width: 232dp; max-height: 560dp; padding: 7dp; pointer-events: auto; overflow-y: auto; background-color: #cbd5d9; border-width: 2dp; border-top-color: #f7faf8; border-left-color: #f7faf8; border-right-color: #4d6476; border-bottom-color: #4d6476; }
.l-hud-action-menu header { display: flex; align-items: center; justify-content: space-between; margin: -7dp -7dp 7dp; color: #ffffff; }
.l-hud-action-menu p { margin: 3dp 0 7dp; color: #30485c; font-size: 11dp; }
.l-hud-action-menu .c-button { display: block; width: 100%; margin-bottom: 3dp; min-height: 27dp; padding: 4dp 6dp; text-align: left; }
.l-hud-action-menu .c-button--compact { width: auto; min-height: 22dp; padding: 2dp 6dp; margin: 0; }
.l-hud-action-menu .c-button.is-selected { background-color: #e6c56a; color: #1c2d3b; border-top-color: #fff1ad; border-left-color: #fff1ad; border-right-color: #80601f; border-bottom-color: #80601f; }
.l-hud-action-menu .c-hud-action-note { margin: 2dp 0 6dp; color: #526a78; font-size: 10dp; line-height: 13dp; }
.l-hud-designations-menu { max-height: 610dp; }
.l-hud-kingdom-panel { position: absolute; left: 184dp; top: 52dp; width: 270dp; padding: 7dp; pointer-events: auto; background-color: #cbd5d9; border-width: 2dp; border-top-color: #f7faf8; border-left-color: #f7faf8; border-right-color: #4d6476; border-bottom-color: #4d6476; }
.l-hud-kingdom-panel .c-title-bar { display: flex; align-items: center; justify-content: space-between; margin: -7dp -7dp 7dp; color: #ffffff; }
.c-hud-kingdom-summary { display: flex; flex-wrap: wrap; gap: 4dp; color: #30485c; }
.c-hud-kingdom-summary strong { display: block; flex: 0 0 100%; padding-bottom: 4dp; color: #173d59; border-bottom-width: 1dp; border-bottom-color: #718793; }
.c-hud-kingdom-summary p { flex: 0 0 100%; margin: 0 0 4dp; color: #526a78; font-size: 11dp; line-height: 14dp; }
.c-hud-kingdom-summary span { display: block; flex: 1 1 45%; }
.l-hud-hints {
    display: flex;
    left: 6dp;
    right: 6dp;
    bottom: 6dp;
    min-height: 27dp;
    padding: 4dp 7dp;
    gap: 8dp;
    color: #173d59;
    background-color: #cbd5d9;
    border-width: 2dp;
    border-top-color: #f7faf8;
    border-left-color: #f7faf8;
    border-right-color: #4d6476;
    border-bottom-color: #4d6476;
}
.l-hud-hints { flex-wrap: wrap; align-items: center; }
.l-hud-hints > span { min-width: 0; }
.l-hud-hints #hud_active_tool { flex: 0 1 auto; max-width: 220dp; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: bold; }
.l-hud-hints #hud_status { flex: 1 1 180dp; min-width: 100dp; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.l-hud-hints .c-button { min-height: 26dp; padding: 3dp 7dp; }
.l-hud-modal { background-color: #243849a6; }
.l-hud-modal .c-modal {
    position: relative;
    left: auto;
    right: auto;
    top: auto;
    width: 500dp;
    min-width: 500dp;
    max-width: 500dp;
    min-height: 300dp;
    max-height: 300dp;
    padding: 12dp;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background-color: #cbd5d9;
    border-color: #4d6476;
}
.l-hud-modal .c-modal > div { display: flex; flex-direction: row; justify-content: flex-end; align-items: center; gap: 5dp; }
.l-hud-tutorial{position:absolute;right:12dp;bottom:54dp;width:420dp;max-width:90%;max-height:80%;overflow-y:auto;padding:0;pointer-events:auto;background-color:#cbd5d9;color:#173d59;border-width:2dp;border-top-color:#f7faf8;border-left-color:#f7faf8;border-right-color:#4d6476;border-bottom-color:#4d6476;box-shadow:4dp 4dp 0dp #173d5940;z-index:20;}
.l-hud-tutorial.is-hidden{display:none;}
.l-hud-tutorial.is-complete{border-color:#80601f;}
.l-hud-tutorial .c-title-bar{display:flex;justify-content:space-between;align-items:center;min-height:42dp;padding:7dp 10dp;background-color:#cbd5d9;border-bottom-width:2dp;border-bottom-color:#4d6476;}
.l-hud-tutorial .c-title-bar h2{color:#173d59;font-size:17dp;line-height:24dp;}
.l-hud-tutorial #tutorial_progress{color:#526a78;font-size:12dp;font-weight:bold;}
.l-hud-tutorial > p,.l-hud-tutorial > h3{margin-left:12dp;margin-right:12dp;}
.l-hud-tutorial > p{margin-top:8dp;margin-bottom:8dp;color:#304b5b;}
.l-hud-tutorial .c-hud-tutorial-objective{font-weight:bold;color:#173d59;background-color:#dbe5e7;border-left-width:3dp;border-left-color:#d19a55;padding:7dp 8dp;}
.l-hud-tutorial-steps-heading{margin-top:10dp;color:#526a78;font-size:11dp;text-transform:uppercase;letter-spacing:0.6dp;}
.c-hud-tutorial-steps{line-height:1.4em;color:#173d59;white-space:pre-wrap;}
.c-hud-tutorial-checklist{font-size:0.86em;line-height:1.35em;color:#526a78;white-space:pre-wrap;border-top-width:1dp;border-top-color:#9aaab0;padding-top:8dp;}
.c-hud-tutorial-warning{font-size:0.86em;color:#80601f;}
.l-hud-tutorial-actions{display:flex;flex-wrap:wrap;gap:5dp;margin:10dp 12dp 12dp;}
.l-hud-tutorial .c-button{min-width:72dp;min-height:30dp;padding:5dp 8dp;color:#173d59;background-color:#dbe5e7;border-width:1dp;border-top-color:#f7faf8;border-left-color:#f7faf8;border-right-color:#4d6476;border-bottom-color:#4d6476;}
.l-hud-tutorial .c-button:hover{background-color:#e6c56a;color:#1c2d3b;}
.l-hud-tutorial .c-button:active,.l-hud-tutorial .c-button:focus-visible{border-color:#80601f;}
.tutorial-target { border-color: #80601f; box-shadow: 0dp 0dp 0dp 2dp #e0a94a; }
#hud_tool_inspect.tutorial-target { border-color: #80601f; box-shadow: 0dp 0dp 0dp 2dp #e0a94a; }

/* Static action lists stay in the HUD sidebar. The root page is swapped for one
   focused list, while the action body scrolls independently from its Back row. */
.l-hud-sidebar {
    height: auto;
    max-height: 84%;
    overflow-y: auto;
    display: block;
}
.l-hud-sidebar .l-hud-sidebar-page {
    position: relative;
    left: auto;
    top: auto;
    width: auto;
    max-width: none;
    height: auto;
    max-height: none;
    min-height: 0;
    margin: 0;
    padding: 0;
    display: block;
    pointer-events: auto;
    overflow: visible;
    background-color: transparent;
    border-width: 0;
    box-sizing: border-box;
}
.l-hud-sidebar .l-hud-sidebar-page.is-hidden { display: none; }
.l-hud-sidebar .l-hud-sidebar-root { overflow-y: auto; }
.l-hud-sidebar .c-hud-sidebar-page-title {
    margin: 2dp 2dp 6dp;
    padding: 2dp 1dp 5dp;
    color: #000000;
    border-bottom-width: 1dp;
    border-bottom-color: #808080;
    font-size: 13dp;
    line-height: 17dp;
}
.l-hud-sidebar .l-hud-sidebar-actions {
    display: block;
    overflow: visible;
}
.l-hud-sidebar .l-hud-sidebar-actions p {
    margin: 2dp 2dp 6dp;
    color: #000000;
    font-size: 11dp;
    line-height: 14dp;
}
.l-hud-sidebar .l-hud-sidebar-actions .c-hud-action-note {
    margin: 2dp 2dp 5dp;
    color: #404040;
    font-size: 10dp;
    line-height: 13dp;
}
.l-hud-sidebar .l-hud-sidebar-actions .c-button,
.l-hud-sidebar .c-hud-sidebar-back {
    display: block;
    width: 100%;
    min-height: 27dp;
    padding: 4dp 6dp;
    text-align: left;
}
.l-hud-sidebar .l-hud-sidebar-actions .c-button { margin-bottom: 2dp; }
.l-hud-sidebar .c-hud-sidebar-back {
    flex: 0 0 auto;
    margin: 5dp 0 0;
    text-align: center;
}

/* Build catalog: compact Windows 98 two-pane workbench. */
.l-hud-build-panel {
    width: 400dp;
    height: 720dp;
    min-height: 420dp;
    max-height: 720dp;
    color: #000000;
    background-color: #c0c0c0;
    border-width: 2dp;
    border-top-color: #ffffff;
    border-left-color: #ffffff;
    border-right-color: #404040;
    border-bottom-color: #404040;
}
.l-hud-build-panel > .c-title-bar { position: absolute; left: 2dp; right: 2dp; top: 2dp; width: auto; height: 30dp; margin: 0; }
.l-hud-build-workbench { position: absolute; left: 4dp; right: 4dp; top: 35dp; bottom: 4dp; display: flex; flex-direction: row; gap: 4dp; min-height: 0; }
.l-hud-build-panel .l-hud-build-rail { position: relative; left: auto; top: auto; flex: 0 0 104dp; width: 104dp; min-width: 104dp; height: 100%; padding: 4dp; box-sizing: border-box; overflow: hidden; background-color: #c0c0c0; border-width: 2dp; border-top-color: #808080; border-left-color: #808080; border-right-color: #ffffff; border-bottom-color: #ffffff; }
.l-hud-build-rail-page { position: relative; display: flex; flex-direction: column; width: 100%; height: 100%; min-height: 0; }
.l-hud-build-rail-page.is-hidden { display: none; }
.c-hud-build-rail-heading { flex: 0 0 auto; margin: 1dp 1dp 4dp; padding-bottom: 3dp; color: #000000; border-bottom-width: 1dp; border-bottom-color: #808080; font-size: 10dp; font-weight: bold; text-transform: uppercase; letter-spacing: 0.5dp; }
.c-hud-build-category-hint { margin: 1dp 1dp 5dp; color: #404040; font-size: 10dp; line-height: 13dp; }
.l-hud-build-category-list, .l-hud-build-type-list { display: block; flex: 1 1 auto; min-height: 0; overflow-y: auto; }
.l-hud-build-category-list .c-hud-build-tab, .l-hud-build-type-list .c-hud-build-type, .c-hud-build-back { display: block; width: 100%; min-width: 0; min-height: 27dp; margin: 0 0 3dp; padding: 4dp 5dp; color: #000000; background-color: #c0c0c0; border-width: 2dp; border-top-color: #ffffff; border-left-color: #ffffff; border-right-color: #404040; border-bottom-color: #404040; border-radius: 0; text-align: left; }
.l-hud-build-category-list .c-hud-build-tab:active, .l-hud-build-category-list .c-hud-build-tab.is-selected, .l-hud-build-type-list .c-hud-build-type:active, .l-hud-build-type-list .c-hud-build-type.is-selected, .c-hud-build-back:active { padding: 5dp 4dp 3dp 6dp; background-color: #d4d0c8; border-top-color: #404040; border-left-color: #404040; border-right-color: #ffffff; border-bottom-color: #ffffff; }
.c-hud-build-back { flex: 0 0 auto; margin-top: 5dp; text-align: center; }
.l-hud-build-panel #hud_build_catalog { position: relative; left: auto; right: auto; top: auto; bottom: auto; flex: 1 1 auto; width: auto; min-width: 0; height: 100%; min-height: 0; max-height: none; padding: 3dp; box-sizing: border-box; overflow: hidden; background-color: #ffffff; border-width: 2dp; border-top-color: #404040; border-left-color: #404040; border-right-color: #ffffff; border-bottom-color: #ffffff; }
.l-hud-build-panel #hud_build_catalog.is-hidden { display: none; }
.l-hud-build-panel #hud_build_catalog .c-hud-build-catalog-header { position: absolute; left: 3dp; right: 3dp; top: 3dp; width: auto; height: 31dp; padding: 5dp; box-sizing: border-box; color: #000000; background-color: #c0c0c0; border-width: 1dp; border-top-color: #ffffff; border-left-color: #ffffff; border-right-color: #808080; border-bottom-color: #808080; }
.l-hud-build-panel #hud_build_items { position: absolute; left: 3dp; right: 3dp; top: 36dp; bottom: 3dp; display: flex; flex-direction: column; flex-wrap: nowrap; align-items: stretch; align-content: stretch; justify-content: flex-start; gap: 3dp; width: auto; min-width: 0; height: auto; min-height: 0; padding: 3dp; overflow-y: auto; overflow-x: hidden; box-sizing: border-box; background-color: #ffffff; }
.l-hud-build-panel #hud_build_items .c-hud-build-card { display: block; flex: 0 0 auto; width: 100%; min-width: 0; max-width: none; height: auto; min-height: 0; max-height: none; padding: 3dp; box-sizing: border-box; background-color: #d4d0c8; border-width: 1dp; border-top-color: #ffffff; border-left-color: #ffffff; border-right-color: #808080; border-bottom-color: #808080; }
.l-hud-build-panel #hud_build_items .c-hud-build-card .c-hud-build-row { width: 100%; min-width: 0; max-width: none; height: 54dp; min-height: 54dp; padding: 4dp; box-sizing: border-box; color: #000000; background-color: #c0c0c0; border-top-color: #ffffff; border-left-color: #ffffff; border-right-color: #404040; border-bottom-color: #404040; }
.l-hud-build-panel #hud_build_items .c-hud-build-copy { width: auto; min-width: 0; }
.l-hud-build-panel #hud_build_items .c-hud-build-requirements { width: 100%; padding: 4dp 2dp 0; box-sizing: border-box; }
.l-hud-build-panel #hud_build_items .c-hud-build-actions { justify-content: flex-end; width: 100%; box-sizing: border-box; }
.l-hud-build-panel #hud_build_items .c-hud-build-availability { display: block; margin: 3dp 2dp 0; font-size: 10dp; font-weight: bold; }
.l-hud-build-panel #hud_build_items .c-hud-build-availability.is-available { color: #1f5f2e; }
.l-hud-build-panel #hud_build_items .c-hud-build-availability.is-unavailable { color: #8b241e; }
.l-hud-build-panel #hud_build_items .c-hud-build-card.is-unavailable { background-color: #c0c0c0; }
.l-hud-build-panel #hud_build_items .c-hud-build-card.is-unavailable .c-hud-build-row { color: #707070; background-color: #c0c0c0; border-top-color: #808080; border-left-color: #808080; border-right-color: #ffffff; border-bottom-color: #ffffff; opacity: 0.72; pointer-events: none; }
.l-hud-build-panel #hud_build_items .c-hud-build-card.is-unavailable .c-hud-build-action { color: #808080; background-color: #c0c0c0; border-top-color: #808080; border-left-color: #808080; border-right-color: #ffffff; border-bottom-color: #ffffff; pointer-events: none; }
.l-hud-build-panel #hud_build_items .c-hud-build-card.is-unavailable .c-hud-build-action.can-place-blueprint { color: #000000; background-color: #c0c0c0; border-top-color: #ffffff; border-left-color: #ffffff; border-right-color: #404040; border-bottom-color: #404040; pointer-events: auto; }
.l-hud-build-panel #hud_build_items .c-hud-build-card.is-unavailable .c-hud-build-action.can-place-blueprint:hover { background-color: #d4d0c8; }

/* Keep lesson targets visible through the sidebar and build rail button styles. */
.l-hud-sidebar .c-button.tutorial-target, .l-hud-build-category-list .c-hud-build-tab.tutorial-target { border-color: #80601f; box-shadow: 0dp 0dp 0dp 2dp #e0a94a; }
