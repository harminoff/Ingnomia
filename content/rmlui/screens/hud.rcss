/* Game window chrome (Stage 17): the toolbar and status bar of the primary window, the drop-down menus, the Build,
   Tutorial and event windows. Controls come from win98_classic.rcss; this file only places them over the map.
   Lengths in em are of the snapped 11/22/33 px system font (1 px at 1x = 1/11 em). */
.l-hud-root { position: absolute; left: 0; top: 0; width: 100%; height: 100%; pointer-events: none; }
.l-hud-root.is-hidden { display: none; }
.is-hidden { display: none; }

.l-hud-toolbar { position: absolute; left: 0; top: 0; right: 0; pointer-events: auto; z-index: 20; }
.l-hud-toolbar.is-hidden { display: none; }
.l-hud-toolbar-groups { display: flex; flex-direction: row; flex-wrap: wrap; align-items: center; flex: 1 1 auto; min-width: 0; }
.l-hud-toolbar-groups.is-hidden { display: none; }
.l-hud-statusbar { position: absolute; left: 0; right: 0; bottom: 0; pointer-events: auto; z-index: 20; }
.l-hud-statusbar.is-hidden { display: none; }
.l-hud-watch { display: flex; flex-direction: row; gap: 0.1818em; flex: 0 0 auto; }
.w98-menu { pointer-events: auto; }

/* Build palette: 384 x 380 px at 1x. In the game window it sits below the toolbar; in its own window it fills it. */
.l-hud-build-panel { position: absolute; right: 0.7273em; top: 3.0909em; display: flex; flex-direction: column; width: 34.9091em; height: 34.5455em; pointer-events: auto; z-index: 30; }
.l-hud-build-panel.is-hidden { display: none; }
.l-hud-tool-window-root .l-hud-build-panel { left: 0; top: 0; right: auto; width: 100%; height: 100%; }
.w98-sheet .l-hud-build-categories { flex: 0 0 8.1818em; width: 8.1818em; }
.w98-sheet .l-hud-build-types { display: flex; flex-direction: row; min-width: 0; }
.w98-sheet .l-hud-build-types select { flex: 1 1 auto; }
.w98-sheet .l-hud-build-status { width: 5.8182em; }

/* Tutorial palette beside the map, below the toolbar. */
.l-hud-tutorial { position: absolute; right: 0.7273em; top: 3.0909em; display: flex; flex-direction: column; width: 29.0909em; pointer-events: auto; z-index: 25; }
.l-hud-tutorial.is-hidden { display: none; }
.w98-sheet .l-hud-tutorial-objective { font-weight: bold; }
.w98-sheet .l-hud-tutorial-list { display: flex; flex-direction: column; }
/* Steps may wrap: each row grows with its text and the check box stays on the first line. */
.w98-sheet .l-hud-tutorial-list .w98-check { height: auto; min-height: 1.4545em; align-items: flex-start; }
.w98-sheet .l-hud-tutorial-list .w98-check input.checkbox { margin-top: 0.0909em; }
.w98-sheet .l-hud-tutorial-list .w98-check span { flex: 1 1 auto; min-width: 0; white-space: normal; }

/* Event message box: centred over the map; the map behind it does not take input. */
.l-hud-modal { position: absolute; left: 0; top: 0; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; pointer-events: auto; z-index: 50; background-color: transparent; }
.l-hud-modal.is-hidden { display: none; }

/* Tutorial targets: the control the current lesson asks for gets the focus rectangle. */
.w98-toolbar button.w98-tool.tutorial-target, .w98-menu button.tutorial-target, .w98-sheet .tutorial-target { decorator: win98-focus(#000000); }
