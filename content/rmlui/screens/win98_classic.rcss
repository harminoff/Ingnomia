/* Windows 98 classic chrome and property-sheet controls.
   Sources: Microsoft Windows User Experience (docs/MS-Windows-User-Experience-2001.pdf) and
   MSDN "Design Specifications and Guidelines - Visual Design" (ms997612, Layout ms997619,
   Design of Visual Elements ms997615, Controls ms997492).

   Pixel-exact scaling: the system font "MS W98 UI" is drawn on an 11 px grid, so the sheet's
   font is snapped to 11, 22 or 33 physical pixels (1x, 2x, 3x by display density) and every
   length below is written in em of that font (1 px at 1x = 1/11 em). Borders, spacing and
   text therefore always land on whole pixels. The window is sized to match in
   MainWindow::ensureDetachedManagement6A. Control marks come from icons/w98-marks.tga (1x
   pixel art, nearest-filtered), drawn with `fill` into padding boxes of the same 1x size.

   Colours are the Windows Standard scheme: 3D face #c0c0c0, 3D light #dfdfdf, highlight
   #ffffff, shadow #808080, window frame #000000, window #ffffff, selection #000080.
   Borders follow "Basic Border Styles": the outer line is the border, the inner line an inset
   box-shadow. Metrics come from the Layout page (1 DLU = 1.5 x 1.625 px at 1x). */

@spritesheet w98-marks {
    src: /icons/w98-marks.tga;
    resolution: 1x;
    w98m-check: 0px 0px 11px 11px;
    w98m-check-disabled: 12px 0px 11px 11px;
    w98m-radio: 24px 0px 10px 10px;
    w98m-radio-disabled: 35px 0px 10px 10px;
    w98m-down: 46px 0px 14px 14px;
    w98m-up: 61px 0px 14px 14px;
    w98m-left: 76px 0px 14px 14px;
    w98m-right: 91px 0px 14px 14px;
    w98m-down-disabled: 106px 0px 14px 14px;
    w98m-up-disabled: 121px 0px 14px 14px;
    w98m-spin-up: 136px 0px 14px 8px;
    w98m-spin-down: 151px 0px 14px 8px;
    w98m-furrow: 166px 0px 16px 16px;
    w98m-ready: 183px 0px 11px 11px;
    w98m-warning: 195px 0px 32px 32px;
    w98m-sort-up: 228px 0px 9px 9px;
    w98m-sort-down: 238px 0px 9px 9px;
    w98m-menu-check: 248px 0px 13px 13px;
    w98m-menu-check-white: 262px 0px 13px 13px;
    w98m-menu-dot: 276px 0px 13px 13px;
    w98m-menu-dot-white: 290px 0px 13px 13px;
    w98m-caret: 304px 0px 5px 3px;
    w98m-caret-disabled: 310px 0px 5px 3px;
    w98m-info: 316px 0px 32px 32px;
}

/* ---------------------------------------------------------------- Font and scale */
.w98-caption, .w98-sheet { font-family: "MS W98 UI"; font-size: 11px; }
@media (min-resolution: 1.5x) { .w98-caption, .w98-sheet { font-size: 22px; } }
@media (min-resolution: 2.5x) { .w98-caption, .w98-sheet { font-size: 33px; } }
.w98-caption h1, .w98-caption h2, .w98-caption button,
.w98-sheet input, .w98-sheet select, .w98-sheet selectvalue, .w98-sheet selectbox, .w98-sheet option, .w98-sheet button,
.w98-sheet label, .w98-sheet p, .w98-sheet span, .w98-sheet div, .w98-sheet section, .w98-sheet nav, .w98-sheet header {
    font-family: "MS W98 UI";
    font-size: 1em;
    font-weight: normal;
}

/* ---------------------------------------------------------------- Caption (all managers) */
.w98-caption {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex: 0 0 1.6364em;
    height: 1.6364em;
    min-height: 1.6364em;
    margin: 0;
    padding: 0 0.1818em 0 0.2727em;
    border-width: 0;
    box-sizing: border-box;
    decorator: horizontal-gradient( #000080 #1084d0 );
}
.is-window-inactive .w98-caption { decorator: horizontal-gradient( #808080 #c0c0c0 ); }
.w98-caption .c-title-bar__drag-handle { display: flex; flex: 1 1 auto; min-width: 0; height: 1.6364em; align-items: center; cursor: move; }
.w98-caption .c-title-bar__title,
.w98-caption h1,
.w98-caption h2 {
    display: block;
    flex: 1 1 auto;
    min-width: 0;
    margin: 0;
    padding: 0;
    color: #ffffff;
    font-weight: bold;
    line-height: 1.2727em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    background-color: transparent;
}
.is-window-inactive .w98-caption .c-title-bar__title,
.is-window-inactive .w98-caption h1,
.is-window-inactive .w98-caption h2 { color: #c0c0c0; }
/* Caption Close button: 16 x 14 with the button border style. */
.w98-caption .w98-caption__close,
.w98-caption button.w98-caption__close {
    flex: 0 0 1.4545em;
    width: 1.4545em;
    min-width: 1.4545em;
    height: 1.2727em;
    min-height: 1.2727em;
    margin: 0;
    padding: 0;
    color: #000000;
    background-color: #c0c0c0;
    border-width: 0.0909em;
    border-top-color: #ffffff; border-left-color: #ffffff;
    border-right-color: #000000; border-bottom-color: #000000;
    box-shadow: inset 0.0909em 0.0909em 0 #dfdfdf, inset -0.0909em -0.0909em 0 #808080;
    font-weight: bold;
    line-height: 1.0909em;
    text-align: center;
    box-sizing: border-box;
    decorator: none;
}
.w98-caption .w98-caption__close:active {
    border-top-color: #000000; border-left-color: #000000;
    border-right-color: #ffffff; border-bottom-color: #ffffff;
    box-shadow: inset 0.0909em 0.0909em 0 #808080, inset -0.0909em -0.0909em 0 #dfdfdf;
    padding: 0.0909em 0 0 0.0909em;
}
.w98-caption .w98-caption__close:hover { background-color: #c0c0c0; color: #000000; }

/* ---------------------------------------------------------------- Property sheet window */
/* Window border style: raised outer (face / frame) + raised inner (highlight / shadow). */
.w98-sheet {
    color: #000000;
    background-color: #c0c0c0;
    line-height: 1.1818em;
    padding: 0.0909em;
    border-width: 0.0909em;
    border-top-color: #c0c0c0; border-left-color: #c0c0c0;
    border-right-color: #000000; border-bottom-color: #000000;
    border-radius: 0;
    box-shadow: inset 0.0909em 0.0909em 0 #ffffff, inset -0.0909em -0.0909em 0 #808080;
    box-sizing: border-box;
}
.w98-sheet .w98-sheet__body {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-height: 0;
    padding: 0.6364em 0.6364em 0 0.6364em;
}

/* Tab control: one row; the selected tab is taller, wider and joins its page. */
.w98-sheet .w98-tabs {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: row;
    align-items: flex-end;
    flex: 0 0 2em;
    height: 2em;
    min-height: 2em;
    margin: 0 0 -0.1818em 0;
    padding: 0 0.1818em;
    gap: 0;
    background-color: transparent;
    border-width: 0;
}
.w98-sheet .w98-tabs .c-tabs__tab {
    flex: 0 0 auto;
    min-width: 5.8182em;
    height: 1.6364em;
    min-height: 1.6364em;
    margin: 0 0 0.1818em 0;
    padding: 0 0.5455em;
    color: #000000;
    background-color: #c0c0c0;
    border-width: 0.0909em 0.0909em 0 0.0909em;
    border-top-color: #ffffff; border-left-color: #ffffff; border-right-color: #000000;
    border-radius: 0.1818em 0.1818em 0 0;
    box-shadow: inset 0.0909em 0.0909em 0 #dfdfdf, inset -0.0909em 0 0 #808080;
    line-height: 1.4545em;
    text-align: center;
    white-space: nowrap;
    box-sizing: border-box;
    decorator: none;
}
.w98-sheet .w98-tabs .c-tabs__tab:hover { color: #000000; background-color: #c0c0c0; }
.w98-sheet .w98-tabs .c-tabs__tab.is-selected {
    position: relative;
    z-index: 3;
    height: 2em;
    min-height: 2em;
    margin: 0 -0.1818em 0 -0.1818em;
    padding: 0.1818em 0.7273em 0 0.7273em;
    line-height: 1.4545em;
}
.w98-sheet .w98-tabs .c-tabs__tab:focus-visible { decorator: win98-focus(#000000); }

/* Page: raised border; pages never scroll. */
.w98-sheet .w98-page-frame {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-height: 0;
    overflow: hidden;
    padding: 0.9091em;
    background-color: #c0c0c0;
    border-width: 0.0909em;
    border-top-color: #ffffff; border-left-color: #ffffff;
    border-right-color: #000000; border-bottom-color: #000000;
    box-shadow: inset 0.0909em 0.0909em 0 #dfdfdf, inset -0.0909em -0.0909em 0 #808080;
    box-sizing: border-box;
}
.w98-sheet .w98-page { display: flex; flex: 1 1 auto; min-height: 0; overflow: hidden; }
.w98-sheet .w98-page.is-hidden { display: none; }
.w98-sheet .w98-row { display: flex; flex-direction: row; align-items: flex-start; gap: 0.6364em; }
.w98-sheet .w98-row--fill { align-items: stretch; }
.w98-sheet .w98-col { display: flex; flex-direction: column; min-width: 0; min-height: 0; }
.w98-sheet .w98-grow { flex: 1 1 auto; min-width: 0; min-height: 0; }
.w98-sheet .w98-stack { display: flex; flex-direction: column; gap: 0.5455em; }
.w98-sheet .w98-line { display: flex; flex-direction: row; align-items: center; gap: 0.5455em; min-height: 1.9091em; }
.w98-sheet .w98-line--end { justify-content: flex-end; }
.w98-sheet .w98-gap { height: 0.5455em; flex: 0 0 0.5455em; }
.w98-sheet .w98-gap--wide { height: 1em; flex: 0 0 1em; }

/* Static text and labels. */
.w98-sheet .w98-label, .w98-sheet label.w98-label { display: block; margin: 0 0 0.2727em 0; color: #000000; line-height: 1.1818em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.w98-sheet .w98-line > .w98-label { margin: 0; flex: 0 0 5.0909em; width: 5.0909em; }
.w98-sheet .w98-text { display: block; margin: 0; color: #000000; line-height: 1.1818em; }
.w98-sheet .w98-text:empty { display: none; }

/* Separator: grouping border style as a horizontal line. */
.w98-sheet .w98-separator { display: block; height: 0.1818em; margin: 0.7273em 0; border-width: 0.0909em 0 0 0; border-top-color: #808080; box-shadow: 0 0.0909em 0 #ffffff; }

/* Group box: grouping border style (sunken outer + raised inner) with the label on the edge. */
.w98-sheet .w98-group {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.3636em;
    margin: 0.6364em 0 0 0;
    padding: 1.1818em 0.8182em 0.7273em 0.8182em;
    border-width: 0.0909em;
    border-top-color: #808080; border-left-color: #808080;
    border-right-color: #ffffff; border-bottom-color: #ffffff;
    box-shadow: inset 0.0909em 0.0909em 0 #ffffff, inset -0.0909em -0.0909em 0 #808080;
    box-sizing: border-box;
}
.w98-sheet .w98-group + .w98-group { margin-top: 1em; }
.w98-sheet .w98-group.is-hidden { display: none; }
.w98-sheet .w98-group__title {
    position: absolute;
    top: -0.6364em;
    left: 0.6364em;
    padding: 0 0.1818em;
    color: #000000;
    background-color: #c0c0c0;
    line-height: 1.1818em;
    white-space: nowrap;
}

/* Command buttons: 75 x 23, button border style; pressed = sunken and label moves 1 px. */
.w98-sheet button.w98-button,
.w98-sheet .w98-button {
    display: inline-block;
    flex: 0 0 auto;
    min-width: 6.8182em;
    width: auto;
    height: 2.0909em;
    min-height: 2.0909em;
    margin: 0;
    padding: 0 0.5455em;
    color: #000000;
    background-color: #c0c0c0;
    border-width: 0.0909em;
    border-top-color: #ffffff; border-left-color: #ffffff;
    border-right-color: #000000; border-bottom-color: #000000;
    border-radius: 0;
    box-shadow: inset 0.0909em 0.0909em 0 #dfdfdf, inset -0.0909em -0.0909em 0 #808080;
    line-height: 1.9091em;
    text-align: center;
    white-space: nowrap;
    box-sizing: border-box;
    decorator: none;
}
.w98-sheet .w98-button:hover { color: #000000; background-color: #c0c0c0; }
/* Pressed by mouse, or held down with Space or Enter (the input adapter sets is-key-pressed). */
.w98-sheet .w98-button:active, .w98-sheet .w98-button.is-key-pressed {
    border-top-color: #000000; border-left-color: #000000;
    border-right-color: #ffffff; border-bottom-color: #ffffff;
    box-shadow: inset 0.0909em 0.0909em 0 #808080, inset -0.0909em -0.0909em 0 #dfdfdf;
    padding: 0.0909em 0.4545em 0 0.6364em;
    line-height: 1.8182em;
}
/* Default button: an extra window-frame outline around the button border. */
.w98-sheet .w98-button--default {
    border-color: #000000;
    box-shadow: inset 0.0909em 0.0909em 0 #ffffff, inset -0.0909em -0.0909em 0 #000000, inset 0.1818em 0.1818em 0 #dfdfdf, inset -0.1818em -0.1818em 0 #808080;
}
.w98-sheet .w98-button:focus-visible { decorator: win98-focus(#000000); }
/* Unavailable: engraved label (shadow colour with a highlight offset). */
.w98-sheet .w98-button[disabled], .w98-sheet .w98-button:disabled {
    color: #808080;
    font-effect: shadow( 0.0909em 0.0909em #ffffff );
    cursor: arrow;
}
.w98-sheet .w98-button[disabled]:active {
    border-top-color: #ffffff; border-left-color: #ffffff; border-right-color: #000000; border-bottom-color: #000000;
    box-shadow: inset 0.0909em 0.0909em 0 #dfdfdf, inset -0.0909em -0.0909em 0 #808080;
    padding: 0 0.5455em; line-height: 1.9091em;
}

/* Field border style: text boxes, spin boxes, drop-down lists, list boxes. */
.w98-sheet input.w98-field,
.w98-sheet .w98-field {
    height: 1.9091em;
    min-height: 1.9091em;
    margin: 0;
    padding: 0 0.2727em;
    color: #000000;
    background-color: #ffffff;
    border-width: 0.0909em;
    border-top-color: #808080; border-left-color: #808080;
    border-right-color: #ffffff; border-bottom-color: #ffffff;
    border-radius: 0;
    box-shadow: inset 0.0909em 0.0909em 0 #000000, inset -0.0909em -0.0909em 0 #dfdfdf;
    line-height: 1.7273em;
    box-sizing: border-box;
}
.w98-sheet input.w98-field[disabled] { color: #808080; background-color: #c0c0c0; }
.w98-sheet .w98-field--wide { flex: 1 1 auto; width: auto; min-width: 0; }

/* Spin box: a text box with an attached up-down control; numbers are left-aligned. */
.w98-sheet .w98-spin { display: flex; flex-direction: row; flex: 0 0 auto; width: auto; min-width: 0; height: 1.9091em; }
.w98-sheet .w98-spin input.w98-field { flex: 0 0 3.6364em; width: 3.6364em; min-width: 3.6364em; text-align: left; border-right-width: 0; box-shadow: inset 0.0909em 0.0909em 0 #000000, inset 0 -0.0909em 0 #dfdfdf; }
.w98-sheet .w98-spin .c-numeric-editor__arrows {
    display: flex; flex-direction: column; flex: 0 0 1.4545em; width: 1.4545em; height: 1.9091em;
    padding: 0.0909em 0 0 0;
    border-width: 0;
    background-color: #c0c0c0;
    box-shadow: none;
    box-sizing: border-box;
}
.w98-sheet .w98-spin .c-numeric-editor__arrows button {
    flex: 0 0 0.9091em;
    width: 1.4545em; min-width: 0; height: 0.9091em; min-height: 0; margin: 0; padding: 0;
    background-color: #c0c0c0;
    border-width: 0.0909em;
    border-top-color: #dfdfdf; border-left-color: #dfdfdf; border-right-color: #000000; border-bottom-color: #000000;
    box-shadow: inset 0.0909em 0.0909em 0 #ffffff, inset -0.0909em -0.0909em 0 #808080;
    box-sizing: border-box;
}
.w98-sheet .w98-spin .c-numeric-editor__up { decorator: image( w98m-spin-up fill ); }
.w98-sheet .w98-spin .c-numeric-editor__down { decorator: image( w98m-spin-down fill ); }
.w98-sheet .w98-spin .c-numeric-editor__arrows button:active { border-color: #808080; box-shadow: none; }
.w98-sheet .w98-spin .c-numeric-editor__arrows button:focus-visible { decorator: image( w98m-spin-up fill ); }
.w98-sheet .w98-spin .c-numeric-editor__down:focus-visible { decorator: image( w98m-spin-down fill ); }

/* Drop-down list box: field border; the arrow uses the button border style. */
.w98-sheet select.w98-select {
    display: block;
    flex: 1 1 auto;
    width: auto;
    min-width: 0;
    height: 1.9091em;
    min-height: 1.9091em;
    margin: 0;
    padding: 0;
    color: #000000;
    background-color: #ffffff;
    border-width: 0.0909em;
    border-top-color: #808080; border-left-color: #808080;
    border-right-color: #ffffff; border-bottom-color: #ffffff;
    box-shadow: inset 0.0909em 0.0909em 0 #000000, inset -0.0909em -0.0909em 0 #dfdfdf;
    line-height: 1.1818em;
    box-sizing: border-box;
}
.w98-sheet select.w98-select selectvalue { width: auto; height: 1.7273em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin: 0 1.6364em 0 0; padding: 0.2727em 0.2727em 0 0.2727em; color: #000000; background-color: #ffffff; box-sizing: border-box; }
.w98-sheet select.w98-select selectarrow {
    width: 1.4545em; height: 1.4545em; margin: 0.0909em 0.0909em 0 0;
    background-color: #c0c0c0;
    border-width: 0.0909em;
    border-top-color: #dfdfdf; border-left-color: #dfdfdf; border-right-color: #000000; border-bottom-color: #000000;
    box-shadow: inset 0.0909em 0.0909em 0 #ffffff, inset -0.0909em -0.0909em 0 #808080;
    box-sizing: border-box;
    decorator: image( w98m-down fill );
}
.w98-sheet select.w98-select selectarrow:active { border-color: #808080; box-shadow: none; }
.w98-sheet select.w98-select selectbox { margin-top: 0; padding: 0; background-color: #ffffff; border-width: 0.0909em; border-color: #000000; }
.w98-sheet select.w98-select selectbox option { display: block; height: 1.4545em; min-height: 1.4545em; padding: 0 0.2727em; color: #000000; background-color: #ffffff; line-height: 1.4545em; }
.w98-sheet select.w98-select selectbox option:hover,
.w98-sheet select.w98-select selectbox option:checked { color: #ffffff; background-color: #000080; }

/* Drop-down combo box (PDF p.140): a text box with the drop-down arrow inside one field border; the list
   drops below the field with a one-pixel black border, like the drop-down list box. */
.w98-sheet .w98-combo {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    min-width: 0;
    height: 1.9091em;
    min-height: 1.9091em;
    padding: 0.1818em;
    background-color: #ffffff;
    border-width: 0.0909em;
    border-top-color: #808080; border-left-color: #808080;
    border-right-color: #ffffff; border-bottom-color: #ffffff;
    box-shadow: inset 0.0909em 0.0909em 0 #000000, inset -0.0909em -0.0909em 0 #dfdfdf;
    box-sizing: border-box;
}
.w98-sheet .w98-combo input.w98-combo__field {
    flex: 1 1 auto; width: auto; min-width: 0; height: 1.5455em; min-height: 0; max-height: 1.5455em; margin: 0; padding: 0.1818em 0.0909em 0 0.0909em;
    color: #000000; background-color: #ffffff; border-width: 0; border-radius: 0; box-shadow: none; line-height: 1.1818em; box-sizing: border-box;
}
.w98-sheet .w98-combo button.w98-combo__arrow {
    flex: 0 0 1.4545em; width: 1.4545em; height: 1.4545em; min-width: 0; min-height: 0; margin: -0.0909em -0.0909em 0 0; padding: 0;
    background-color: #c0c0c0;
    border-width: 0.0909em;
    border-top-color: #dfdfdf; border-left-color: #dfdfdf; border-right-color: #000000; border-bottom-color: #000000;
    box-shadow: inset 0.0909em 0.0909em 0 #ffffff, inset -0.0909em -0.0909em 0 #808080;
    box-sizing: border-box;
    decorator: image( w98m-down fill );
}
.w98-sheet .w98-combo button.w98-combo__arrow:active { border-color: #808080; box-shadow: none; }
.w98-sheet .w98-combo__list {
    position: absolute; z-index: 20; display: block; max-height: 11.8182em; overflow-y: auto; padding: 0;
    background-color: #ffffff; border-width: 0.0909em; border-color: #000000; box-sizing: border-box;
}
.w98-sheet .w98-combo__list.is-hidden { display: none; }

/* Check boxes (13 x 13) and option buttons (12 x 12). */
.w98-sheet .w98-check {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.3636em;
    height: 1.4545em;
    min-height: 1.4545em;
    margin: 0;
    color: #000000;
    line-height: 1.1818em;
    white-space: nowrap;
}
.w98-sheet .w98-check input.checkbox,
.w98-sheet .w98-check input.radio {
    flex: 0 0 1.1818em;
    width: 1.1818em;
    height: 1.1818em;
    margin: 0;
    padding: 0;
    background-color: #ffffff;
    border-width: 0.0909em;
    border-top-color: #808080; border-left-color: #808080;
    border-right-color: #ffffff; border-bottom-color: #ffffff;
    border-radius: 0;
    box-shadow: inset 0.0909em 0.0909em 0 #000000, inset -0.0909em -0.0909em 0 #dfdfdf;
    box-sizing: border-box;
    decorator: none;
}
.w98-sheet .w98-check input.radio { flex: 0 0 1.0909em; width: 1.0909em; height: 1.0909em; border-radius: 0.5455em; }
.w98-sheet .w98-check input.checkbox:checked { decorator: image( w98m-check fill ); }
.w98-sheet .w98-check input.radio:checked { decorator: image( w98m-radio fill ); }
.w98-sheet .w98-check input.checkbox[disabled] { background-color: #c0c0c0; }
.w98-sheet .w98-check input.checkbox[disabled]:checked { decorator: image( w98m-check-disabled fill ); }
.w98-sheet .w98-check input:focus-visible + span { decorator: win98-focus(#000000); }
.w98-sheet .w98-check.is-disabled { color: #808080; font-effect: shadow( 0.0909em 0.0909em #ffffff ); }

/* List box / list view: field border, 16 px rows, selection highlight. */
.w98-sheet .w98-list {
    display: block;
    flex: 1 1 auto;
    min-height: 0;
    overflow-x: hidden;
    overflow-y: scroll;
    margin: 0;
    padding: 0.1818em;
    color: #000000;
    background-color: #ffffff;
    border-width: 0.0909em;
    border-top-color: #808080; border-left-color: #808080;
    border-right-color: #ffffff; border-bottom-color: #ffffff;
    box-shadow: inset 0.0909em 0.0909em 0 #000000, inset -0.0909em -0.0909em 0 #dfdfdf;
    box-sizing: border-box;
}
.w98-sheet .w98-list-item,
.w98-sheet button.w98-list-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    width: 100%;
    height: 1.4545em;
    min-height: 1.4545em;
    margin: 0;
    padding: 0 0.1818em;
    color: #000000;
    background-color: #ffffff;
    border-width: 0;
    border-radius: 0;
    box-shadow: none;
    line-height: 1.4545em;
    text-align: left;
    white-space: nowrap;
    overflow: hidden;
    box-sizing: border-box;
    decorator: none;
}
.w98-sheet .w98-list-item:hover { color: #000000; background-color: #ffffff; }
.w98-sheet .w98-list-item.is-selected,
.w98-sheet .w98-list-item.is-selected:hover { color: #ffffff; background-color: #000080; }
.w98-sheet .w98-list-item:focus-visible { decorator: win98-focus(#000000); }
.w98-sheet .w98-list-empty { display: block; padding: 0.0909em 0.1818em; color: #808080; }
/* Flat check boxes inside a list box (Visual Design: Flat Appearance). */
.w98-sheet .w98-list-item input.checkbox {
    flex: 0 0 1.1818em; width: 1.1818em; height: 1.1818em; margin: 0 0.3636em 0 0; padding: 0;
    background-color: #ffffff;
    border-width: 0.0909em; border-color: #808080;
    border-radius: 0;
    box-shadow: none;
    box-sizing: border-box;
    decorator: none;
}
.w98-sheet .w98-list-item input.checkbox:checked { decorator: image( w98m-check fill ); }
.w98-sheet .w98-list-item span { line-height: 1.4545em; }

/* List view in details view: column headers use the button border style. */
.w98-sheet .w98-listview {
    display: flex; flex-direction: column; flex: 1 1 auto; min-height: 0;
    padding: 0.1818em;
    background-color: #ffffff;
    border-width: 0.0909em;
    border-top-color: #808080; border-left-color: #808080; border-right-color: #ffffff; border-bottom-color: #ffffff;
    box-shadow: inset 0.0909em 0.0909em 0 #000000, inset -0.0909em -0.0909em 0 #dfdfdf;
    box-sizing: border-box;
}
.w98-sheet .w98-listview .w98-list { padding: 0; border-width: 0; box-shadow: none; }
.w98-sheet .w98-listview__header { display: flex; flex-direction: row; flex: 0 0 1.5455em; height: 1.5455em; padding-right: 1.4545em; background-color: #c0c0c0; }
.w98-sheet .w98-listview__header > span {
    display: block;
    height: 1.5455em;
    padding: 0 0.3636em;
    color: #000000;
    background-color: #c0c0c0;
    border-width: 0.0909em;
    border-top-color: #ffffff; border-left-color: #ffffff; border-right-color: #000000; border-bottom-color: #000000;
    box-shadow: inset -0.0909em -0.0909em 0 #808080;
    line-height: 1.3636em;
    white-space: nowrap;
    overflow: hidden;
    box-sizing: border-box;
}
/* Sortable column headings are buttons with the heading style; pressed while clicked (PDF p.143). */
.w98-sheet .w98-listview__header > button.w98-listview__heading {
    display: block; flex: 0 0 auto; height: 1.5455em; min-height: 0; min-width: 0; margin: 0; padding: 0 0.3636em;
    color: #000000; background-color: #c0c0c0; text-align: left; white-space: nowrap; overflow: hidden;
    border-width: 0.0909em; border-top-color: #ffffff; border-left-color: #ffffff; border-right-color: #000000; border-bottom-color: #000000;
    box-shadow: inset -0.0909em -0.0909em 0 #808080; border-radius: 0; line-height: 1.3636em; box-sizing: border-box; decorator: none;
}
.w98-sheet .w98-listview__header > button.w98-listview__heading.w98-cell--grow { flex: 1 1 auto; }
/* Numbers and their headings are right-aligned (PDF p.143, p.332). */
.w98-sheet .w98-listview__header > button.w98-listview__heading.l-sp-w-number { text-align: right; }
.w98-sheet .w98-listview__heading span.w98-sort-mark { display: inline-block; width: 0.8182em; height: 0.8182em; margin: 0 0 0 0.3636em; vertical-align: middle; decorator: image( w98m-sort-up fill ); }
.w98-sheet .w98-listview__heading span.w98-sort-mark.is-descending { decorator: image( w98m-sort-down fill ); }
.w98-sheet .w98-listview__header > button.w98-listview__heading:hover { background-color: #c0c0c0; color: #000000; }
.w98-sheet .w98-listview__header > button.w98-listview__heading:active { border-color: #808080; box-shadow: none; padding: 0.0909em 0.2727em 0 0.4545em; }
.w98-sheet .w98-listview__header > button.w98-listview__heading:focus-visible { decorator: win98-focus(#000000); }
.w98-sheet .w98-cell { display: block; flex: 0 0 auto; padding: 0 0.3636em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; box-sizing: border-box; }
.w98-sheet .w98-cell--grow { flex: 1 1 auto; min-width: 0; }
.w98-sheet .w98-cell--num { text-align: right; }
.w98-sheet .w98-list-item > .w98-cell:first-child { padding-left: 0.0909em; }
.w98-sheet .w98-w-amount { width: 4.3636em; }
/* Stockpile Contents and Allow List columns (Stage 21a). */
.w98-sheet .l-sp-w-material, .w98-sheet .l-sp-w-type { flex: 0 0 7.2727em; width: 7.2727em; }
.w98-sheet .l-sp-w-number { flex: 0 0 4em; width: 4em; text-align: right; }
.w98-sheet .l-sp-find { flex: 1 1 auto; width: auto; min-width: 0; }
.w98-sheet select.w98-select.l-sp-category { flex: 0 0 9.4545em; width: 9.4545em; }
.w98-sheet .l-sp-spacer { display: block; width: 100%; flex: 0 0 auto; }
/* Inventory (Stage 21b): Item Properties is a subordinate sheet drawn over the Inventory window. */
.w98-sheet.l-inv-detail { position: absolute; left: 0; top: 0; width: 100%; height: 100%; z-index: 10; }
/* Windows 98 reports an entry out of range in a message box, not in red text beside the field. */
.w98-sheet .c-field__error, .w98-sheet .c-field__error.u-hidden { display: none; }
.w98-sheet .w98-w-state { width: 5.8182em; }
.w98-sheet .w98-w-stock { width: 4.7273em; }
.w98-sheet .w98-w-offer { width: 3.6364em; }
.w98-sheet .w98-w-value { width: 3.6364em; }
.w98-sheet .w98-w-profession { width: 10em; }
.w98-sheet .w98-w-slot { width: 7.6364em; }
.w98-sheet .w98-skill-list { flex: 0 0 10.1818em; width: 10.1818em; }
.w98-sheet .w98-transfer { flex: 0 0 auto; }
/* Grid (Excel 97 model; the book has no grid control): button-face headings that stay in place, a Select All
   corner, white cells with gray grid lines, navy range selection, and a heavy black border on the active cell. */
.w98-sheet .w98-grid {
    display: flex; flex-direction: column; flex: 1 1 0; min-height: 0; background-color: #ffffff;
    border-width: 0.0909em; border-top-color: #808080; border-left-color: #808080; border-right-color: #ffffff; border-bottom-color: #ffffff;
    box-shadow: inset 0.0909em 0.0909em 0 #000000, inset -0.0909em -0.0909em 0 #dfdfdf; padding: 0.1818em; box-sizing: border-box;
}
.w98-sheet .w98-grid__top { display: flex; flex-direction: row; flex: 0 0 1.4545em; height: 1.4545em; }
.w98-sheet .w98-grid__main { display: flex; flex-direction: row; flex: 1 1 0; min-height: 0; }
.w98-sheet .w98-grid__colheads { display: flex; flex-direction: row; flex: 1 1 0; min-width: 0; overflow: hidden; margin-right: 1.4545em; }
.w98-sheet .w98-grid__rowheads { display: block; flex: 0 0 6.5455em; width: 6.5455em; overflow: hidden; margin-bottom: 1.4545em; }
.w98-sheet .w98-grid__cells { display: block; flex: 1 1 0; min-width: 0; min-height: 0; overflow: scroll; }
.w98-sheet .w98-grid__row { display: flex; flex-direction: row; width: 34.9091em; height: 1.4545em; }
.w98-sheet button.w98-grid__corner, .w98-sheet button.w98-grid__colhead, .w98-sheet button.w98-grid__rowhead {
    display: block; margin: 0; padding: 0 0.1818em; min-width: 0; min-height: 0; color: #000000; background-color: #c0c0c0;
    border-width: 0 0.0909em 0.0909em 0; border-color: #808080; border-radius: 0; box-shadow: inset 0.0909em 0.0909em 0 #ffffff;
    line-height: 1.3636em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; box-sizing: border-box; decorator: none;
}
.w98-sheet button.w98-grid__corner { flex: 0 0 6.5455em; width: 6.5455em; height: 1.4545em; }
.w98-sheet button.w98-grid__colhead { flex: 0 0 1.4545em; width: 1.4545em; height: 1.4545em; padding: 0; text-align: center; }
.w98-sheet button.w98-grid__rowhead { width: 100%; height: 1.4545em; text-align: left; }
.w98-sheet button.w98-grid__colhead.is-highlighted, .w98-sheet button.w98-grid__rowhead.is-highlighted { font-weight: bold; }
.w98-sheet button.w98-grid__corner:hover, .w98-sheet button.w98-grid__colhead:hover, .w98-sheet button.w98-grid__rowhead:hover { background-color: #c0c0c0; color: #000000; }
.w98-sheet button.w98-grid__corner:active, .w98-sheet button.w98-grid__colhead:active, .w98-sheet button.w98-grid__rowhead:active { box-shadow: none; }
.w98-sheet button.w98-grid__cell {
    display: block; flex: 0 0 1.4545em; width: 1.4545em; height: 1.4545em; min-width: 0; min-height: 0; margin: 0; padding: 0;
    color: #000000; background-color: #ffffff; border-width: 0 0.0909em 0.0909em 0; border-color: #c0c0c0; border-radius: 0; box-shadow: none;
    line-height: 1.3636em; text-align: center; box-sizing: border-box; decorator: none;
}
.w98-sheet button.w98-grid__cell:hover { background-color: #ffffff; }
.w98-sheet button.w98-grid__cell.is-selected, .w98-sheet button.w98-grid__cell.is-selected:hover { color: #ffffff; background-color: #000080; }
.w98-sheet button.w98-grid__cell.is-active, .w98-sheet button.w98-grid__cell.is-active:hover {
    color: #000000; background-color: #ffffff; border-width: 0.1818em; border-color: #000000;
}

/* Scroll bars inside the sheet: 16 px, arrow buttons, button-style thumb. */
.w98-sheet scrollbarvertical { width: 1.4545em; margin: 0; padding: 0; background-color: #e0e0e0; }
.w98-sheet scrollbarvertical slidertrack { background-color: #e0e0e0; border-width: 0; decorator: none; }
.w98-sheet scrollbarvertical sliderbar,
.w98-sheet scrollbarvertical sliderarrowdec,
.w98-sheet scrollbarvertical sliderarrowinc {
    width: 1.4545em;
    background-color: #c0c0c0;
    border-width: 0.0909em;
    border-top-color: #dfdfdf; border-left-color: #dfdfdf; border-right-color: #000000; border-bottom-color: #000000;
    box-shadow: inset 0.0909em 0.0909em 0 #ffffff, inset -0.0909em -0.0909em 0 #808080;
    box-sizing: border-box;
}
.w98-sheet scrollbarvertical sliderbar { min-height: 0.7273em; margin: 0; decorator: none; }
.w98-sheet scrollbarvertical sliderarrowdec { height: 1.4545em; decorator: image( w98m-up fill ); }
.w98-sheet scrollbarvertical sliderarrowinc { height: 1.4545em; decorator: image( w98m-down fill ); }
.w98-sheet scrollbarvertical sliderarrowdec:active,
.w98-sheet scrollbarvertical sliderarrowinc:active { border-color: #808080; box-shadow: none; }

.w98-sheet scrollbarhorizontal { height: 1.4545em; margin: 0; padding: 0; background-color: #e0e0e0; }
.w98-sheet scrollbarhorizontal slidertrack { background-color: #e0e0e0; border-width: 0; decorator: none; }
.w98-sheet scrollbarhorizontal sliderbar,
.w98-sheet scrollbarhorizontal sliderarrowdec,
.w98-sheet scrollbarhorizontal sliderarrowinc {
    height: 1.4545em;
    background-color: #c0c0c0;
    border-width: 0.0909em;
    border-top-color: #dfdfdf; border-left-color: #dfdfdf; border-right-color: #000000; border-bottom-color: #000000;
    box-shadow: inset 0.0909em 0.0909em 0 #ffffff, inset -0.0909em -0.0909em 0 #808080;
    box-sizing: border-box;
}
.w98-sheet scrollbarhorizontal sliderbar { min-width: 0.7273em; margin: 0; decorator: none; }
.w98-sheet scrollbarhorizontal sliderarrowdec { width: 1.4545em; decorator: image( w98m-left fill ); }
.w98-sheet scrollbarhorizontal sliderarrowinc { width: 1.4545em; decorator: image( w98m-right fill ); }
.w98-sheet scrollbarhorizontal sliderarrowdec:active,
.w98-sheet scrollbarhorizontal sliderarrowinc:active { border-color: #808080; box-shadow: none; }
.w98-sheet scrollbarcorner { background-color: #c0c0c0; }

/* Farm plot grid: a list view in small-icon view laid out like the field (16 px icons in 20 px cells).
   Selection uses the list view highlight; ground state has its own glyph so colour is never the only cue. */
.w98-sheet .w98-plot-grid { overflow-x: auto; overflow-y: auto; padding: 0.1818em; }
.w98-sheet .w98-plot-row { display: flex; flex-direction: row; }
.w98-sheet .w98-plot-layer { display: block; height: 1.4545em; line-height: 1.4545em; color: #000000; }
.w98-sheet .w98-plot-gap { display: block; flex: 0 0 1.8182em; width: 1.8182em; height: 1.8182em; }
.w98-sheet button.w98-plot {
    display: block; flex: 0 0 1.8182em; width: 1.8182em; height: 1.8182em; min-width: 0; min-height: 0; margin: 0; padding: 0.1818em;
    background-color: #ffffff; border-width: 0; border-radius: 0; box-shadow: none; decorator: none; box-sizing: border-box;
}
.w98-sheet button.w98-plot:hover { background-color: #ffffff; }
.w98-sheet button.w98-plot.is-selected, .w98-sheet button.w98-plot.is-selected:hover { background-color: #000080; }
.w98-sheet button.w98-plot:focus-visible, .w98-sheet button.w98-plot.is-focused { decorator: win98-focus(#000000); }
.w98-sheet button.w98-plot.is-selected:focus-visible, .w98-sheet button.w98-plot.is-selected.is-focused { decorator: win98-focus(#ffffff); }
.w98-sheet .w98-plot__ground { display: block; position: relative; width: 1.4545em; height: 1.4545em; border-width: 0.0909em; border-color: #808080; box-sizing: border-box; }
.w98-sheet .w98-plot__ground.is-tilled { decorator: image( w98m-furrow fill ); }
.w98-sheet .w98-plot__ground img { display: block; width: 1.2727em; height: 1.2727em; }
.w98-sheet .w98-plot__ground img.is-planned { opacity: 0.45; }
.w98-sheet .w98-plot__ready { display: block; position: absolute; right: -0.1818em; bottom: -0.1818em; width: 1em; height: 1em; decorator: image( w98m-ready fill ); }
.w98-sheet .w98-plot-legend span.w98-plot-swatch {
    display: inline-block; width: 1em; height: 1em; margin: 0 0.1818em 0 0.5455em; vertical-align: middle;
    background-color: #ffffff; border-width: 0.0909em; border-color: #808080; box-sizing: border-box;
}
.w98-sheet .w98-plot-legend span.w98-plot-swatch:first-child { margin-left: 0; }
.w98-sheet .w98-plot-legend span.w98-plot-swatch.is-tilled { decorator: image( w98m-furrow fill ); }
.w98-sheet .w98-plot-legend span.w98-plot-swatch.is-ready { border-width: 0; decorator: image( w98m-ready fill ); }

/* Message box (PDF p.182-187): caption, 32 x 32 symbol, message, centered command buttons.
   The button with the focus carries the default outline, as in Windows. */
body.w98-msgbox-stage { display: flex; width: 100%; height: 100%; margin: 0; padding: 0; align-items: center; justify-content: center; background-color: transparent; }
.w98-msgbox { display: flex; flex-direction: column; width: 28.3636em; max-width: 96%; }
.w98-msgbox .w98-msgbox__body { display: flex; flex-direction: row; align-items: flex-start; padding: 1em 1em 0.6364em 1em; }
.w98-msgbox .w98-msgbox__symbol { display: block; flex: 0 0 2.9091em; width: 2.9091em; height: 2.9091em; margin: 0 1em 0 0; decorator: image( w98m-warning fill ); }
.w98-msgbox .w98-msgbox__text { flex: 1 1 auto; min-width: 0; padding-top: 0.1818em; white-space: normal; }
.w98-msgbox .w98-msgbox__buttons { display: flex; flex-direction: row; justify-content: center; gap: 0.5455em; padding: 0.3636em 1em 1em 1em; }
.w98-msgbox .w98-button:focus {
    border-color: #000000;
    box-shadow: inset 0.0909em 0.0909em 0 #ffffff, inset -0.0909em -0.0909em 0 #000000, inset 0.1818em 0.1818em 0 #dfdfdf, inset -0.1818em -0.1818em 0 #808080;
    decorator: win98-focus(#000000);
}

/* Wizard (PDF p.304-309): a dialog over its owner window. Interior pages have a white header with a bold
   title and a subtitle, etched separators, and < Back / Next > adjacent with Finish and Cancel after them. */
.w98-sheet .w98-modal-layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-content: center; z-index: 30; background-color: transparent; }
.w98-sheet .w98-modal-layer.is-hidden { display: none; }
.w98-wizard { display: flex; flex-direction: column; width: 33.0909em; height: 30.9091em; }
.w98-wizard .w98-wizard__header { display: block; flex: 0 0 auto; padding: 0.6364em 1em; background-color: #ffffff; border-width: 0 0 0.0909em 0; border-bottom-color: #808080; box-shadow: 0 0.0909em 0 #ffffff; }
.w98-wizard p.w98-wizard__title { display: block; margin: 0 0 0.1818em 0; font-weight: bold; color: #000000; line-height: 1.1818em; }
.w98-wizard .w98-wizard__body { display: flex; flex-direction: column; flex: 1 1 0; min-height: 0; padding: 0.6364em 1em; }
.w98-wizard .w98-wizard__buttons { display: flex; flex-direction: row; justify-content: flex-end; flex: 0 0 auto; gap: 0; padding: 0.6364em 1em; border-width: 0.0909em 0 0 0; border-top-color: #808080; box-shadow: inset 0 0.0909em 0 #ffffff; }
.w98-wizard .w98-wizard__gap { margin-left: 0.5455em; }

/* Button bar outside the pages: OK, Cancel, Apply, right-aligned. */
.w98-sheet .w98-buttonbar {
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    flex: 0 0 auto;
    gap: 0.5455em;
    padding: 0.6364em 0 0.6364em 0;
}

/* Workshop sheet: override older route rules that target these IDs. */
#workshop_workbench.w98-sheet #workshop_trade_count { flex: 0 0 3.6364em; width: 3.6364em; text-align: left; }
.w98-sheet .w98-craft-list { flex: 0 0 10.7273em; width: 10.7273em; }

/* Palette window (PDF p.180-181): a shorter title bar with only a Close button, and no button bar. Used by the
   property inspectors, which follow the selection and apply edits immediately (PDF p.167). */
.w98-palette > .w98-caption { flex: 0 0 1.3636em; height: 1.3636em; min-height: 1.3636em; }
.w98-palette > .w98-caption .c-title-bar__drag-handle { height: 1.3636em; }
.w98-palette > .w98-caption h1, .w98-palette > .w98-caption h2 { line-height: 1.1818em; }
.w98-palette > .w98-caption .w98-caption__close,
.w98-palette > .w98-caption button.w98-caption__close { flex: 0 0 1.1818em; width: 1.1818em; min-width: 1.1818em; height: 1em; min-height: 1em; line-height: 0.8182em; }
.w98-palette .w98-sheet__body { padding-bottom: 0.6364em; }
.w98-palette .w98-buttonbar { padding-bottom: 0; }
.w98-sheet .w98-label--wide, .w98-sheet .w98-line > .w98-label--wide { flex: 0 0 8.7273em; width: 8.7273em; }
/* Buttons that act on the whole page wrap onto further rows instead of widening the window. */
.w98-sheet .w98-commands { display: flex; flex-direction: row; flex-wrap: wrap; flex: 0 0 auto; gap: 0.3636em 0.5455em; }
/* Picture well: a static area with the field border style (sunken), holding a picture. */
.w98-sheet .w98-well {
    display: block; min-height: 0; overflow: hidden; background-color: #000000;
    border-width: 0.0909em; border-top-color: #808080; border-left-color: #808080; border-right-color: #ffffff; border-bottom-color: #ffffff;
    box-shadow: inset 0.0909em 0.0909em 0 #000000, inset -0.0909em -0.0909em 0 #dfdfdf; box-sizing: border-box;
}
.w98-sheet .w98-well img { display: block; width: 100%; height: 100%; }

/* ToolTip control (PDF p.148; colors from Visual Design): info background, black text and a 1 px black border. */
.w98-tooltip {
    font-family: "MS W98 UI"; font-size: 11px; line-height: 1.1818em;
    padding: 0.0909em 0.2727em 0.1818em 0.2727em; color: #000000; background-color: #ffffe1;
    border-width: 0.0909em; border-color: #000000; box-sizing: border-box; white-space: nowrap;
}
@media (min-resolution: 1.5x) { .w98-tooltip { font-size: 22px; } }
@media (min-resolution: 2.5x) { .w98-tooltip { font-size: 33px; } }
.w98-tooltip span, .w98-tooltip strong { font-family: "MS W98 UI"; font-size: 1em; font-weight: normal; color: #000000; }

/* ---------------------------------------------------------------- Primary window bars (Stage 17)
   Toolbar (PDF p.151-155, p.319, p.322, p.325, p.345), drop-down menus (PDF p.111-126, p.326) and the status bar
   (PDF p.155, p.288-289, p.320). They sit on the game window outside any sheet, so they carry the font rules. */
.w98-toolbar, .w98-statusbar, .w98-menu {
    font-family: "MS W98 UI"; font-size: 11px; line-height: 1.1818em; color: #000000; box-sizing: border-box;
}
@media (min-resolution: 1.5x) { .w98-toolbar, .w98-statusbar, .w98-menu { font-size: 22px; } }
@media (min-resolution: 2.5x) { .w98-toolbar, .w98-statusbar, .w98-menu { font-size: 33px; } }
.w98-toolbar button, .w98-toolbar span, .w98-toolbar div, .w98-statusbar span, .w98-statusbar p, .w98-statusbar div,
.w98-menu button, .w98-menu span, .w98-menu div { font-family: "MS W98 UI"; font-size: 1em; font-weight: normal; }

/* Toolbar band: button face with etched lines above and below; buttons wrap onto further rows. */
.w98-toolbar {
    display: flex; flex-direction: row; flex-wrap: wrap; align-items: center; gap: 0.0909em 0;
    padding: 0.1818em 0.1818em; background-color: #c0c0c0;
    border-width: 0.0909em 0; border-top-color: #ffffff; border-bottom-color: #808080;
}
/* Flat toolbar button: no border until the pointer is over it (PDF p.319, p.325). */
.w98-toolbar button.w98-tool {
    display: flex; flex-direction: row; align-items: center; flex: 0 0 auto;
    height: 2em; min-height: 2em; min-width: 0; margin: 0; padding: 0 0.5455em;
    color: #000000; background-color: #c0c0c0; border-width: 0.0909em; border-color: #c0c0c0; border-radius: 0;
    box-shadow: none; line-height: 1.8182em; white-space: nowrap; box-sizing: border-box; decorator: none;
}
.w98-toolbar button.w98-tool:hover { border-top-color: #ffffff; border-left-color: #ffffff; border-right-color: #808080; border-bottom-color: #808080; background-color: #c0c0c0; color: #000000; }
.w98-toolbar button.w98-tool:active, .w98-toolbar button.w98-tool.is-key-pressed { border-top-color: #808080; border-left-color: #808080; border-right-color: #ffffff; border-bottom-color: #ffffff; padding: 0.0909em 0.4545em 0 0.6364em; }
/* Option-set (a mode or state that is on): pressed border and a dithered face/highlight background (PDF p.322);
   with the pointer over it the face colour shows instead of the dither (PDF p.325). */
.w98-toolbar button.w98-tool.is-selected {
    border-top-color: #808080; border-left-color: #808080; border-right-color: #ffffff; border-bottom-color: #ffffff;
    padding: 0.0909em 0.4545em 0 0.6364em; decorator: image( /icons/w98-dither.tga repeat );
}
.w98-toolbar button.w98-tool.is-selected:hover { decorator: none; background-color: #c0c0c0; }
/* A menu button stays pressed while its menu is open. */
.w98-toolbar button.w98-tool.is-open, .w98-toolbar button.w98-tool.is-open:hover {
    border-top-color: #808080; border-left-color: #808080; border-right-color: #ffffff; border-bottom-color: #ffffff; padding: 0.0909em 0.4545em 0 0.6364em; decorator: none;
}
.w98-toolbar button.w98-tool[disabled], .w98-toolbar button.w98-tool[disabled]:hover, .w98-toolbar button.w98-tool[disabled]:active {
    color: #808080; font-effect: shadow( 0.0909em 0.0909em #ffffff ); border-color: #c0c0c0; padding: 0 0.5455em;
}
.w98-toolbar button.w98-tool:focus-visible { decorator: win98-focus(#000000); }
/* A button that opens a menu shows the triangular arrow after its label (PDF p.125, p.153). */
.w98-toolbar .w98-tool__caret { display: block; flex: 0 0 0.4545em; width: 0.4545em; height: 0.2727em; margin: 0 0 0 0.4545em; decorator: image( w98m-caret fill ); }
.w98-toolbar button.w98-tool[disabled] .w98-tool__caret { decorator: image( w98m-caret-disabled fill ); }
/* Toolbar separator: an etched vertical line (PDF p.153, p.320). */
.w98-toolbar .w98-toolbar__separator { display: block; flex: 0 0 0.1818em; width: 0.1818em; height: 1.8182em; margin: 0 0.3636em; border-width: 0 0.0909em 0 0; border-right-color: #ffffff; background-color: #808080; box-sizing: border-box; }

/* Drop-down menu: window border, face colour, 17 px items with a mark column; the highlighted item is navy. */
.w98-menu {
    position: absolute; display: flex; flex-direction: column; min-width: 10.9091em; padding: 0.1818em;
    background-color: #c0c0c0; z-index: 40;
    border-width: 0.0909em; border-top-color: #c0c0c0; border-left-color: #c0c0c0; border-right-color: #000000; border-bottom-color: #000000;
    box-shadow: inset 0.0909em 0.0909em 0 #ffffff, inset -0.0909em -0.0909em 0 #808080;
}
.w98-menu.is-hidden { display: none; }
.w98-menu button.w98-menu__item {
    display: flex; flex-direction: row; align-items: center; height: 1.5455em; min-height: 1.5455em; min-width: 0; margin: 0; padding: 0 1.5455em 0 0.1818em;
    color: #000000; background-color: #c0c0c0; border-width: 0; border-radius: 0; box-shadow: none; text-align: left;
    line-height: 1.5455em; white-space: nowrap; box-sizing: border-box; decorator: none;
}
.w98-menu button.w98-menu__item:hover, .w98-menu button.w98-menu__item:focus { color: #ffffff; background-color: #000080; }
.w98-menu .w98-menu__mark { display: block; flex: 0 0 1.1818em; width: 1.1818em; height: 1.1818em; margin: 0 0.1818em 0 0; }
.w98-menu .is-checked .w98-menu__mark { decorator: image( w98m-menu-check fill ); }
.w98-menu .is-checked:hover .w98-menu__mark, .w98-menu .is-checked:focus .w98-menu__mark { decorator: image( w98m-menu-check-white fill ); }
.w98-menu .is-chosen .w98-menu__mark { decorator: image( w98m-menu-dot fill ); }
.w98-menu .is-chosen:hover .w98-menu__mark, .w98-menu .is-chosen:focus .w98-menu__mark { decorator: image( w98m-menu-dot-white fill ); }
.w98-menu .w98-menu__separator { display: block; height: 0.1818em; margin: 0.2727em 0.0909em; border-width: 0.0909em 0 0 0; border-top-color: #808080; box-shadow: 0 0.0909em 0 #ffffff; }

/* Status bar: panes with the status-field border (sunken outer, PDF p.320); read-only text only. */
.w98-statusbar {
    display: flex; flex-direction: row; align-items: stretch; gap: 0.1818em; height: 2em; padding: 0.1818em 0.1818em 0.0909em 0.1818em;
    background-color: #c0c0c0; border-width: 0.0909em 0 0 0; border-top-color: #ffffff;
}
.w98-statusbar .w98-statusbar__pane {
    display: block; flex: 0 0 auto; min-width: 0; margin: 0; padding: 0 0.2727em; overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
    border-width: 0.0909em; border-top-color: #808080; border-left-color: #808080; border-right-color: #ffffff; border-bottom-color: #ffffff;
    line-height: 1.4545em; box-sizing: border-box;
}
.w98-statusbar .w98-statusbar__pane--grow { flex: 1 1 auto; }
.w98-statusbar .w98-statusbar__pane.is-hidden { display: none; }
.w98-sheet .w98-msgbox__symbol.is-info, .w98-msgbox .w98-msgbox__symbol.is-info { decorator: image( w98m-info fill ); }

/* Slider (trackbar, PDF p.146): a sunken channel and a raised rectangular thumb; no arrow buttons. */
.w98-sheet input.w98-slider { display: block; flex: 1 1 auto; min-width: 0; height: 1.9091em; margin: 0; padding: 0; background-color: transparent; border-width: 0; box-shadow: none; decorator: none; }
.w98-sheet input.w98-slider slidertrack {
    height: 0.3636em; margin-top: 0.7273em; background-color: #ffffff;
    border-width: 0.0909em; border-top-color: #808080; border-left-color: #808080; border-right-color: #ffffff; border-bottom-color: #ffffff;
    box-shadow: inset 0.0909em 0.0909em 0 #000000, inset -0.0909em -0.0909em 0 #dfdfdf; box-sizing: border-box; decorator: none;
}
.w98-sheet input.w98-slider sliderbar {
    width: 1em; height: 1.9091em; margin-top: -0.7273em; background-color: #c0c0c0;
    border-width: 0.0909em; border-top-color: #ffffff; border-left-color: #ffffff; border-right-color: #000000; border-bottom-color: #000000;
    box-shadow: inset 0.0909em 0.0909em 0 #dfdfdf, inset -0.0909em -0.0909em 0 #808080; box-sizing: border-box; decorator: none;
}
.w98-sheet input.w98-slider sliderarrowdec, .w98-sheet input.w98-slider sliderarrowinc { width: 0; height: 0; display: none; }
.w98-sheet input.w98-slider:focus-visible sliderbar { decorator: win98-focus(#000000); }

/* Access keys (PDF p.46-47, p.328): the underlined letter of a label or command. */
.w98-sheet span.w98-ak, .w98-menu span.w98-ak, .w98-toolbar span.w98-ak, .w98-msgbox span.w98-ak { text-decoration: underline; }

/* ---------------------------------------------------------------- High Contrast (Stage 20, PDF p.373-374)
   While Windows High Contrast is on, every document body carries `is-high-contrast`. The Windows 98 chrome switches to
   the High Contrast White colours: white faces, black text and one-pixel black edges, a black caption and a black
   selection with white text. Images drawn behind text (dither, gradients) are removed; the black glyphs stay readable.
   The `body.` prefix outranks the older, dark high-contrast rules in accessibility.rcss for Windows 98 controls. */
body.is-high-contrast .w98-sheet, body.is-high-contrast .w98-toolbar, body.is-high-contrast .w98-statusbar, body.is-high-contrast .w98-menu,
body.is-high-contrast .w98-tooltip, body.is-high-contrast .w98-sheet .w98-page, body.is-high-contrast .w98-sheet [role="tabpanel"] {
    color: #000000; background-color: #ffffff; border-color: #000000; box-shadow: none;
}
body.is-high-contrast .w98-caption { decorator: none; background-color: #000000; }
body.is-high-contrast .w98-caption h1, body.is-high-contrast .w98-caption h2, body.is-high-contrast .w98-caption .c-title-bar__title { color: #ffffff; background-color: #000000; }
body.is-high-contrast .w98-caption .w98-caption__close { background-color: #ffffff; color: #000000; border-color: #ffffff; box-shadow: none; }
body.is-high-contrast .w98-sheet .w98-button, body.is-high-contrast .w98-sheet .w98-tabs .c-tabs__tab, body.is-high-contrast .w98-sheet .w98-page-frame,
body.is-high-contrast .w98-sheet .w98-group, body.is-high-contrast .w98-sheet .w98-field, body.is-high-contrast .w98-sheet select.w98-select,
body.is-high-contrast .w98-sheet .w98-list, body.is-high-contrast .w98-sheet .w98-listview, body.is-high-contrast .w98-sheet .w98-grid,
body.is-high-contrast .w98-sheet .w98-listview__header > span, body.is-high-contrast .w98-sheet .w98-listview__header > button.w98-listview__heading,
body.is-high-contrast .w98-statusbar .w98-statusbar__pane, body.is-high-contrast .w98-sheet .w98-well,
body.is-high-contrast .w98-sheet input.w98-slider slidertrack, body.is-high-contrast .w98-sheet input.w98-slider sliderbar {
    color: #000000; background-color: #ffffff; border-color: #000000; box-shadow: none; decorator: none;
}
body.is-high-contrast .w98-sheet .w98-tabs .c-tabs__tab { border-width: 0.0909em 0.0909em 0 0.0909em; }
body.is-high-contrast .w98-sheet .w98-tabs .c-tabs__tab.is-selected { color: #000000; background-color: #ffffff; border-color: #000000; }
/* Check boxes and option buttons keep their black marks. */
body.is-high-contrast .w98-sheet .w98-check input.checkbox, body.is-high-contrast .w98-sheet .w98-check input.radio {
    background-color: #ffffff; border-width: 0.0909em; border-color: #000000; box-shadow: none;
}
body.is-high-contrast .w98-sheet .w98-listview__header, body.is-high-contrast .w98-sheet .w98-group__title { background-color: #ffffff; color: #000000; }
body.is-high-contrast .w98-sheet .w98-button--default { border-width: 0.1818em; }
body.is-high-contrast .w98-sheet .w98-list-item, body.is-high-contrast .w98-menu button.w98-menu__item { color: #000000; background-color: #ffffff; border-width: 0; }
body.is-high-contrast .w98-sheet .w98-list-item.is-selected, body.is-high-contrast .w98-sheet button.w98-grid__cell.is-selected,
body.is-high-contrast .w98-menu button.w98-menu__item:hover, body.is-high-contrast .w98-menu button.w98-menu__item:focus { color: #ffffff; background-color: #000000; border-width: 0; }
body.is-high-contrast .w98-toolbar button.w98-tool { color: #000000; background-color: #ffffff; border-color: #ffffff; }
body.is-high-contrast .w98-toolbar button.w98-tool:hover { border-color: #000000; }
body.is-high-contrast .w98-toolbar button.w98-tool.is-selected, body.is-high-contrast .w98-toolbar button.w98-tool.is-open { decorator: none; color: #ffffff; background-color: #000000; border-color: #000000; }
body.is-high-contrast .w98-sheet .w98-button[disabled], body.is-high-contrast .w98-toolbar button.w98-tool[disabled], body.is-high-contrast .w98-sheet .w98-check.is-disabled { color: #808080; font-effect: none; }
body.is-high-contrast .w98-sheet .l-wizard-watermark, body.is-high-contrast .w98-sheet .w98-wizard__header { decorator: none; background-color: #ffffff; }
body.is-high-contrast .w98-sheet scrollbarvertical, body.is-high-contrast .w98-sheet scrollbarhorizontal, body.is-high-contrast .w98-sheet scrollbarvertical slidertrack,
body.is-high-contrast .w98-sheet scrollbarhorizontal slidertrack { background-color: #ffffff; }
body.is-high-contrast .w98-sheet scrollbarvertical sliderbar, body.is-high-contrast .w98-sheet scrollbarhorizontal sliderbar { background-color: #ffffff; border-color: #000000; box-shadow: none; }
body.is-high-contrast .w98-sheet scrollbarvertical sliderarrowdec, body.is-high-contrast .w98-sheet scrollbarvertical sliderarrowinc,
body.is-high-contrast .w98-sheet scrollbarhorizontal sliderarrowdec, body.is-high-contrast .w98-sheet scrollbarhorizontal sliderarrowinc { background-color: #ffffff; border-color: #000000; box-shadow: none; }

/* List regions that fill a page column take only the space left over (zero basis), so a long
   list scrolls inside its field border instead of pushing the page past the sheet. */
.w98-sheet .w98-col > .w98-list.w98-grow, .w98-sheet .w98-col > .w98-listview.w98-grow { flex: 1 1 0; min-height: 0; }

/* Hidden state wins over every display rule above (kept last on purpose). */
.w98-sheet .is-hidden, .w98-sheet p.is-hidden, .w98-sheet .w98-text.is-hidden, .w98-sheet .w98-group.is-hidden, .w98-sheet .w98-line.is-hidden,
.w98-sheet .w98-listview__heading span.w98-sort-mark.is-hidden, .w98-sheet button.w98-button.is-hidden, .w98-sheet .w98-check.is-hidden,
.w98-toolbar button.w98-tool.is-hidden, .w98-menu button.w98-menu__item.is-hidden, .w98-statusbar .w98-statusbar__pane.is-hidden,
.w98-sheet .u-hidden, .w98-sheet p.u-hidden, .w98-sheet .w98-text.u-hidden, .w98-sheet .w98-col.u-hidden, .w98-sheet .w98-row.u-hidden, .w98-sheet button.u-hidden { display: none; }

/* Fixed-height rows in page columns never shrink below their line height; list boxes take the rest. */
.w98-sheet .w98-col > .w98-label, .w98-sheet .w98-col > .w98-line, .w98-sheet .w98-col > .w98-gap, .w98-sheet .w98-col > .w98-gap--wide, .w98-sheet .w98-col > .w98-text, .w98-sheet .w98-col > .w98-separator, .w98-sheet .w98-col > .w98-check, .w98-sheet .w98-group > .w98-label, .w98-sheet .w98-group > .w98-line, .w98-sheet .w98-group > .w98-gap, .w98-sheet .w98-group > .w98-gap--wide, .w98-sheet .w98-group > .w98-text, .w98-sheet .w98-group > .w98-separator, .w98-sheet .w98-group > .w98-check { flex-shrink: 0; }
