<rml>
<head><title>Ingnomia</title><link type="text/rcss" href="../styles/base.rcss"/><link type="text/rcss" href="../styles/components.rcss"/><link type="text/rcss" href="win98_classic.rcss"/><link type="text/rcss" href="hud.rcss"/><link type="text/rcss" href="../styles/accessibility.rcss"/></head>
<body id="hud_root" class="l-hud-root">
  <!-- Primary window chrome (Stage 17): one toolbar along the top and a status bar along the bottom
       (PDF p.151-155, p.288-289). Toolbar buttons are flat with text labels; a mode or state that is on
       shows the option-set appearance; a button that opens a menu shows the triangular arrow. -->
  <nav id="hud_top_rail" class="w98-toolbar l-hud-toolbar" role="toolbar" aria-label="Game">
    <div id="hud_tool_shelf" class="l-hud-toolbar-groups">
      <button id="hud_pause" class="w98-tool" aria-pressed="false"><span data-l10n="win98.hud.pause">Pause</span></button><button id="hud_speed_normal" class="w98-tool" aria-pressed="false"><span data-l10n="win98.hud.normal_speed">Normal Speed</span></button><button id="hud_speed_fast" class="w98-tool" aria-pressed="false"><span data-l10n="win98.hud.fast_speed">Fast Speed</span></button>
      <span class="w98-toolbar__separator"></span>
      <button id="hud_level_down" class="w98-tool"><span data-l10n="win98.hud.level_down">Level Down</span></button><button id="hud_level_up" class="w98-tool"><span data-l10n="win98.hud.level_up">Level Up</span></button>
      <span class="w98-toolbar__separator"></span>
      <button id="hud_open_inventory" class="w98-tool"><span data-l10n="win98.hud.inventory">Inventory</span></button><button id="hud_open_population" class="w98-tool"><span data-l10n="win98.hud.population">Population</span></button><button id="hud_open_military" class="w98-tool"><span data-l10n="win98.hud.military">Military</span></button><button id="hud_open_diplomacy" class="w98-tool"><span data-l10n="win98.hud.missions">Missions</span></button>
      <span class="w98-toolbar__separator"></span>
      <button id="hud_tool_inspect" class="w98-tool" aria-pressed="false"><span data-l10n="win98.hud.inspect">Inspect</span></button><button id="hud_tool_build" class="w98-tool"><span data-l10n="win98.hud.build">Build</span></button><button id="hud_tool_deconstruct" class="w98-tool" aria-pressed="false"><span data-l10n="win98.hud.deconstruct">Deconstruct</span></button><button id="hud_tool_mine" class="w98-tool" aria-haspopup="true" aria-expanded="false"><span data-l10n="win98.hud.mine">Mine</span><span class="w98-tool__caret"></span></button><button id="hud_tool_agriculture" class="w98-tool" aria-haspopup="true" aria-expanded="false"><span data-l10n="win98.hud.agriculture">Agriculture</span><span class="w98-tool__caret"></span></button><button id="hud_tool_designations" class="w98-tool" aria-haspopup="true" aria-expanded="false"><span data-l10n="win98.hud.designations">Designations</span><span class="w98-tool__caret"></span></button><button id="hud_tool_jobs" class="w98-tool" aria-haspopup="true" aria-expanded="false"><span data-l10n="win98.hud.jobs">Jobs</span><span class="w98-tool__caret"></span></button>
      <span class="w98-toolbar__separator"></span>
      <button id="hud_tool_cancel" class="w98-tool"><span data-l10n="win98.hud.cancel_tool">Cancel Tool</span></button><button id="hud_tool_rotate" class="w98-tool"><span data-l10n="win98.hud.rotate">Rotate</span></button>
      <span class="w98-toolbar__separator"></span>
      <button id="hud_tool_view" class="w98-tool" aria-haspopup="true" aria-expanded="false"><span data-l10n="win98.hud.view">View</span><span class="w98-tool__caret"></span></button>
    </div>
  </nav>

  <!-- Drop-down menus of the toolbar menu buttons. Choices in a group show a dot; settings show a check mark. -->
  <div id="hud_mine_menu" class="w98-menu is-hidden" role="menu" aria-label="Mine">
    <button id="hud_mine_walls" class="w98-menu__item" role="menuitemradio"><span class="w98-menu__mark"></span><span data-l10n="win98.hud.mine_walls">Mine Walls</span></button>
    <button id="hud_mine_explorative" class="w98-menu__item" role="menuitemradio"><span class="w98-menu__mark"></span><span data-l10n="win98.hud.explorative_mine">Explorative Mine</span></button>
    <button id="hud_mine_remove_floor" class="w98-menu__item" role="menuitemradio"><span class="w98-menu__mark"></span><span data-l10n="win98.hud.remove_floor">Remove Floor</span></button>
    <button id="hud_mine_hole" class="w98-menu__item" role="menuitemradio"><span class="w98-menu__mark"></span><span data-l10n="win98.hud.dig_hole">Dig Hole</span></button>
    <span class="w98-menu__separator"></span>
    <button id="hud_mine_stairs_down" class="w98-menu__item" role="menuitemradio"><span class="w98-menu__mark"></span><span data-l10n="win98.hud.dig_stairs_down">Dig Stairs Down</span></button>
    <button id="hud_mine_stairs_up" class="w98-menu__item" role="menuitemradio"><span class="w98-menu__mark"></span><span data-l10n="win98.hud.mine_stairs_up">Mine Stairs Up</span></button>
    <button id="hud_mine_ramp_down" class="w98-menu__item" role="menuitemradio"><span class="w98-menu__mark"></span><span data-l10n="win98.hud.dig_ramp_down">Dig Ramp Down</span></button>
  </div>
  <div id="hud_agriculture_menu" class="w98-menu is-hidden" role="menu" aria-label="Agriculture">
    <button id="hud_tool_fell_tree" class="w98-menu__item" role="menuitemradio"><span class="w98-menu__mark"></span><span data-l10n="win98.hud.cut_tree">Cut Tree</span></button>
    <button id="hud_tool_plant_tree" class="w98-menu__item" role="menuitemradio"><span class="w98-menu__mark"></span><span data-l10n="win98.hud.plant_tree">Plant Tree</span></button>
    <button id="hud_tool_harvest_tree" class="w98-menu__item" role="menuitemradio"><span class="w98-menu__mark"></span><span data-l10n="win98.hud.harvest_tree">Harvest Tree</span></button>
    <button id="hud_tool_forage" class="w98-menu__item" role="menuitemradio"><span class="w98-menu__mark"></span><span data-l10n="win98.hud.forage">Forage</span></button>
    <button id="hud_tool_remove_plant" class="w98-menu__item" role="menuitemradio"><span class="w98-menu__mark"></span><span data-l10n="win98.hud.remove_plant">Remove Plant</span></button>
  </div>
  <div id="hud_designations_menu" class="w98-menu is-hidden" role="menu" aria-label="Designations">
    <button id="hud_tool_stockpile" class="w98-menu__item" role="menuitemradio"><span class="w98-menu__mark"></span><span data-l10n="win98.hud.stockpile">Stockpile</span></button>
    <button id="hud_tool_farm" class="w98-menu__item" role="menuitemradio"><span class="w98-menu__mark"></span><span data-l10n="win98.hud.farm">Farm</span></button>
    <button id="hud_tool_grove" class="w98-menu__item" role="menuitemradio"><span class="w98-menu__mark"></span><span data-l10n="win98.hud.grove">Grove</span></button>
    <button id="hud_tool_pasture" class="w98-menu__item" role="menuitemradio"><span class="w98-menu__mark"></span><span data-l10n="win98.hud.pasture">Pasture</span></button>
    <span class="w98-menu__separator"></span>
    <button id="hud_tool_personal_room" class="w98-menu__item" role="menuitemradio"><span class="w98-menu__mark"></span><span data-l10n="win98.hud.personal_room">Personal Room</span></button>
    <button id="hud_tool_dormitory" class="w98-menu__item" role="menuitemradio"><span class="w98-menu__mark"></span><span data-l10n="win98.hud.dormitory">Dormitory</span></button>
    <button id="hud_tool_dining_hall" class="w98-menu__item" role="menuitemradio"><span class="w98-menu__mark"></span><span data-l10n="win98.hud.dining_hall">Dining Hall</span></button>
    <button id="hud_tool_hospital" class="w98-menu__item" role="menuitemradio"><span class="w98-menu__mark"></span><span data-l10n="win98.hud.hospital">Hospital</span></button>
    <span class="w98-menu__separator"></span>
    <button id="hud_tool_forbidden" class="w98-menu__item" role="menuitemradio"><span class="w98-menu__mark"></span><span data-l10n="win98.hud.forbidden_area">Forbidden Area</span></button>
    <button id="hud_tool_remove_designation" class="w98-menu__item" role="menuitemradio"><span class="w98-menu__mark"></span><span data-l10n="win98.hud.remove_designation">Remove Designation</span></button>
  </div>
  <div id="hud_jobs_menu" class="w98-menu is-hidden" role="menu" aria-label="Jobs">
    <button id="hud_tool_suspend_job" class="w98-menu__item" role="menuitemradio"><span class="w98-menu__mark"></span><span data-l10n="win98.hud.suspend_job">Suspend Job</span></button>
    <button id="hud_tool_resume_job" class="w98-menu__item" role="menuitemradio"><span class="w98-menu__mark"></span><span data-l10n="win98.hud.resume_job">Resume Job</span></button>
    <button id="hud_tool_cancel_job" class="w98-menu__item" role="menuitemradio"><span class="w98-menu__mark"></span><span data-l10n="win98.hud.cancel_job">Cancel Job</span></button>
    <span class="w98-menu__separator"></span>
    <button id="hud_tool_raise_priority" class="w98-menu__item" role="menuitemradio"><span class="w98-menu__mark"></span><span data-l10n="win98.hud.raise_priority">Raise Priority</span></button>
    <button id="hud_tool_lower_priority" class="w98-menu__item" role="menuitemradio"><span class="w98-menu__mark"></span><span data-l10n="win98.hud.lower_priority">Lower Priority</span></button>
  </div>
  <div id="hud_view_menu" class="w98-menu is-hidden" role="menu" aria-label="View">
    <button id="hud_overlay_designations" class="w98-menu__item" role="menuitemcheckbox" aria-checked="false"><span class="w98-menu__mark"></span><span data-l10n="win98.hud.designations">Designations</span></button>
    <button id="hud_overlay_jobs" class="w98-menu__item" role="menuitemcheckbox" aria-checked="false"><span class="w98-menu__mark"></span><span data-l10n="win98.hud.jobs">Jobs</span></button>
    <button id="hud_overlay_walls" class="w98-menu__item" role="menuitemcheckbox" aria-checked="false"><span class="w98-menu__mark"></span><span data-l10n="win98.hud.lowered_walls">Lowered Walls</span></button>
    <button id="hud_overlay_axles" class="w98-menu__item" role="menuitemcheckbox" aria-checked="false"><span class="w98-menu__mark"></span><span data-l10n="win98.hud.axles">Axles</span></button>
  </div>

  <!-- Build palette (used when no separate Build window is attached; the game opens it in its own window). -->
  <section id="hud_build_panel" class="w98-sheet w98-palette l-hud-build-panel is-hidden" role="dialog" aria-labelledby="hud_build_heading">
    <div class="w98-caption">
      <handle id="hud_build_drag_handle" class="c-title-bar__drag-handle" move_target="hud_build_panel"><h1 id="hud_build_heading" class="c-title-bar__title" data-l10n="win98.hud.build_heading">Build</h1></handle>
      <button id="hud_build_close" class="w98-caption__close" title="Close" data-l10n-title="win98.hud.build_close.title" aria-label="Close">&#x00D7;</button>
    </div>
    <div class="w98-sheet__body">
      <div class="w98-page w98-row w98-row--fill">
        <div id="hud_build_categories" class="w98-col l-hud-build-categories">
          <section id="hud_build_categories_page" class="w98-col w98-grow"><label class="w98-label" data-l10n="win98.hud.categories">Categories:</label>
            <div class="w98-list w98-grow" role="listbox" aria-label="Build categories"><button id="hud_build_furniture" class="w98-list-item" role="option"><span data-l10n="win98.hud.furniture">Furniture</span></button><button id="hud_build_workshop" class="w98-list-item" role="option"><span data-l10n="win98.hud.workshops">Workshops</span></button><button id="hud_build_containers" class="w98-list-item" role="option"><span data-l10n="win98.hud.containers">Containers</span></button><button id="hud_build_utility" class="w98-list-item" role="option"><span data-l10n="win98.hud.utility">Utility</span></button><button id="hud_build_wall" class="w98-list-item" role="option"><span data-l10n="win98.hud.walls">Walls</span></button><button id="hud_build_floor" class="w98-list-item" role="option"><span data-l10n="win98.hud.floors">Floors</span></button><button id="hud_build_stairs" class="w98-list-item" role="option"><span data-l10n="win98.hud.stairs">Stairs</span></button><button id="hud_build_ramps" class="w98-list-item" role="option"><span data-l10n="win98.hud.ramps">Ramps</span></button><button id="hud_build_fence" class="w98-list-item" role="option"><span data-l10n="win98.hud.fences">Fences</span></button></div>
          </section>
        </div>
        <div class="w98-col w98-grow">
          <p id="hud_build_hint" class="w98-text" data-l10n="win98.hud.build_hint">Choose a category, then an item to build.</p>
          <section id="hud_build_types_page" class="w98-line is-hidden"><label class="w98-label" for="hud_build_type_list" data-l10n="win98.hud.build_type_list">Material:</label><div id="hud_build_type_list" class="w98-grow l-hud-build-types"></div></section>
          <section id="hud_build_catalog" class="w98-col w98-grow is-hidden"><div class="w98-listview w98-grow"><div class="w98-listview__header"><span style="flex: 1 1 auto;" data-l10n="win98.hud.item">Item</span><span class="l-hud-build-status" data-l10n="win98.hud.status">Status</span></div><div id="hud_build_items" class="w98-list" role="listbox" aria-label="Items"></div></div><div id="hud_build_details"></div></section>
        </div>
      </div>
    </div>
  </section>

  <!-- Tutorial: a palette window beside the map (PDF p.180-181). -->
  <section id="hud_tutorial_panel" class="w98-sheet w98-palette l-hud-tutorial is-hidden" role="dialog" aria-labelledby="tutorial_title" aria-describedby="tutorial_objective">
    <div class="w98-caption"><h1 id="tutorial_title" class="c-title-bar__title"></h1></div>
    <div class="w98-sheet__body">
      <div class="w98-line"><span class="w98-label" data-l10n="win98.hud.lesson">Lesson:</span><p id="tutorial_progress" class="w98-text w98-grow"></p></div>
      <p id="tutorial_explanation" class="w98-text"></p>
      <div class="w98-gap"></div>
      <p id="tutorial_objective" class="w98-text l-hud-tutorial-objective"></p>
      <div class="w98-group"><span class="w98-group__title" data-l10n="win98.hud.do_this">Do this</span><div id="tutorial_steps" class="l-hud-tutorial-list"></div></div>
      <div class="w98-group"><span class="w98-group__title" data-l10n="win98.hud.lessons">Lessons</span><div id="tutorial_checklist" class="l-hud-tutorial-list"></div></div>
      <p id="tutorial_warning" class="w98-text"></p>
      <div class="w98-buttonbar"><button id="tutorial-continue" class="w98-button w98-button--default" data-l10n="win98.hud.tutorial_continue">Continue</button><button id="tutorial-finish" class="w98-button w98-button--default" data-l10n="win98.hud.tutorial_finish">Finish</button><button id="tutorial-skip" class="w98-button" data-l10n="win98.hud.tutorial_skip">Skip</button><button id="tutorial-restart" class="w98-button" data-l10n="win98.hud.tutorial_restart">Restart</button><button id="tutorial-hints" class="w98-button"></button></div>
    </div>
  </section>

  <!-- Events that need an answer use a message box: Information symbol, the event as the title, centred buttons. -->
  <div id="hud_event_blocker" class="l-hud-modal is-hidden" aria-hidden="true">
    <section class="w98-sheet w98-msgbox" role="alertdialog" aria-modal="true" aria-labelledby="hud_event_title" aria-describedby="hud_event_body">
      <div class="w98-caption"><h1 id="hud_event_title" class="c-title-bar__title"></h1></div>
      <div class="w98-msgbox__body"><span class="w98-msgbox__symbol is-info"></span><p id="hud_event_body" class="w98-text w98-msgbox__text"></p></div>
      <div class="w98-msgbox__buttons"><button id="hud_event_ack" class="w98-button" data-l10n="win98.common.ok">OK</button><button id="hud_event_yes" class="w98-button" data-l10n="win98.hud.event_yes">Yes</button><button id="hud_event_no" class="w98-button" data-l10n="win98.hud.event_no">No</button></div>
    </section>
  </div>

  <footer id="hud_status_bar" class="w98-statusbar l-hud-statusbar" role="status">
    <p id="hud_status" class="w98-statusbar__pane w98-statusbar__pane--grow"></p>
    <span id="hud_active_tool" class="w98-statusbar__pane is-hidden"></span>
    <span id="hud_kingdom" class="w98-statusbar__pane"></span>
    <span id="hud_level" class="w98-statusbar__pane"></span>
    <span id="hud_date" class="w98-statusbar__pane"></span>
    <span id="hud_clock" class="w98-statusbar__pane"></span>
    <span id="hud_daylight" class="w98-statusbar__pane"></span>
    <span id="hud_gnomes" class="w98-statusbar__pane"></span>
    <span id="hud_animals" class="w98-statusbar__pane"></span>
    <span id="hud_items" class="w98-statusbar__pane"></span>
    <div id="hud_watch_rows" class="l-hud-watch"></div>
  </footer>
</body></rml>
