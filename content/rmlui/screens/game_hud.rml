<rml>
<head><link type="text/rcss" href="../styles/base.rcss"/><link type="text/rcss" href="../styles/components.rcss"/><link type="text/rcss" href="../styles/accessibility.rcss"/><link type="text/rcss" href="hud.rcss"/></head>
<body id="hud_root" class="l-hud-root">
  <header id="hud_top_rail" class="l-hud-top">
    <section class="l-hud-z-controls"><button id="hud_level_down" class="c-button">Z-</button><span id="hud_level" data-l10n="hud.static.hud_level">Z 0</span><button id="hud_level_up" class="c-button">Z+</button></section>
    <section class="l-hud-center"><strong class="l-hud-world-name" id="hud_kingdom" data-l10n="hud.static.hud_kingdom">Kingdom</strong><span class="l-hud-controls"><button id="hud_pause" class="c-button" aria-pressed="false" data-l10n="hud.pause">Pause</button><button id="hud_speed_normal" class="c-button" aria-pressed="false" data-l10n="hud.speed.normal">Normal</button><button id="hud_speed_fast" class="c-button" aria-pressed="false" data-l10n="hud.speed.fast">Fast</button></span></section>
    <section class="l-hud-summary"><span id="hud_gnomes" data-l10n="hud.static.hud_gnomes">Gnomes 0</span><span id="hud_animals" data-l10n="hud.static.hud_animals">Animals 0</span><span id="hud_items" data-l10n="hud.static.hud_items">Items 0</span><span id="hud_clock">00:00</span><span id="hud_date" data-l10n="hud.static.hud_date">Day 0</span><span id="hud_daylight" data-l10n="hud.static.hud_daylight">Night</span></section>
    <section id="hud_watch_rows" class="l-hud-watch"></section>
  </header>
  <div id="hud_sidebar_edge" class="l-hud-sidebar-edge" aria-hidden="true"><span class="c-hud-sidebar-notch-mark"></span></div>
  <div class="l-hud-sidebar-center">
  <nav id="hud_tool_shelf" class="l-hud-tools l-hud-sidebar">
    <section id="hud_sidebar_root" class="l-hud-sidebar-page l-hud-sidebar-root">
      <div class="c-hud-shelf-heading" data-l10n="hud.shelf.management">Management</div>
      <button id="hud_open_inventory" class="c-button" title="Open inventory and resources" data-l10n="hud.launch.inventory">Inventory</button><button id="hud_open_military" class="c-button" title="Manage squads, roles, uniforms, and target priorities" data-l10n="hud.launch.military">Military</button><button id="hud_open_population" class="c-button" title="View gnomes, work assignments, and schedules" data-l10n="hud.launch.population">Population</button><button id="hud_open_diplomacy" class="c-button" title="View neighbors and current missions" data-l10n="hud.launch.missions">Missions</button>
      <div class="c-hud-shelf-heading" data-l10n="hud.shelf.orders">Orders &amp; tools</div>
      <button id="hud_tool_build" class="c-button" title="Choose and place construction, furniture, and workshops" data-l10n="hud.tool.build">Build</button><button id="hud_tool_deconstruct" class="c-button" title="Remove a constructed object or terrain piece" data-l10n="hud.build.deconstruct">Deconstruct</button><button id="hud_tool_mine" class="c-button" title="Choose mining and excavation orders" data-l10n="hud.tool.mine">Mine</button><button id="hud_tool_agriculture" class="c-button" title="Cut, plant, harvest, forage, and remove plants" data-l10n="hud.tool.agriculture">Agriculture</button><button id="hud_tool_designations" class="c-button" title="Mark stockpiles, farms, rooms, zones, and other areas" data-l10n="hud.tool.designations">Designations</button><button id="hud_tool_jobs" class="c-button" title="Suspend, resume, cancel, or reprioritize jobs" data-l10n="hud.tool.jobs">Jobs</button>
      <button id="hud_tool_inspect" class="c-button" aria-pressed="false" title="Click a tile to inspect its contents and actions. Right-click or Escape to exit." data-l10n="hud.tool.inspection">Inspect</button>
    <div class="c-hud-shelf-heading" data-l10n="hud.shelf.overlays">Map overlays</div>
      <button id="hud_overlay_designations" class="c-button" aria-pressed="false" title="Show or hide designation markers" data-l10n="hud.overlay.designations">Designations</button><button id="hud_overlay_jobs" class="c-button" aria-pressed="false" title="Show or hide job markers" data-l10n="hud.overlay.jobs">Jobs</button><button id="hud_overlay_walls" class="c-button" aria-pressed="false" title="Show lower wall faces for easier map viewing" data-l10n="hud.overlay.walls">Walls</button><button id="hud_overlay_axles" class="c-button" aria-pressed="false" title="Show powered mechanical axles and other mechanism overlays" data-l10n="hud.overlay.axles">Mechanics</button>
    </section>
    <section id="hud_mine_menu" class="l-hud-sidebar-page l-hud-sidebar-action-menu is-hidden" aria-labelledby="hud_mine_heading">
      <h2 id="hud_mine_heading" class="c-hud-sidebar-page-title" data-l10n="hud.mine_menu.title">Mining orders</h2>
      <div class="l-hud-sidebar-actions"><p data-l10n="hud.mine_menu.help">Choose what the miners should prepare.</p><button id="hud_mine_walls" class="c-button" data-l10n="hud.mine_menu.walls">Mine walls</button><button id="hud_mine_explorative" class="c-button" data-l10n="hud.mine_menu.explorative">Explorative mine</button><button id="hud_mine_remove_floor" class="c-button" data-l10n="hud.mine_menu.remove_floor">Remove floor</button><button id="hud_mine_hole" class="c-button" data-l10n="hud.mine_menu.hole">Dig hole</button><button id="hud_mine_stairs_down" class="c-button" data-l10n="hud.mine_menu.stairs_down">Stairs down</button><button id="hud_mine_stairs_up" class="c-button" data-l10n="hud.mine_menu.stairs_up">Stairs up</button><button id="hud_mine_ramp_down" class="c-button" data-l10n="hud.mine_menu.ramp_down">Ramp down</button></div>
      <button id="hud_mine_back" class="c-button c-hud-sidebar-back" data-l10n="common.back">Back</button>
    </section>
    <section id="hud_agriculture_menu" class="l-hud-sidebar-page l-hud-sidebar-action-menu is-hidden" aria-labelledby="hud_agriculture_heading">
      <h2 id="hud_agriculture_heading" class="c-hud-sidebar-page-title" data-l10n="hud.tool.agriculture">Agriculture</h2>
      <div class="l-hud-sidebar-actions"><p data-l10n="hud.agriculture.help">Manage trees, plants, and wild food.</p><button id="hud_tool_fell_tree" class="c-button" data-l10n="hud.agriculture.cut_tree">Cut tree</button><button id="hud_tool_plant_tree" class="c-button" data-l10n="hud.agriculture.plant_tree">Plant tree</button><button id="hud_tool_harvest_tree" class="c-button" data-l10n="hud.agriculture.harvest_tree">Harvest tree</button><button id="hud_tool_forage" class="c-button" data-l10n="hud.agriculture.forage">Forage</button><button id="hud_tool_remove_plant" class="c-button" data-l10n="hud.agriculture.remove_plant">Remove plant</button></div>
      <button id="hud_agriculture_back" class="c-button c-hud-sidebar-back" data-l10n="common.back">Back</button>
    </section>
    <section id="hud_designations_menu" class="l-hud-sidebar-page l-hud-sidebar-action-menu is-hidden" aria-labelledby="hud_designations_heading">
      <h2 id="hud_designations_heading" class="c-hud-sidebar-page-title" data-l10n="hud.tool.designations">Designations</h2>
      <div class="l-hud-sidebar-actions"><p data-l10n="hud.designations.help">Mark areas for settlement and control.</p><button id="hud_tool_stockpile" class="c-button" data-l10n="hud.designations.stockpile">Stockpile</button><button id="hud_tool_farm" class="c-button" data-l10n="hud.designations.farm">Farm</button><button id="hud_tool_grove" class="c-button" data-l10n="hud.designations.grove">Grove</button><button id="hud_tool_pasture" class="c-button" data-l10n="hud.designations.pasture">Pasture</button><button id="hud_tool_personal_room" class="c-button" data-l10n="hud.designations.personal_room">Personal room</button><button id="hud_tool_dormitory" class="c-button" data-l10n="hud.designations.dormitory">Dormitory</button><button id="hud_tool_dining_hall" class="c-button" data-l10n="hud.designations.dining_hall">Dining hall</button><button id="hud_tool_hospital" class="c-button" data-l10n="hud.designations.hospital">Hospital</button><button id="hud_tool_forbidden" class="c-button" data-l10n="hud.designations.forbidden">Forbidden</button><button id="hud_tool_remove_designation" class="c-button" data-l10n="hud.designations.remove">Remove</button></div>
      <button id="hud_designations_back" class="c-button c-hud-sidebar-back" data-l10n="common.back">Back</button>
    </section>
    <section id="hud_jobs_menu" class="l-hud-sidebar-page l-hud-sidebar-action-menu is-hidden" aria-labelledby="hud_jobs_heading">
      <h2 id="hud_jobs_heading" class="c-hud-sidebar-page-title" data-l10n="hud.jobs.title">Job commands</h2>
      <div class="l-hud-sidebar-actions"><p data-l10n="hud.jobs.help">Choose a command, then click a job on the map.</p><p class="c-hud-action-note" data-l10n="hud.jobs.action_help">Suspend or resume work, cancel an order, or change its queue priority.</p><p class="c-hud-action-note" data-l10n="hud.jobs.overlay_note">Use the sidebar Jobs control to show or hide job markers.</p><button id="hud_tool_suspend_job" class="c-button" data-l10n="hud.jobs.suspend">Suspend</button><button id="hud_tool_resume_job" class="c-button" data-l10n="hud.jobs.resume">Resume</button><button id="hud_tool_cancel_job" class="c-button" data-l10n="hud.jobs.cancel">Cancel</button><button id="hud_tool_lower_priority" class="c-button" data-l10n="hud.jobs.lower_priority">Lower priority</button><button id="hud_tool_raise_priority" class="c-button" data-l10n="hud.jobs.raise_priority">Raise priority</button></div>
      <button id="hud_jobs_back" class="c-button c-hud-sidebar-back" data-l10n="common.back">Back</button>
    </section>
  </nav>
  </div>
  <div id="hud_sidebar_tooltip" class="c-tooltip" role="tooltip" aria-hidden="true"></div>
  <section id="hud_kingdom_panel" class="l-hud-kingdom-panel is-hidden" role="dialog" aria-labelledby="hud_kingdom_heading">
    <header class="c-title-bar"><handle id="hud_kingdom_drag_handle" class="c-title-bar__drag-handle" move_target="hud_kingdom_panel" edge_margin="52dp 12dp 54dp 12dp"><div class="c-title-bar__mark c-title-bar__mark--kingdom">K</div><h1 id="hud_kingdom_heading" class="c-title-bar__title" data-l10n="hud.launch.kingdom">Kingdom</h1></handle><button id="hud_kingdom_close" class="c-button c-button--compact" data-l10n="common.close">Close</button></header>
    <div class="c-hud-kingdom-summary"><strong id="hud_kingdom_panel_name">Kingdom</strong><p data-l10n="hud.launch.kingdom_help">Quick view of this settlement's population, animals, and stored items.</p><span id="hud_kingdom_panel_gnomes">Gnomes 0</span><span id="hud_kingdom_panel_animals">Animals 0</span><span id="hud_kingdom_panel_items">Items 0</span></div>
  </section>
  <section id="hud_build_panel" class="l-hud-build-panel">
    <header class="c-title-bar"><handle id="hud_build_drag_handle" class="c-title-bar__drag-handle" move_target="hud_build_panel" edge_margin="52dp 12dp 54dp 12dp"><div class="c-title-bar__mark c-title-bar__mark--build">B</div><h1 id="hud_build_heading" class="c-title-bar__title" tab-index="-1" data-l10n="hud.build.title">Build</h1></handle><button id="hud_build_close" class="c-button" data-l10n="common.close">Close</button></header>
    <div class="l-hud-build-workbench">
      <aside id="hud_build_categories" class="l-hud-build-rail">
        <section id="hud_build_categories_page" class="l-hud-build-rail-page"><div class="c-hud-build-rail-heading" data-l10n="hud.build.categories">Categories</div><p class="c-hud-build-category-hint" data-l10n="hud.build.category_hint">Choose a category</p><nav class="l-hud-build-category-list" aria-label="Build categories"><button id="hud_build_furniture" class="c-button c-hud-build-tab" data-l10n="hud.build.furniture">Furniture</button><button id="hud_build_workshop" class="c-button c-hud-build-tab" data-l10n="hud.build.workshop">Workshops</button><button id="hud_build_containers" class="c-button c-hud-build-tab" data-l10n="hud.build.containers">Containers</button><button id="hud_build_utility" class="c-button c-hud-build-tab" data-l10n="hud.build.utility">Utility</button><button id="hud_build_wall" class="c-button c-hud-build-tab" data-l10n="hud.build.wall">Walls</button><button id="hud_build_floor" class="c-button c-hud-build-tab" data-l10n="hud.build.floor">Floors</button><button id="hud_build_stairs" class="c-button c-hud-build-tab" data-l10n="hud.build.stairs">Stairs</button><button id="hud_build_ramps" class="c-button c-hud-build-tab" data-l10n="hud.build.ramps">Ramps</button><button id="hud_build_fence" class="c-button c-hud-build-tab" data-l10n="hud.build.fence">Fences</button></nav></section>
        <section id="hud_build_types_page" class="l-hud-build-rail-page is-hidden"><div class="c-hud-build-rail-heading" data-l10n="hud.build.types">Types</div><div id="hud_build_type_list" class="l-hud-build-type-list"></div><button id="hud_build_back" class="c-button c-hud-build-back" data-l10n="common.back">Back</button></section>
      </aside>
      <section id="hud_build_catalog" class="l-hud-build is-hidden"></section>
    </div>
  </section>
  <div id="hud_hint_strip" class="is-hidden" aria-hidden="true"><span id="hud_active_tool" data-l10n="hud.static.hud_active_tool">Inspect</span><span id="hud_status" class="c-hud-status is-hidden"></span><span data-l10n="hud.hint.select">LMB select / drag</span><span data-l10n="hud.hint.cancel">RMB/Esc cancel</span><span id="hud_rotate_hint"></span><span id="hud_keyboard_commands" class="l-hud-keyboard-commands is-hidden" aria-hidden="true"><button id="hud_tool_cancel" class="c-button" data-l10n="hud.tool.cancel">Cancel</button><button id="hud_tool_rotate" class="c-button" data-l10n="hud.tool.rotate">Rotate</button></span></div>
  <section id="hud_tutorial_panel" class="l-hud-tutorial is-hidden" role="dialog" aria-labelledby="tutorial_title" aria-describedby="tutorial_objective">
    <header class="c-title-bar"><h2 id="tutorial_title">Interactive tutorial</h2><span id="tutorial_progress">1 / 9</span></header>
    <p id="tutorial_explanation"></p><p id="tutorial_objective" class="c-hud-tutorial-objective"></p><h3 class="c-hud-tutorial-steps-heading" data-l10n="tutorial.steps_heading">Do this</h3><p id="tutorial_steps" class="c-hud-tutorial-steps"></p><p id="tutorial_checklist" class="c-hud-tutorial-checklist"></p><p id="tutorial_warning" class="c-hud-tutorial-warning"></p>
    <div class="l-hud-tutorial-actions"><button id="tutorial-continue" class="c-button c-button--primary" data-l10n="tutorial.action.continue">Continue</button><button id="tutorial-skip" class="c-button" data-l10n="tutorial.action.skip">Skip</button><button id="tutorial-restart" class="c-button" data-l10n="tutorial.action.restart">Restart</button><button id="tutorial-hints" class="c-button" data-l10n="tutorial.action.hints">Hints</button><button id="tutorial-finish" class="c-button c-button--primary" data-l10n="tutorial.action.finish">Continue anyway</button></div>
  </section>
  <div id="hud_event_blocker" class="l-hud-modal is-hidden" aria-hidden="true">
    <article class="c-modal" role="dialog" aria-modal="true" aria-labelledby="hud_event_title" aria-describedby="hud_event_body"><h2 id="hud_event_title"></h2><p id="hud_event_body"></p><div><button id="hud_event_ack" class="c-button" data-l10n="hud.event.continue">Continue</button><button id="hud_event_yes" class="c-button" data-l10n="common.yes_title">Yes</button><button id="hud_event_no" class="c-button" data-l10n="common.no_title">No</button></div></article>
  </div>
</body></rml>
