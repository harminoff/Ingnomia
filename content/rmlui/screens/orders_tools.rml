<rml>
<head><title>Build</title><link type="text/rcss" href="../styles/base.rcss"/><link type="text/rcss" href="../styles/components.rcss"/><link type="text/rcss" href="win98_classic.rcss"/><link type="text/rcss" href="hud.rcss"/><link type="text/rcss" href="../styles/accessibility.rcss"/></head>
<body id="hud_root" class="l-hud-root l-hud-tool-window-root">
  <!-- The Build window (Stage 17): a palette window (PDF p.180-181) that fills its own native window. Choosing an
       item and pressing Build arms the build tool on the map; the game window's toolbar and status bar show the mode. -->
  <section id="hud_build_panel" class="w98-sheet w98-palette l-hud-build-panel" role="dialog" aria-labelledby="hud_build_heading">
    <div class="w98-caption">
      <handle id="hud_build_drag_handle" class="c-title-bar__drag-handle" move_target="hud_build_panel"><h1 id="hud_build_heading" class="c-title-bar__title" data-l10n="win98.build.build_heading">Build</h1></handle>
      <button id="hud_build_close" class="w98-caption__close" title="Close" data-l10n-title="win98.build.build_close.title" aria-label="Close"><span class="w98-caption__glyph w98-caption__glyph--close"></span></button>
    </div>
    <div class="w98-sheet__body">
      <div class="w98-page w98-row w98-row--fill">
        <div id="hud_build_categories" class="w98-col l-hud-build-categories">
          <section id="hud_build_categories_page" class="w98-col w98-grow"><label class="w98-label" data-l10n="win98.build.categories">Categories:</label>
            <div class="w98-list w98-grow" role="listbox" aria-label="Build categories"><button id="hud_build_furniture" class="w98-list-item" role="option"><span data-l10n="win98.build.furniture">Furniture</span></button><button id="hud_build_workshop" class="w98-list-item" role="option"><span data-l10n="win98.build.workshops">Workshops</span></button><button id="hud_build_containers" class="w98-list-item" role="option"><span data-l10n="win98.build.containers">Containers</span></button><button id="hud_build_utility" class="w98-list-item" role="option"><span data-l10n="win98.build.utility">Utility</span></button><button id="hud_build_wall" class="w98-list-item" role="option"><span data-l10n="win98.build.walls">Walls</span></button><button id="hud_build_floor" class="w98-list-item" role="option"><span data-l10n="win98.build.floors">Floors</span></button><button id="hud_build_stairs" class="w98-list-item" role="option"><span data-l10n="win98.build.stairs">Stairs</span></button><button id="hud_build_ramps" class="w98-list-item" role="option"><span data-l10n="win98.build.ramps">Ramps</span></button><button id="hud_build_fence" class="w98-list-item" role="option"><span data-l10n="win98.build.fences">Fences</span></button></div>
          </section>
        </div>
        <div class="w98-col w98-grow">
          <p id="hud_build_hint" class="w98-text" data-l10n="win98.build.build_hint">Choose a category, then an item to build.</p>
          <section id="hud_build_types_page" class="w98-line is-hidden"><label class="w98-label" for="hud_build_type_list" data-l10n="win98.build.build_type_list">Material:</label><div id="hud_build_type_list" class="w98-grow l-hud-build-types"></div></section>
          <section id="hud_build_catalog" class="w98-col w98-grow is-hidden"><div class="w98-listview w98-grow"><div class="w98-listview__header"><span style="flex: 1 1 auto;" data-l10n="win98.build.item">Item</span><span class="l-hud-build-status" data-l10n="win98.build.status">Status</span></div><div id="hud_build_items" class="w98-list" role="listbox" aria-label="Items"></div></div><div id="hud_build_details"></div></section>
        </div>
      </div>
    </div>
  </section>
</body>
</rml>
