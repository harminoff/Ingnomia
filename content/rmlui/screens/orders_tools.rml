<rml>
<head><link type="text/rcss" href="../styles/base.rcss"/><link type="text/rcss" href="../styles/components.rcss"/><link type="text/rcss" href="../styles/accessibility.rcss"/><link type="text/rcss" href="hud.rcss"/><link type="text/rcss" href="orders_tools.rcss"/></head>
<body id="hud_root" class="l-hud-orders-tools-root l-hud-tool-window-root">
  <section id="hud_orders_tools_panel" class="l-hud-orders-tools-panel" role="dialog" aria-labelledby="hud_orders_tools_heading">
    <header id="hud_orders_tools_header" class="c-title-bar"><handle id="hud_orders_tools_drag_handle" class="c-title-bar__drag-handle"><div class="c-title-bar__mark c-title-bar__mark--orders" aria-hidden="true"></div><h1 id="hud_orders_tools_heading" class="c-title-bar__title" data-l10n="hud.shelf.orders">Orders &amp; tools</h1></handle><button id="hud_tools_close" class="c-button c-button--compact" data-l10n="common.close">Close</button></header>
    <nav id="hud_tool_shelf" class="l-hud-tools l-hud-orders-tools-shelf">
      <div class="c-hud-shelf-heading" data-l10n="hud.shelf.orders">Orders &amp; tools</div>
      <button id="hud_tool_build" class="c-button" title="Choose and place construction, furniture, and workshops" data-l10n="hud.tool.build">Build</button><button id="hud_tool_deconstruct" class="c-button" title="Remove a constructed object or terrain piece" data-l10n="hud.build.deconstruct">Deconstruct</button><button id="hud_tool_mine" class="c-button" title="Choose mining and excavation orders" data-l10n="hud.tool.mine">Mine</button><button id="hud_tool_agriculture" class="c-button" title="Cut, plant, harvest, forage, and remove plants" data-l10n="hud.tool.agriculture">Agriculture</button><button id="hud_tool_designations" class="c-button" title="Mark stockpiles, farms, rooms, zones, and other areas" data-l10n="hud.tool.designations">Designations</button><button id="hud_tool_jobs" class="c-button" title="Suspend, resume, cancel, or reprioritize jobs" data-l10n="hud.tool.jobs">Jobs</button>
    </nav>
    <footer id="hud_hint_strip" class="l-hud-hints"><span id="hud_active_tool" data-l10n="hud.static.hud_active_tool">Inspect</span><span id="hud_status" class="c-hud-status is-hidden"></span><button id="hud_tool_cancel" class="c-button" data-l10n="hud.tool.cancel">Cancel</button><button id="hud_tool_rotate" class="c-button" data-l10n="hud.tool.rotate">Rotate</button><span id="hud_rotate_hint"></span></footer>
    <section id="hud_mine_menu" class="l-hud-mine-menu is-hidden">
      <header class="c-title-bar"><handle id="hud_mine_drag_handle" class="c-title-bar__drag-handle"><div class="c-title-bar__mark c-title-bar__mark--mine" aria-hidden="true"></div><h1 id="hud_mine_heading" class="c-title-bar__title" tab-index="-1" data-l10n="hud.mine_menu.title">Mining orders</h1></handle><button id="hud_mine_close" class="c-button c-button--compact" data-l10n="common.close">Close</button></header>
      <p data-l10n="hud.mine_menu.help">Choose what the miners should prepare.</p>
      <button id="hud_mine_walls" class="c-button" data-l10n="hud.mine_menu.walls">Mine walls</button><button id="hud_mine_explorative" class="c-button" data-l10n="hud.mine_menu.explorative">Explorative mine</button><button id="hud_mine_remove_floor" class="c-button" data-l10n="hud.mine_menu.remove_floor">Remove floor</button><button id="hud_mine_hole" class="c-button" data-l10n="hud.mine_menu.hole">Dig hole</button><button id="hud_mine_stairs_down" class="c-button" data-l10n="hud.mine_menu.stairs_down">Stairs down</button><button id="hud_mine_stairs_up" class="c-button" data-l10n="hud.mine_menu.stairs_up">Stairs up</button><button id="hud_mine_ramp_down" class="c-button" data-l10n="hud.mine_menu.ramp_down">Ramp down</button>
    </section>
    <section id="hud_agriculture_menu" class="l-hud-action-menu l-hud-agriculture-menu is-hidden" role="dialog" aria-labelledby="hud_agriculture_heading">
      <header class="c-title-bar"><handle id="hud_agriculture_drag_handle" class="c-title-bar__drag-handle"><div class="c-title-bar__mark c-title-bar__mark--agriculture" aria-hidden="true"></div><h1 id="hud_agriculture_heading" class="c-title-bar__title" data-l10n="hud.tool.agriculture">Agriculture</h1></handle><button id="hud_agriculture_close" class="c-button c-button--compact" data-l10n="common.close">Close</button></header>
      <p data-l10n="hud.agriculture.help">Manage trees, plants, and wild food.</p><button id="hud_tool_fell_tree" class="c-button" data-l10n="hud.agriculture.cut_tree">Cut tree</button><button id="hud_tool_plant_tree" class="c-button" data-l10n="hud.agriculture.plant_tree">Plant tree</button><button id="hud_tool_harvest_tree" class="c-button" data-l10n="hud.agriculture.harvest_tree">Harvest tree</button><button id="hud_tool_forage" class="c-button" data-l10n="hud.agriculture.forage">Forage</button><button id="hud_tool_remove_plant" class="c-button" data-l10n="hud.agriculture.remove_plant">Remove plant</button>
    </section>
    <section id="hud_designations_menu" class="l-hud-action-menu l-hud-designations-menu is-hidden" role="dialog" aria-labelledby="hud_designations_heading">
      <header class="c-title-bar"><handle id="hud_designations_drag_handle" class="c-title-bar__drag-handle"><div class="c-title-bar__mark c-title-bar__mark--designations" aria-hidden="true"></div><h1 id="hud_designations_heading" class="c-title-bar__title" data-l10n="hud.tool.designations">Designations</h1></handle><button id="hud_designations_close" class="c-button c-button--compact" data-l10n="common.close">Close</button></header>
      <p data-l10n="hud.designations.help">Mark areas for settlement and control.</p><button id="hud_tool_stockpile" class="c-button" data-l10n="hud.designations.stockpile">Stockpile</button><button id="hud_tool_farm" class="c-button" data-l10n="hud.designations.farm">Farm</button><button id="hud_tool_grove" class="c-button" data-l10n="hud.designations.grove">Grove</button><button id="hud_tool_pasture" class="c-button" data-l10n="hud.designations.pasture">Pasture</button><button id="hud_tool_personal_room" class="c-button" data-l10n="hud.designations.personal_room">Personal room</button><button id="hud_tool_dormitory" class="c-button" data-l10n="hud.designations.dormitory">Dormitory</button><button id="hud_tool_dining_hall" class="c-button" data-l10n="hud.designations.dining_hall">Dining hall</button><button id="hud_tool_hospital" class="c-button" data-l10n="hud.designations.hospital">Hospital</button><button id="hud_tool_forbidden" class="c-button" data-l10n="hud.designations.forbidden">Forbidden</button><button id="hud_tool_remove_designation" class="c-button" data-l10n="hud.designations.remove">Remove</button>
    </section>
    <section id="hud_jobs_menu" class="l-hud-action-menu l-hud-jobs-menu is-hidden" role="dialog" aria-labelledby="hud_jobs_heading">
      <header class="c-title-bar"><handle id="hud_jobs_drag_handle" class="c-title-bar__drag-handle"><div class="c-title-bar__mark c-title-bar__mark--jobs" aria-hidden="true"></div><h1 id="hud_jobs_heading" class="c-title-bar__title" data-l10n="hud.jobs.title">Job commands</h1></handle><button id="hud_jobs_close" class="c-button c-button--compact" data-l10n="common.close">Close</button></header>
      <p data-l10n="hud.jobs.help">Choose a command, then click a job on the map.</p><p class="c-hud-action-note" data-l10n="hud.jobs.action_help">Suspend or resume work, cancel an order, or change its queue priority.</p><p class="c-hud-action-note" data-l10n="hud.jobs.overlay_note">Use the sidebar Jobs control to show or hide job markers.</p><button id="hud_tool_suspend_job" class="c-button" data-l10n="hud.jobs.suspend">Suspend</button><button id="hud_tool_resume_job" class="c-button" data-l10n="hud.jobs.resume">Resume</button><button id="hud_tool_cancel_job" class="c-button" data-l10n="hud.jobs.cancel">Cancel</button><button id="hud_tool_lower_priority" class="c-button" data-l10n="hud.jobs.lower_priority">Lower priority</button><button id="hud_tool_raise_priority" class="c-button" data-l10n="hud.jobs.raise_priority">Raise priority</button>
    </section>
    <section id="hud_build_panel" class="l-hud-build-panel">
      <header class="c-title-bar"><handle id="hud_build_drag_handle" class="c-title-bar__drag-handle"><div class="c-title-bar__mark c-title-bar__mark--build" aria-hidden="true"></div><h1 id="hud_build_heading" class="c-title-bar__title" tab-index="-1" data-l10n="hud.build.title">Build</h1></handle><button id="hud_build_close" class="c-button" data-l10n="common.close">Close</button></header>
      <div class="l-hud-build-workbench">
        <aside id="hud_build_categories" class="l-hud-build-rail">
          <section id="hud_build_categories_page" class="l-hud-build-rail-page"><div class="c-hud-build-rail-heading" data-l10n="hud.build.categories">Categories</div><p class="c-hud-build-category-hint" data-l10n="hud.build.category_hint">Choose a category</p><nav class="l-hud-build-category-list" aria-label="Build categories"><button id="hud_build_furniture" class="c-button c-hud-build-tab" data-l10n="hud.build.furniture">Furniture</button><button id="hud_build_workshop" class="c-button c-hud-build-tab" data-l10n="hud.build.workshop">Workshops</button><button id="hud_build_containers" class="c-button c-hud-build-tab" data-l10n="hud.build.containers">Containers</button><button id="hud_build_utility" class="c-button c-hud-build-tab" data-l10n="hud.build.utility">Utility</button><button id="hud_build_wall" class="c-button c-hud-build-tab" data-l10n="hud.build.wall">Walls</button><button id="hud_build_floor" class="c-button c-hud-build-tab" data-l10n="hud.build.floor">Floors</button><button id="hud_build_stairs" class="c-button c-hud-build-tab" data-l10n="hud.build.stairs">Stairs</button><button id="hud_build_ramps" class="c-button c-hud-build-tab" data-l10n="hud.build.ramps">Ramps</button><button id="hud_build_fence" class="c-button c-hud-build-tab" data-l10n="hud.build.fence">Fences</button></nav></section>
          <section id="hud_build_types_page" class="l-hud-build-rail-page is-hidden"><div class="c-hud-build-rail-heading" data-l10n="hud.build.types">Types</div><div id="hud_build_type_list" class="l-hud-build-type-list"></div><button id="hud_build_back" class="c-button c-hud-build-back" data-l10n="common.back">Back</button></section>
        </aside>
        <section id="hud_build_catalog" class="l-hud-build is-hidden"></section>
      </div>
    </section>
  </section>
</body>
</rml>
