/* Property inspectors (Stage 16): Windows 98 palette windows drawn with win98_classic.rcss.
   Each inspector is 384 x 380 px at 1x, written in em of the snapped 11/22/33 px system font
   (384 / 11 = 34.9091em, 380 / 11 = 34.5455em), so it lands on whole pixels at every scale.
   In a detached native window the inspector fills the client area, which MainWindow sizes to match. */
.l-inspector-root { position: absolute; left: 0; top: 0; width: 100%; height: 100%; pointer-events: none; }
.is-hidden { display: none; }

.l-inspector-panel,
.l-creature-preview {
    position: absolute;
    display: flex;
    flex-direction: column;
    width: 34.9091em;
    height: 34.5455em;
    pointer-events: auto;
    z-index: 30;
}
.l-inspector-panel { right: 12dp; top: 76dp; }
.l-creature-preview { right: 16dp; bottom: 62dp; }
.l-inspector-panel.is-detached,
.l-creature-preview.is-detached { left: 0; top: 0; right: auto; bottom: auto; width: 100%; height: 100%; }
.l-inspector-panel.is-hidden, .l-creature-preview.is-hidden { display: none; }

/* The picture well takes the space above the General page's property lines. */
.w98-sheet .c-creature-preview-camera { flex: 1 1 0; min-height: 0; }

/* The Attributes and Needs group boxes share the page width equally. */
.w98-sheet .c-inspector-half { flex: 1 1 0; }

/* ToolTips that follow the pointer over the map. */
.c-tile-world-label,
.c-selection-pointer-tip { position: absolute; left: 0; top: 0; display: flex; flex-direction: column; pointer-events: none; z-index: 20; }
.c-tile-world-label.is-hidden, .c-selection-pointer-tip.is-hidden { display: none; }
