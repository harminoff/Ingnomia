<rml>
<head>
    <title data-l10n="shell.settings.settings">Settings</title>
    <link type="text/rcss" href="/styles/base.rcss" /><link type="text/rcss" href="/styles/components.rcss" /><link type="text/rcss" href="/styles/accessibility.rcss" /><link type="text/rcss" href="/screens/shell.rcss" />
</head>
<body class="l-shell-screen l-shell-screen--centered">
    <main class="c-shell-chamber">
        <header class="c-shell-title-row"><h1 data-l10n="shell.settings.settings">Settings</h1><button id="shell-back" data-l10n="shell.settings.shell-back">Back</button></header>
        <section id="settings-loading" class="c-state-panel u-hidden"><div class="c-state-panel__title" data-l10n="shell.settings.loading_settings">Loading settings</div></section>
        <section id="settings-supported">
            <h2 data-l10n="shell.settings.display">Display</h2>
            <label class="c-shell-setting-row"><span class="c-shell-setting-copy"><span class="c-shell-setting-label" data-l10n="shell.settings.fullscreen">Fullscreen</span><span class="c-shell-setting-detail" data-l10n="shell.settings.use_the_entire_display">Use the entire display.</span></span><input id="setting-fullscreen" class="checkbox" type="checkbox" /></label>
            <label class="c-shell-setting-row"><span class="c-shell-setting-copy"><span class="c-shell-setting-label" data-l10n="shell.settings.follow_monitor_refresh">Follow monitor refresh</span><span class="c-shell-setting-detail" data-l10n="shell.settings.match_the_active_monitor_refresh_rate">Match the active monitor's refresh rate while playing.</span></span><input id="setting-follow-refresh" class="checkbox" type="checkbox" /></label>
            <label class="c-shell-setting-row"><span class="c-shell-setting-copy"><span class="c-shell-setting-label"><span data-l10n="shell.settings.frame_rate_limit">Frame rate limit</span><strong id="setting-frame-rate-value" class="c-shell-setting-value"></strong></span><span class="c-shell-setting-detail" data-l10n="shell.settings.manual_frame_rate_limit">Used when monitor matching is off, from 30 to 240 FPS.</span></span><input id="setting-frame-rate" class="range c-slider c-shell-setting-control" type="range" min="30" max="240" step="1" /></label>
            <label class="c-shell-setting-row"><span class="c-shell-setting-copy"><span class="c-shell-setting-label"><span data-l10n="shell.settings.interface_scale">Interface scale</span><strong id="setting-ui-scale-value" class="c-shell-setting-value"></strong></span><span class="c-shell-setting-detail" data-l10n="shell.settings.resize_interface_controls_and_text">Resize interface controls and text.</span></span><input id="setting-ui-scale" class="range c-slider c-shell-setting-control" type="range" min="50" max="200" step="25" /></label>
            <label class="c-shell-setting-row"><span class="c-shell-setting-copy"><span class="c-shell-setting-label"><span data-l10n="shell.settings.minimum_light">Minimum light</span><strong id="setting-minimum-light-value" class="c-shell-setting-value"></strong></span><span class="c-shell-setting-detail" data-l10n="shell.settings.set_the_ambient_light_floor_from_0_to_100_percen">Set the ambient light floor, from 0 to 100 percent.</span></span><input id="setting-minimum-light" class="range c-slider c-shell-setting-control" type="range" min="0" max="100" step="1" /></label>
            <h2 data-l10n="shell.settings.camera">Camera</h2>
            <label class="c-shell-setting-row"><span class="c-shell-setting-copy"><span class="c-shell-setting-label"><span data-l10n="shell.settings.keyboard_pan_speed">Keyboard pan speed</span><strong id="setting-keyboard-speed-value" class="c-shell-setting-value"></strong></span><span class="c-shell-setting-detail" data-l10n="shell.settings.camera_movement_speed_from_0_to_200">Camera movement speed from 0 to 200.</span></span><input id="setting-keyboard-speed" class="range c-slider c-shell-setting-control" type="range" min="0" max="200" step="1" /></label>
            <label class="c-shell-setting-row"><span class="c-shell-setting-copy"><span class="c-shell-setting-label" data-l10n="shell.settings.wheel_changes_level">Wheel changes level</span><span class="c-shell-setting-detail" data-l10n="shell.settings.use_the_mouse_wheel_to_move_between_vertical_lev">Use the mouse wheel to move between vertical levels.</span></span><input id="setting-wheel-level" class="checkbox" type="checkbox" /></label>
        </section>
        <section id="settings-error" class="c-alert-row c-alert-row--danger u-hidden"><span class="c-alert-row__marker">!</span><span class="c-alert-row__body"><span class="c-alert-row__title" data-l10n="shell.settings.settings_unavailable">Settings unavailable</span><span id="settings-error-detail" class="c-alert-row__detail"></span></span></section>
        <footer class="c-shell-actions c-shell-actions--row"><button id="settings-reset" data-l10n="shell.settings.settings-reset">Reset supported settings</button><button id="settings-revert" data-l10n="shell.settings.settings-revert">Revert</button><button id="settings-apply" class="c-button" data-l10n="shell.settings.settings-apply">Apply</button></footer>
    </main>
</body>
</rml>
