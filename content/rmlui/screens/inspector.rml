<rml>
<head><link type="text/rcss" href="../styles/base.rcss"/><link type="text/rcss" href="../styles/components.rcss"/><link type="text/rcss" href="../styles/accessibility.rcss"/><link type="text/rcss" href="inspector.rcss"/></head>
<body id="inspector_root" class="l-inspector-root is-hidden">
  <div id="tile_world_label" class="c-tile-world-label is-hidden" aria-live="polite"><span id="tile_world_label_text"></span></div>
  <div id="selection_pointer_tip" class="c-selection-pointer-tip is-hidden" aria-live="polite"><strong id="selection_pointer_tool"></strong><span id="selection_pointer_size"></span></div>
  <!-- Priority controls receive authoritative aria-disabled/disabled state during projection. -->
  <section id="creature_preview" class="l-creature-preview is-hidden" role="dialog" aria-labelledby="creature_preview_title">
    <header class="c-title-bar">
      <handle id="creature_preview_drag_handle" class="c-title-bar__drag-handle" move_target="creature_preview" edge_margin="52dp 12dp 54dp 12dp"><div class="c-title-bar__mark"></div><div class="c-creature-preview-heading"><small id="creature_preview_kind" data-l10n="inspector.preview.creature">Creature</small><h2 id="creature_preview_title"></h2></div></handle>
      <button id="creature_preview_close" class="c-button c-button--compact" data-l10n="common.close">Close</button>
    </header>
    <div class="c-creature-preview-body">
      <div class="c-creature-preview-camera" aria-label="Camera view">
        <div class="c-creature-preview-camera__scene"><img id="creature_preview_camera_image" class="c-creature-preview-camera__image" src="?camera-preview://selected" /><span class="c-creature-preview-camera__reticle">+</span><span class="c-creature-preview-camera__live" data-l10n="inspector.preview.camera_live">LIVE</span></div>
        <div class="c-creature-preview-camera__caption"><span data-l10n="inspector.preview.camera">Camera view</span><span id="creature_preview_camera_position"></span></div>
      </div>
      <div class="c-creature-preview-activity-line"><span id="creature_preview_activity"></span></div>
      <h3 data-l10n="inspector.static.attributes">Attributes</h3>
      <div class="c-creature-preview-stats">
        <div class="c-creature-preview-stat"><span data-l10n="inspector.preview.strength">Strength</span><strong id="creature_preview_strength"></strong></div>
        <div class="c-creature-preview-stat"><span data-l10n="inspector.preview.dexterity">Dexterity</span><strong id="creature_preview_dexterity"></strong></div>
        <div class="c-creature-preview-stat"><span data-l10n="inspector.preview.constitution">Constitution</span><strong id="creature_preview_constitution"></strong></div>
        <div class="c-creature-preview-stat"><span data-l10n="inspector.preview.intelligence">Intelligence</span><strong id="creature_preview_intelligence"></strong></div>
        <div class="c-creature-preview-stat"><span data-l10n="inspector.preview.wisdom">Wisdom</span><strong id="creature_preview_wisdom"></strong></div>
        <div class="c-creature-preview-stat"><span data-l10n="inspector.preview.charisma">Charisma</span><strong id="creature_preview_charisma"></strong></div>
      </div>
      <h3 data-l10n="inspector.static.needs">Needs</h3>
      <div class="c-creature-preview-needs">
        <div class="c-creature-preview-need"><span data-l10n="inspector.preview.hunger">Hunger</span><div class="c-creature-preview-meter"><span id="creature_preview_hunger_meter"></span></div><strong id="creature_preview_hunger"></strong></div>
        <div class="c-creature-preview-need"><span data-l10n="inspector.preview.thirst">Thirst</span><div class="c-creature-preview-meter"><span id="creature_preview_thirst_meter"></span></div><strong id="creature_preview_thirst"></strong></div>
        <div class="c-creature-preview-need"><span data-l10n="inspector.preview.sleep">Sleep</span><div class="c-creature-preview-meter"><span id="creature_preview_sleep_meter"></span></div><strong id="creature_preview_sleep"></strong></div>
        <div class="c-creature-preview-need"><span data-l10n="inspector.preview.happiness">Happiness</span><div class="c-creature-preview-meter"><span id="creature_preview_happiness_meter"></span></div><strong id="creature_preview_happiness"></strong></div>
      </div>
      <div class="l-inspector-actions c-creature-preview-actions"><button id="creature_preview_details" class="c-button" data-l10n="inspector.preview.full_profile">Full profile</button><button id="creature_preview_locate" class="c-button" data-l10n="inspector.static.inspector_locate">Center on map</button></div>
    </div>
  </section>
  <aside id="inspector_panel" class="l-inspector-panel">
    <header class="l-inspector-title"><handle id="inspector_drag_handle" class="c-title-bar__drag-handle" move_target="inspector_panel" edge_margin="76dp 12dp 58dp 12dp"><div><small id="inspector_kind" data-l10n="inspector.static.inspector_kind">Selection</small><h2 id="inspector_title" data-l10n="inspector.static.inspector_title">Selected target</h2></div></handle><button id="inspector_back" class="c-button" data-l10n="inspector.static.inspector_back">Back</button><button id="inspector_close" class="c-button" data-l10n="inspector.static.inspector_close">Close</button></header>
    <div class="l-inspector-toolbar"><span id="inspector_position"></span><button id="inspector_locate" class="c-button" data-l10n="inspector.static.inspector_locate">Center on map</button><button id="inspector_refresh" class="c-button" data-l10n="inspector.static.inspector_refresh">Refresh</button></div>
    <div id="inspector_scroll" class="l-inspector-scroll">
       <section id="inspector_tile" class="c-inspector-section is-hidden"><h3 data-l10n="inspector.static.tile_overview">Tile overview</h3><div id="tile_terrain"></div><section id="tile_construction_section" class="is-hidden"><h3 data-l10n="inspector.static.construction">Construction</h3><p id="tile_construction"></p></section><section id="tile_contents_section" class="is-hidden"><h3 data-l10n="inspector.static.contents">Contents</h3><div id="tile_contents"></div></section><section id="tile_creatures_section" class="is-hidden"><h3 data-l10n="inspector.static.creatures">Creatures</h3><div id="tile_creatures"></div><button id="tile_open_creature" class="c-button" data-l10n="inspector.static.tile_open_creature">Inspect first creature</button></section><section id="tile_job_section" class="is-hidden"><h3 data-l10n="inspector.static.active_job">Active job</h3><p id="tile_job"></p><p id="tile_job_work_positions"></p><section id="tile_job_requirements_section" class="is-hidden"><h3 data-l10n="inspector.static.required_items">Required items</h3><div id="tile_job_requirements"></div></section><div class="l-inspector-actions"><button id="tile_cancel_job" class="c-button" data-l10n="inspector.static.tile_cancel_job">Cancel job</button><button id="tile_raise_job" class="c-button" data-l10n="inspector.static.tile_raise_job">Raise priority</button><button id="tile_lower_job" class="c-button" data-l10n="inspector.static.tile_lower_job">Lower priority</button></div></section><section id="tile_links_section" class="is-hidden"><h3 data-l10n="inspector.static.designation_links">Designation / links</h3><p id="tile_links"></p></section><section><h3 data-l10n="inspector.static.context_actions">Context actions</h3><div class="l-inspector-actions"><button id="tile_mine" class="c-button" data-l10n="inspector.static.tile_mine">Mine wall</button><button id="tile_remove_floor" class="c-button" data-l10n="inspector.static.tile_remove_floor">Remove floor</button><button id="tile_harvest" class="c-button" data-l10n="inspector.static.tile_harvest">Harvest</button><button id="tile_fell" class="c-button" data-l10n="inspector.static.tile_fell">Fell tree</button><button id="tile_remove_plant" class="c-button" data-l10n="inspector.static.tile_remove_plant">Remove plant</button><button id="tile_manage" class="c-button" data-l10n="inspector.static.tile_manage">Manage</button></div></section></section>
      <section id="inspector_creature" class="c-inspector-section is-hidden"><h3 data-l10n="inspector.static.creature">Creature</h3><p id="creature_profession"></p><p data-l10n="inspector.static.profession_choices">Set profession</p><div id="creature_professions" class="l-inspector-actions" role="listbox"></div><p id="creature_professions_empty" data-l10n="inspector.static.no_profession_choices">No profession choices available</p><p id="creature_activity"></p><h3 data-l10n="inspector.static.skills">Skills</h3><div id="creature_skills"></div><p id="creature_skills_empty" data-l10n="inspector.static.no_skills">No skills reported</p><h3 data-l10n="inspector.static.attributes">Attributes</h3><div id="creature_attributes" class="c-creature-attribute-grid"></div><h3 data-l10n="inspector.static.needs">Needs</h3><div id="creature_needs" class="c-creature-needs-summary"></div><h3 data-l10n="inspector.static.equipment">Equipment</h3><div id="creature_equipment"></div><p id="creature_equipment_empty" data-l10n="inspector.static.no_equipment">No worn items</p><h3 data-l10n="inspector.static.inventory">Inventory</h3><div id="creature_inventory"></div><p id="creature_inventory_empty" data-l10n="inspector.static.no_inventory">No carried items</p></section>
      <section id="inspector_workshop" class="c-inspector-section is-hidden"><h3 data-l10n="inspector.static.workshop_inspection">Workshop inspection</h3><p id="workshop_summary"></p><p id="workshop_options"></p><button id="workshop_toggle_suspended" class="c-button" data-l10n="inspector.static.workshop_toggle_suspended">Suspend</button></section>
      <section id="inspector_stockpile" class="c-inspector-section is-hidden"><h3 data-l10n="inspector.static.stockpile_inspection">Stockpile inspection</h3><p id="stockpile_summary"></p><p id="stockpile_options"></p><div id="stockpile_contents"></div><button id="stockpile_toggle_suspended" class="c-button" data-l10n="inspector.static.stockpile_toggle_suspended">Suspend</button></section>
      <section id="inspector_agriculture" class="c-inspector-section is-hidden"><h3 id="agriculture_kind" data-l10n="inspector.static.agriculture_kind">Agriculture</h3><p id="agriculture_summary"></p><p id="agriculture_options"></p><div class="l-inspector-actions"><button id="agriculture_toggle_suspended" class="c-button" data-l10n="inspector.static.agriculture_toggle_suspended">Suspend</button><button id="agriculture_toggle_primary" class="c-button" data-l10n="inspector.static.agriculture_toggle_primary">Toggle harvest</button></div></section>
      <section id="selection_configuration" class="c-inspector-section is-hidden"><h3 data-l10n="inspector.static.selection_configuration">Selection configuration</h3><p id="selection_action"></p><p id="selection_geometry"></p><div class="l-inspector-actions"><button id="selection_rotate" class="c-button" data-l10n="inspector.static.selection_rotate">Rotate</button><button id="selection_cancel" class="c-button" data-l10n="inspector.static.selection_cancel">Cancel selection</button></div></section>
      <p id="inspector_status" class="c-status"></p>
    </div>
  </aside>
</body></rml>
