<rml>
<head>
    <title>Paused</title>
    <link type="text/rcss" href="/styles/base.rcss" /><link type="text/rcss" href="/styles/components.rcss" /><link type="text/rcss" href="/styles/accessibility.rcss" /><link type="text/rcss" href="/screens/shell.rcss" />
</head>
<body class="l-shell-screen l-shell-screen--centered is-blocking">
    <main class="c-shell-chamber c-shell-chamber--compact">
        <header class="c-shell-masthead"><h1>Paused</h1></header>
        <p id="pause-authoritative-state" class="c-shell-pause-state">Waiting for simulation pause state</p>
        <nav class="c-shell-actions">
            <button id="pause-resume" class="c-button c-button--primary">Resume</button>
            <button id="pause-save">Save game</button>
            <span id="pause-save-status" class="c-field__help"></span>
            <button id="pause-load">Load game</button>
            <button id="pause-settings">Settings</button>
            <button id="pause-menu" class="c-button c-button--danger">Return to main menu</button>
        </nav>
        <section id="pause-error" class="c-alert-row c-alert-row--danger c-shell-status u-hidden"><span class="c-alert-row__marker">!</span><span class="c-alert-row__body"><span class="c-alert-row__title">Action could not be completed</span><span id="pause-error-detail" class="c-alert-row__detail"></span></span></section>
    </main>
</body>
</rml>
