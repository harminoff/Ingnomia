.l-hud-orders-tools-root { position: absolute; left: 0; top: 0; width: 100%; height: 100%; background-color: transparent; pointer-events: none; }
.l-hud-orders-tools-panel { position: absolute; left: 10dp; top: 10dp; right: 10dp; bottom: 10dp; box-sizing: border-box; pointer-events: auto; overflow: hidden; color: #142333; background-color: #cbd5d9; border-width: 2dp; border-top-color: #f7faf8; border-left-color: #f7faf8; border-right-color: #4d6476; border-bottom-color: #4d6476; box-shadow: 4dp 4dp 0dp #173d5940; }
.l-hud-orders-tools-panel > .c-title-bar { display: flex; align-items: center; justify-content: space-between; margin: 0; }
.l-hud-orders-tools-panel .c-title-bar__drag-handle > * { pointer-events: none; }
.l-hud-orders-tools-shelf { position: absolute; left: 8dp; top: 44dp; bottom: 44dp; width: 220dp; max-width: 220dp; max-height: none; transform: none; overflow-y: auto; padding: 5dp; pointer-events: auto; background-color: transparent; border: 0; }
.l-hud-orders-tools-shelf .c-button { display: block; width: 100%; margin-bottom: 4dp; min-height: 30dp; padding: 5dp 7dp; text-align: left; }
.l-hud-orders-tools-shelf .c-hud-shelf-heading { margin: 3dp 2dp 6dp; color: #526a78; }
.l-hud-orders-tools-panel > .l-hud-hints { display: flex; position: absolute; left: 8dp; right: 8dp; bottom: 8dp; min-height: 27dp; padding: 4dp 7dp; gap: 5dp; box-sizing: border-box; overflow: hidden; }
.l-hud-orders-tools-panel > .l-hud-hints .c-button { min-width: 70dp; min-height: 24dp; padding: 2dp 5dp; }
.l-hud-orders-tools-panel > .l-hud-mine-menu,
.l-hud-orders-tools-panel > .l-hud-action-menu { left: 246dp; top: 44dp; }
.l-hud-orders-tools-panel > .l-hud-build-panel { left: 246dp; top: 44dp; width: 500dp; height: 640dp; min-height: 640dp; max-height: 640dp; }
.l-hud-orders-tools-panel > .l-hud-build-panel #hud_build_catalog { width: auto; }

/* A detached tool is a single compact window. The shared document keeps all
   existing bindings, but only the selected panel is presented; the shelf,
   outer chrome, and hint strip remain available only in the in-game HUD. */
.l-hud-tool-window-root #hud_orders_tools_panel { left: 0; top: 0; right: auto; bottom: auto; width: 100%; height: 100%; border-width: 0; box-shadow: none; background-color: transparent; }
.l-hud-tool-window-root #hud_orders_tools_header,
.l-hud-tool-window-root #hud_tool_shelf { display: none; }
.l-hud-tool-window-root > #hud_orders_tools_panel > #hud_mine_menu,
.l-hud-tool-window-root > #hud_orders_tools_panel > .l-hud-action-menu { left: 0; top: 0; right: auto; bottom: auto; min-width: 0; max-width: none; height: auto; max-height: 100%; overflow-y: auto; box-sizing: border-box; }
.l-hud-tool-window-root > #hud_orders_tools_panel > #hud_mine_menu { width: 260dp; }
.l-hud-tool-window-root > #hud_orders_tools_panel > .l-hud-action-menu { width: 270dp; }
.l-hud-tool-window-root > #hud_orders_tools_panel > .l-hud-designations-menu { width: 300dp; }
.l-hud-tool-window-root > #hud_orders_tools_panel > .l-hud-jobs-menu { width: 320dp; }
.l-hud-tool-window-root > #hud_orders_tools_panel > #hud_mine_menu > .c-title-bar,
.l-hud-tool-window-root > #hud_orders_tools_panel > #hud_mine_menu > p,
.l-hud-tool-window-root > #hud_orders_tools_panel > #hud_mine_menu > .c-button { width: 242dp; }
.l-hud-tool-window-root > #hud_orders_tools_panel > #hud_mine_menu > .c-button--compact { width: auto; }
.l-hud-tool-window-root > #hud_orders_tools_panel > .l-hud-action-menu > .c-title-bar,
.l-hud-tool-window-root > #hud_orders_tools_panel > .l-hud-action-menu > p,
.l-hud-tool-window-root > #hud_orders_tools_panel > .l-hud-action-menu > .c-button { width: 252dp; }
.l-hud-tool-window-root > #hud_orders_tools_panel > .l-hud-action-menu > .c-button--compact { width: auto; }
.l-hud-tool-window-root > #hud_orders_tools_panel > .l-hud-designations-menu > .c-title-bar,
.l-hud-tool-window-root > #hud_orders_tools_panel > .l-hud-designations-menu > p,
.l-hud-tool-window-root > #hud_orders_tools_panel > .l-hud-designations-menu > .c-button { width: 282dp; }
.l-hud-tool-window-root > #hud_orders_tools_panel > .l-hud-designations-menu > .c-button--compact { width: auto; }
.l-hud-tool-window-root > #hud_orders_tools_panel > .l-hud-jobs-menu > .c-title-bar,
.l-hud-tool-window-root > #hud_orders_tools_panel > .l-hud-jobs-menu > p,
.l-hud-tool-window-root > #hud_orders_tools_panel > .l-hud-jobs-menu > .c-button { width: 302dp; }
.l-hud-tool-window-root > #hud_orders_tools_panel > .l-hud-jobs-menu > .c-button--compact { width: auto; }
.l-hud-tool-window-root > #hud_orders_tools_panel > #hud_hint_strip { display: none; }
.l-hud-tool-window-root > #hud_orders_tools_panel > #hud_build_panel { left: 0; top: 0; right: 0; bottom: 0; width: auto; height: auto; min-height: 0; max-height: none; }

/* Detached order windows use the native QWindow drag path. Do not add
   move_target here: movement must not also move the RmlUi panel, which leaves
   the header and buttons offset. */
.l-hud-tool-window-root .c-title-bar__drag-handle { cursor: move; }
.l-hud-tool-window-root .c-title-bar > .c-title-bar__drag-handle { flex: 1 1 auto; min-width: 0; }
.l-hud-tool-window-root .c-title-bar > .c-button { flex: 0 0 auto; }
.l-hud-tool-window-root .c-title-bar__mark {
    display: flex;
    flex: 0 0 20dp;
    width: 20dp;
    height: 20dp;
    margin-right: 6dp;
    align-items: center;
    justify-content: center;
    color: #f1ca4f;
    background-color: transparent;
    font-size: 15dp;
    font-weight: bold;
    line-height: 20dp;
    text-align: center;
}
.l-hud-tool-window-root > #hud_orders_tools_panel > #hud_mine_menu > .c-title-bar { width: 260dp; }
.l-hud-tool-window-root > #hud_orders_tools_panel > .l-hud-action-menu > .c-title-bar { width: 270dp; }
.l-hud-tool-window-root > #hud_orders_tools_panel > .l-hud-designations-menu > .c-title-bar { width: 300dp; }
.l-hud-tool-window-root > #hud_orders_tools_panel > .l-hud-jobs-menu > .c-title-bar { width: 320dp; }
.l-hud-tool-window-root > #hud_orders_tools_panel > #hud_build_panel .c-title-bar { width: 500dp; }
.l-hud-tool-window-root .c-title-bar__mark--orders { decorator: text("O" #f1ca4f); }
.l-hud-tool-window-root .c-title-bar__mark--mine { decorator: text("M" #f1ca4f); }
.l-hud-tool-window-root .c-title-bar__mark--agriculture { decorator: text("A" #f1ca4f); }
.l-hud-tool-window-root .c-title-bar__mark--designations { decorator: text("D" #f1ca4f); }
.l-hud-tool-window-root .c-title-bar__mark--jobs { decorator: text("J" #f1ca4f); }
.l-hud-tool-window-root .c-title-bar__mark--build { decorator: text("B" #f1ca4f); }

/* The detached Build catalog matches the compact Inventory window. */
.l-hud-tool-window-root > #hud_orders_tools_panel > #hud_build_panel { left: 0; top: 0; right: 0; bottom: 0; width: 100%; height: 100%; min-height: 0; max-height: none; }
.l-hud-tool-window-root > #hud_orders_tools_panel > #hud_build_panel > .c-title-bar { width: auto; }