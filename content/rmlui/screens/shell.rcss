/* ---------------------------------------------------------------- Stage 18: Windows 98 shell screens
   The main menu, Custom Game wizard and Load Game dialog sit on the desktop colour of the Windows Standard scheme.
   Lengths in em are of the snapped 11/22/33 px system font (1 px at 1x = 1/11 em). */
.l-shell-screen.l-shell-desktop { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 0; overflow: hidden; background-color: #008080; }
.l-shell-dialog { display: flex; flex-direction: column; width: 34.9091em; }
.w98-sheet .l-menu-row { align-items: center; margin: 0 0 0.3636em 0; }
.w98-sheet button.w98-button.l-menu-command { flex: 0 0 10.9091em; width: 10.9091em; }
.w98-sheet .l-shell-error { color: #000000; }
/* The focused command button carries the default outline, as in a Windows dialog box. */
.l-shell-dialog .w98-button:focus, .l-new-game-wizard .w98-button:focus {
    border-color: #000000;
    box-shadow: inset 0.0909em 0.0909em 0 #ffffff, inset -0.0909em -0.0909em 0 #000000, inset 0.1818em 0.1818em 0 #dfdfdf, inset -0.1818em -0.1818em 0 #808080;
}

/* Custom Game wizard: the book's 317 x 193 DLU wizard (476 x 314 px) below its caption. */
.w98-wizard.l-new-game-wizard { width: 43.2727em; height: 30.1818em; }
.w98-sheet .l-wizard-page .w98-wizard__body { gap: 0.1818em; }
.w98-sheet .l-wizard-exterior { background-color: #ffffff; }
/* Welcome and Completion pages: a watermark band on the left (PDF p.307) and a bold title. */
.w98-sheet .l-wizard-watermark { display: block; flex: 0 0 14.9091em; width: 14.9091em; decorator: vertical-gradient( #000080 #1084d0 ); }
.w98-sheet .l-wizard-exterior__body { padding: 1em 1em 0.6364em 1.4545em; background-color: #ffffff; }
.w98-sheet p.l-wizard-exterior__title { display: block; margin: 0 0 1em 0; font-weight: bold; color: #000000; }
.w98-sheet .l-new-game-unit { flex: 0 0 5.4545em; width: 5.4545em; }

/* Stage 19: in the game the pause and settings dialogs sit over the paused map instead of the desktop colour. */
.l-shell-screen.l-shell-desktop.is-in-game { background-color: transparent; }
/* High Contrast: a white desktop behind the dialogs (Stage 20). */
.l-shell-screen.l-shell-desktop.is-high-contrast { background-color: #ffffff; }
.l-shell-screen.l-shell-desktop.is-in-game.is-high-contrast { background-color: transparent; }
/* Settings property sheet: 384 x 380 px at 1x, Close only. Slider values sit to the right, with Low / High labels
   under the track (as in the Windows 98 Display Properties "Screen area" slider). */
.l-settings-sheet { width: 34.9091em; height: 34.5455em; }
.w98-sheet .l-settings-value { flex: 0 0 4.3636em; width: 4.3636em; text-align: right; }
.w98-sheet .w98-group > .w98-line.l-settings-range { min-height: 0; margin-top: -0.3636em; }
/* Loading: the hourglass while the game cannot respond (PDF p.356); the arrow again when it asks a question. */
.l-shell-screen.is-loading { cursor: wait; }
.l-shell-screen.is-loading.is-failed { cursor: arrow; }
.l-loading-box { width: 28.3636em; }

/* Load Game dialog (Open dialog model). */
.l-load-dialog { width: 38.1818em; height: 27.2727em; }
.w98-sheet .l-load-dialog .w98-sheet__body, .l-load-dialog .w98-sheet__body { padding-bottom: 0.6364em; }
.w98-sheet .l-load-list { flex: 1 1 0; min-height: 0; }
.w98-sheet .l-load-modified { width: 10.9091em; }
.w98-sheet .l-load-version { width: 5.4545em; }

.l-shell-root {
    width: 100%;
    height: 100%;
    /* The app-shell document is a compositor; routed documents own input. */
    pointer-events: none;
    overflow: hidden;
    background-color: #101315;
}

.l-shell-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.l-shell-layer--overlay { pointer-events: none; z-index: 40; }
.l-shell-layer--modal { pointer-events: none; z-index: 80; }
#shell-primary-layer { pointer-events: none; }

.l-shell-screen {
    width: 100%;
    height: 100%;
    pointer-events: auto;
    padding: 24dp;
    overflow-y: auto;
    background-color: #101315;
}

.is-blocking { pointer-events: auto; }

/* RCT2-inspired main-menu and management shell: sky-blue field, compact
   silver window, blue title treatment, and yellow primary action. */
.l-shell-root,
.l-shell-screen { background-color: #6b9fc4; }
.l-shell-screen { padding: 12dp; }

