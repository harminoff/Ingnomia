<rml>
<head><link type="text/rcss" href="../styles/base.rcss"/><link type="text/rcss" href="../styles/components.rcss"/><link type="text/rcss" href="../styles/accessibility.rcss"/><link type="text/rcss" href="../screens/management6a.rcss"/></head>
<body id="stockpile_manager_root" class="l-m6a-root is-hidden"><section id="stockpile_workbench" class="l-m6a-panel">
  <header class="l-m6a-title"><handle class="l-m6a-drag-handle" move_target="stockpile_workbench" edge_margin="76dp 12dp 58dp 12dp"><div class="l-m6a-title__copy"><small data-l10n="management.stockpile.storage_management">Storage management</small><h2 id="stockpile_title" data-l10n="management.stockpile.stockpile_title">Stockpile</h2></div></handle><button id="stockpile_locate" class="c-button" data-l10n="management.stockpile.stockpile_locate">Locate</button><button id="stockpile_close" class="c-button" data-l10n="management.stockpile.stockpile_close">Close</button></header>
  <div class="l-m6a-toolbar"><input id="stockpile_search" class="text" type="text" value=""  placeholder="Filter loaded contents and rules" data-l10n-placeholder="management.stockpile.stockpile_search.placeholder"/><button id="stockpile_sort" class="c-dropdown-button" data-l10n="management.stockpile.stockpile_sort">Sort A-Z v</button><button id="stockpile_page_previous" class="c-button" data-l10n="management.stockpile.stockpile_page_previous">Previous rows</button><button id="stockpile_page_next" class="c-button" data-l10n="management.stockpile.stockpile_page_next">Next rows</button><button id="stockpile_refresh" class="c-button" data-l10n="management.stockpile.stockpile_refresh">Refresh</button></div>
  <div class="l-m6a-scroll"><div id="stockpile_loading" class="c-m6a-state" data-l10n="management.stockpile.stockpile_loading">Loading stockpile data...</div><div id="stockpile_empty" class="c-m6a-state is-hidden" data-l10n="management.stockpile.stockpile_empty">This stockpile has no loaded filters or contents.</div><div id="stockpile_error" class="c-m6a-state is-error is-hidden"></div>
    <section id="stockpile_content" class="is-hidden"><div class="l-m6a-section"><h3 data-l10n="management.stockpile.storage_controls">Storage controls</h3><div class="l-m6a-grid"><input id="stockpile_name" class="text" type="text" value=""/><input id="stockpile_priority" class="text" type="number" value="1" min="1"/></div><p id="stockpile_summary"></p><div class="l-m6a-actions"><button id="stockpile_apply_basics" class="c-button" data-l10n="management.stockpile.stockpile_apply_basics">Apply name and priority</button><button id="stockpile_toggle_suspended" class="c-check-button is-unchecked" data-l10n="management.stockpile.stockpile_toggle_suspended">☐ Suspend</button><button id="stockpile_toggle_pull" class="c-check-button is-unchecked" data-l10n="management.stockpile.stockpile_toggle_pull">☐ Pull from others</button><button id="stockpile_toggle_allow_pull" class="c-check-button is-unchecked" data-l10n="management.stockpile.stockpile_toggle_allow_pull">☐ Allow pull from here</button></div></div>
      <section class="l-m6a-section"><h3 data-l10n="management.stockpile.allowed_contents">Allowed contents</h3><p id="stockpile_filter_selection"></p><div id="stockpile_filters" class="c-m6a-list"></div><div class="l-m6a-actions"><button id="stockpile_next_filter" class="c-button" data-l10n="management.stockpile.stockpile_next_filter">Next rule</button><button id="stockpile_toggle_filter" class="c-button" data-l10n="management.stockpile.stockpile_toggle_filter">Toggle selected rule</button></div></section>
      <section class="l-m6a-section"><h3 data-l10n="management.stockpile.current_contents">Current contents</h3><p id="stockpile_content_selection"></p><div id="stockpile_rows" class="c-m6a-list"></div><button id="stockpile_next_content" class="c-button" data-l10n="management.stockpile.stockpile_next_content">Next content row</button><p class="c-m6a-warning" data-l10n="management.stockpile.unsupported_projections_and_per_item_controls_ar">Unsupported projections and per-item controls are intentionally omitted.</p></section>
    </section><p id="stockpile_status" class="c-m6a-status"></p></div>
</section></body></rml>
