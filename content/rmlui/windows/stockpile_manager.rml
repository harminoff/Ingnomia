<rml>
<head><link type="text/template" href="/templates/management_window.rml"/><link type="text/rcss" href="../screens/management6a.rcss"/></head>
<body id="stockpile_manager_root" class="l-m6a-root is-hidden">
  <template src="management-window">
  <main id="stockpile_workbench" class="c-window l-m6a-panel l-stockpile-panel">
    <header class="c-title-bar l-m6a-title">
      <handle class="c-title-bar__drag-handle l-m6a-drag-handle" move_target="stockpile_workbench" edge_margin="76dp 12dp 58dp 12dp"><span class="c-title-bar__mark" aria-hidden="true"></span><div class="l-m6a-title__copy"><small data-l10n="management.stockpile.storage_management">Storage management</small><h2 id="stockpile_title" data-l10n="management.stockpile.stockpile_title">Stockpile</h2></div></handle>
      <button id="stockpile_close" class="c-button" data-l10n="management.stockpile.stockpile_close">Close</button>
    </header>
    <div class="c-window__body l-stockpile-body">
      <aside class="l-stockpile-rail" aria-label="Stockpile navigation">
        <section class="l-stockpile-rail-section"><h3 class="l-stockpile-rail-heading" data-l10n="management.stockpile.views_heading">Views</h3><nav class="l-stockpile-view-tabs" role="tablist" aria-label="Stockpile views" aria-orientation="vertical"><button id="stockpile_view_contents" class="c-button l-stockpile-rail-button is-selected" role="tab" aria-selected="true" data-l10n="management.stockpile.view_contents">Stock</button><button id="stockpile_view_allow" class="c-button l-stockpile-rail-button" role="tab" aria-selected="false" data-l10n="management.stockpile.view_allow">Allow list</button><button id="stockpile_view_settings" class="c-button l-stockpile-rail-button" role="tab" aria-selected="false" data-l10n="management.stockpile.view_settings">Settings</button></nav><button id="stockpile_locate" class="c-button l-stockpile-rail-button" data-l10n="management.stockpile.stockpile_locate">Center on map</button></section>
      </aside>
      <div class="l-stockpile-main">
    <div class="l-stockpile-state"><div id="stockpile_loading" class="c-m6a-state" data-l10n="management.stockpile.stockpile_loading">Loading stockpile data...</div><div id="stockpile_empty" class="c-m6a-state is-hidden" data-l10n="management.stockpile.stockpile_empty">No stockpile data is available.</div><div id="stockpile_error" class="c-m6a-state is-error is-hidden"></div></div>
    <div id="stockpile_content" class="l-stockpile-panes is-hidden">
      <!-- Action-owned editor; live document reload restores its controller-selected pane. -->
      <section id="stockpile_settings_pane" class="l-stockpile-pane l-stockpile-settings-pane is-hidden" role="tabpanel" aria-labelledby="stockpile_view_settings">
        <div class="c-m6a-section-heading"><div><h3 data-l10n="management.stockpile.name_priority">Name &amp; priority</h3><p class="c-m6a-help" data-l10n="management.stockpile.storage_help">Set a name and priority for this stockpile.</p></div></div>
        <div class="l-stockpile-settings"><label class="c-stockpile-field c-stockpile-name"><span data-l10n="management.stockpile.name_label">Name</span><input id="stockpile_name" class="text" type="text" value="" /></label><label class="c-stockpile-field c-stockpile-priority"><span data-l10n="management.stockpile.priority_label">Priority</span><span class="c-stockpile-priority-stepper"><button id="stockpile_priority_up" class="c-stockpile-priority-button" type="button" aria-describedby="stockpile_tooltip" aria-label="Raise priority" title="Raise priority">^</button><input id="stockpile_priority" class="text" type="number" value="1" min="1" step="1" inputmode="numeric" title="1 is highest" /><button id="stockpile_priority_down" class="c-stockpile-priority-button" type="button" aria-describedby="stockpile_tooltip" aria-label="Lower priority" title="Lower priority">v</button></span></label><button id="stockpile_apply_basics" class="c-button" data-l10n="management.stockpile.stockpile_apply_basics">Apply</button><p id="stockpile_summary" class="c-stockpile-summary"></p></div>
        <div class="c-m6a-section-heading"><div><h3 data-l10n="management.stockpile.hauling_options">Hauling options</h3><p class="c-m6a-help" data-l10n="management.stockpile.hauling_help">Control transfers between stockpiles.</p></div></div>
        <div class="l-stockpile-hauling-options"><label class="c-stockpile-checkbox" for="stockpile_toggle_pull"><input id="stockpile_toggle_pull" class="checkbox" type="checkbox" aria-describedby="stockpile_tooltip" /><span>Take from lower-priority stockpiles</span></label><label class="c-stockpile-checkbox" for="stockpile_toggle_allow_pull"><input id="stockpile_toggle_allow_pull" class="checkbox" type="checkbox" aria-describedby="stockpile_tooltip" /><span>Let higher-priority stockpiles take from here</span></label></div>
        <div class="c-m6a-section-heading"><div><h3 data-l10n="management.stockpile.stockpile_status">Stockpile status</h3><p class="c-m6a-help" data-l10n="management.stockpile.stockpile_status_help">Pause or resume deliveries to this stockpile.</p></div></div>
        <div class="l-stockpile-status-settings"><button id="stockpile_toggle_suspended" class="c-button is-unchecked" aria-describedby="stockpile_tooltip" data-l10n="management.stockpile.stockpile_toggle_suspended">Suspend</button></div>
      </section>
      <section id="stockpile_contents_pane" class="l-stockpile-pane l-stockpile-contents-pane" role="tabpanel" aria-labelledby="stockpile_view_contents">
        <div class="c-m6a-section-heading"><div><h3 data-l10n="management.stockpile.current_contents">Stock</h3><p class="c-m6a-help" data-l10n="management.stockpile.current_contents_help">What is physically stored here.</p></div><span id="stockpile_content_count" class="c-m6a-count"></span></div>
        <div class="c-stockpile-table-header c-stockpile-content-header c-stockpile-flat-header c-excel-header">
          <div class="c-stockpile-flat__category c-excel-header__cell"><button id="stockpile_content_sort_category" class="c-excel-header__sort"><span id="stockpile_content_column_category">Category</span><span id="stockpile_content_sort_category_direction"></span></button><div class="c-excel-filter-combo"><input id="stockpile_content_filter_category" class="text c-excel-header__filter" placeholder="All" aria-label="Filter Category" aria-controls="stockpile_content_filter_category_options" aria-expanded="false"/><button id="stockpile_content_filter_category_toggle" class="c-excel-filter-combo__toggle" aria-label="Show Category values" aria-controls="stockpile_content_filter_category_options" aria-expanded="false">v</button><div id="stockpile_content_filter_category_options" class="c-excel-filter-combo__options is-hidden" role="listbox"></div></div></div>
          <div class="c-stockpile-flat__group c-excel-header__cell"><button id="stockpile_content_sort_group" class="c-excel-header__sort"><span id="stockpile_content_column_group">Type</span><span id="stockpile_content_sort_group_direction"></span></button><div class="c-excel-filter-combo"><input id="stockpile_content_filter_group" class="text c-excel-header__filter" placeholder="All" aria-label="Filter Type" aria-controls="stockpile_content_filter_group_options" aria-expanded="false"/><button id="stockpile_content_filter_group_toggle" class="c-excel-filter-combo__toggle" aria-label="Show Type values" aria-controls="stockpile_content_filter_group_options" aria-expanded="false">v</button><div id="stockpile_content_filter_group_options" class="c-excel-filter-combo__options is-hidden" role="listbox"></div></div></div>
          <div class="c-stockpile-flat__item c-excel-header__cell"><button id="stockpile_content_sort_item" class="c-excel-header__sort"><span id="stockpile_content_column_item">Item</span><span id="stockpile_content_sort_item_direction"></span></button><div class="c-excel-filter-combo"><input id="stockpile_content_filter_item" class="text c-excel-header__filter" placeholder="All" aria-label="Filter Item" aria-controls="stockpile_content_filter_item_options" aria-expanded="false"/><button id="stockpile_content_filter_item_toggle" class="c-excel-filter-combo__toggle" aria-label="Show Item values" aria-controls="stockpile_content_filter_item_options" aria-expanded="false">v</button><div id="stockpile_content_filter_item_options" class="c-excel-filter-combo__options is-hidden" role="listbox"></div></div></div>
          <div class="c-stockpile-flat__material c-excel-header__cell"><button id="stockpile_content_sort_material" class="c-excel-header__sort"><span id="stockpile_content_column_material">Material</span><span id="stockpile_content_sort_material_direction"></span></button><div class="c-excel-filter-combo"><input id="stockpile_content_filter_material" class="text c-excel-header__filter" placeholder="All" aria-label="Filter Material" aria-controls="stockpile_content_filter_material_options" aria-expanded="false"/><button id="stockpile_content_filter_material_toggle" class="c-excel-filter-combo__toggle" aria-label="Show Material values" aria-controls="stockpile_content_filter_material_options" aria-expanded="false">v</button><div id="stockpile_content_filter_material_options" class="c-excel-filter-combo__options is-hidden" role="listbox"></div></div></div>
          <div class="c-stockpile-flat__metric c-excel-header__cell"><button id="stockpile_content_sort_stock" class="c-excel-header__sort"><span>In Stock</span><span id="stockpile_content_sort_stock_direction"></span></button><div class="c-excel-filter-combo"><input id="stockpile_content_filter_stock" readonly="readonly" class="text c-excel-header__filter" placeholder="All" aria-label="Filter In Stock" aria-controls="stockpile_content_filter_stock_options" aria-expanded="false"/><button id="stockpile_content_filter_stock_toggle" class="c-excel-filter-combo__toggle" aria-label="Show In Stock values" aria-controls="stockpile_content_filter_stock_options" aria-expanded="false">v</button><div id="stockpile_content_filter_stock_options" class="c-excel-filter-combo__options is-hidden" role="listbox"></div></div></div>
          <div class="c-stockpile-flat__metric c-excel-header__cell"><button id="stockpile_content_sort_total" class="c-excel-header__sort"><span>Total</span><span id="stockpile_content_sort_total_direction"></span></button><div class="c-excel-filter-combo"><input id="stockpile_content_filter_total" readonly="readonly" class="text c-excel-header__filter" placeholder="All" aria-label="Filter Total" aria-controls="stockpile_content_filter_total_options" aria-expanded="false"/><button id="stockpile_content_filter_total_toggle" class="c-excel-filter-combo__toggle" aria-label="Show Total values" aria-controls="stockpile_content_filter_total_options" aria-expanded="false">v</button><div id="stockpile_content_filter_total_options" class="c-excel-filter-combo__options is-hidden" role="listbox"></div></div></div>
        </div>
        <div id="stockpile_rows" class="c-list c-scroll-region c-m6a-list c-m6a-content-list" role="grid"></div>
      </section>
      <section id="stockpile_allow_pane" class="l-stockpile-pane l-stockpile-allow-pane" role="tabpanel" aria-labelledby="stockpile_view_allow">
        <div class="c-m6a-section-heading"><div><h3 data-l10n="management.stockpile.allowed_contents">Allow list</h3><p class="c-m6a-help" data-l10n="management.stockpile.allowed_contents_help">Choose what this stockpile accepts.</p></div><span id="stockpile_filter_count" class="c-m6a-count"></span></div>
        <div class="c-stockpile-template-toolbar">
          <span class="c-stockpile-template-label" data-l10n="management.stockpile.template_label">Template</span>
          <div class="c-stockpile-template-combo">
            <input id="stockpile_template_name" class="text" type="text" maxlength="48" placeholder="New or saved template" data-l10n-placeholder="management.stockpile.template_placeholder" role="combobox" aria-autocomplete="list" aria-controls="stockpile_template_options" aria-expanded="false" />
            <button id="stockpile_template_toggle" class="c-button c-stockpile-template-toggle" type="button" aria-label="Show saved templates" aria-controls="stockpile_template_options" aria-expanded="false">v</button>
            <div id="stockpile_template_options" class="c-stockpile-template-options is-hidden" role="listbox" aria-label="Saved allow-list templates"></div>
          </div>
          <button id="stockpile_template_save" class="c-button" type="button" data-l10n="management.stockpile.template_save_new">Save new</button>
        </div>
        <div id="stockpile_filter_column_head" class="c-stockpile-table-header c-stockpile-filter-header c-stockpile-flat-header c-excel-header" role="row">
          <div class="c-stockpile-flat__category c-excel-header__cell"><button id="stockpile_allow_sort_category" class="c-excel-header__sort"><span id="stockpile_filter_column_category">Category</span><span id="stockpile_allow_sort_category_direction"></span></button><div class="c-excel-filter-combo"><input id="stockpile_allow_filter_category" class="text c-excel-header__filter" placeholder="All" aria-label="Filter Category" aria-controls="stockpile_allow_filter_category_options" aria-expanded="false"/><button id="stockpile_allow_filter_category_toggle" class="c-excel-filter-combo__toggle" aria-label="Show Category values" aria-controls="stockpile_allow_filter_category_options" aria-expanded="false">v</button><div id="stockpile_allow_filter_category_options" class="c-excel-filter-combo__options is-hidden" role="listbox"></div></div></div>
          <div class="c-stockpile-flat__group c-excel-header__cell"><button id="stockpile_allow_sort_group" class="c-excel-header__sort"><span id="stockpile_filter_column_group">Type</span><span id="stockpile_allow_sort_group_direction"></span></button><div class="c-excel-filter-combo"><input id="stockpile_allow_filter_group" class="text c-excel-header__filter" placeholder="All" aria-label="Filter Type" aria-controls="stockpile_allow_filter_group_options" aria-expanded="false"/><button id="stockpile_allow_filter_group_toggle" class="c-excel-filter-combo__toggle" aria-label="Show Type values" aria-controls="stockpile_allow_filter_group_options" aria-expanded="false">v</button><div id="stockpile_allow_filter_group_options" class="c-excel-filter-combo__options is-hidden" role="listbox"></div></div></div>
          <div class="c-stockpile-flat__item c-excel-header__cell"><button id="stockpile_allow_sort_item" class="c-excel-header__sort"><span id="stockpile_filter_column_item">Item</span><span id="stockpile_allow_sort_item_direction"></span></button><div class="c-excel-filter-combo"><input id="stockpile_allow_filter_item" class="text c-excel-header__filter" placeholder="All" aria-label="Filter Item" aria-controls="stockpile_allow_filter_item_options" aria-expanded="false"/><button id="stockpile_allow_filter_item_toggle" class="c-excel-filter-combo__toggle" aria-label="Show Item values" aria-controls="stockpile_allow_filter_item_options" aria-expanded="false">v</button><div id="stockpile_allow_filter_item_options" class="c-excel-filter-combo__options is-hidden" role="listbox"></div></div></div>
          <div class="c-stockpile-flat__material c-excel-header__cell"><button id="stockpile_allow_sort_material" class="c-excel-header__sort"><span id="stockpile_filter_column_material">Material</span><span id="stockpile_allow_sort_material_direction"></span></button><div class="c-excel-filter-combo"><input id="stockpile_allow_filter_material" class="text c-excel-header__filter" placeholder="All" aria-label="Filter Material" aria-controls="stockpile_allow_filter_material_options" aria-expanded="false"/><button id="stockpile_allow_filter_material_toggle" class="c-excel-filter-combo__toggle" aria-label="Show Material values" aria-controls="stockpile_allow_filter_material_options" aria-expanded="false">v</button><div id="stockpile_allow_filter_material_options" class="c-excel-filter-combo__options is-hidden" role="listbox"></div></div></div>
          <div class="c-stockpile-flat__status c-excel-header__cell"><button id="stockpile_allow_sort_status" class="c-excel-header__sort"><span>Status</span><span id="stockpile_allow_sort_status_direction"></span></button><div class="c-excel-filter-combo"><input id="stockpile_allow_filter_status" class="text c-excel-header__filter" placeholder="All" aria-label="Filter Status" aria-controls="stockpile_allow_filter_status_options" aria-expanded="false"/><button id="stockpile_allow_filter_status_toggle" class="c-excel-filter-combo__toggle" aria-label="Show Status values" aria-controls="stockpile_allow_filter_status_options" aria-expanded="false">v</button><div id="stockpile_allow_filter_status_options" class="c-excel-filter-combo__options is-hidden" role="listbox"></div></div></div>
        </div>
        <div id="stockpile_filters" class="c-list c-scroll-region c-m6a-list c-m6a-filter-list" role="grid"></div>
        <div class="c-stockpile-filter-toolbar"><button id="stockpile_allow_bulk" class="c-button l-stockpile-rail-button c-stockpile-bulk-button" data-l10n="management.stockpile.allow_matches">Allow matches</button><button id="stockpile_block_bulk" class="c-button l-stockpile-rail-button c-stockpile-bulk-button" data-l10n="management.stockpile.block_matches">Block matches</button><button id="stockpile_restore_filter_search" class="c-button l-stockpile-rail-button c-stockpile-bulk-button is-hidden" data-l10n="management.stockpile.restore_rule_search">Back to rule search</button></div>
      </section>
    </div>
      </div>
    </div>

  </main>
  <div id="stockpile_template_confirmation" class="c-m6a-blocker c-stockpile-template-confirmation is-hidden" role="alertdialog" aria-modal="true" aria-labelledby="stockpile_template_confirmation_title">
    <section class="c-m6a-dialog">
      <h3 id="stockpile_template_confirmation_title" data-l10n="management.stockpile.template_overwrite_title">Overwrite template?</h3>
      <p data-l10n="management.stockpile.template_overwrite_body">This replaces the saved allow list in the selected template:</p>
      <p class="c-stockpile-template-confirmation-name"><strong id="stockpile_template_overwrite_name"></strong></p>
      <div class="l-m6a-actions"><button id="stockpile_template_overwrite_confirm" class="c-button c-button--danger" data-l10n="management.stockpile.template_overwrite_confirm">Overwrite</button><button id="stockpile_template_overwrite_cancel" class="c-button" data-l10n="common.cancel">Cancel</button></div>
    </section>
  </div>
  <div id="stockpile_tooltip" class="c-tooltip c-stockpile-tooltip" role="tooltip" aria-hidden="true"></div>
  </template>
</body></rml>
