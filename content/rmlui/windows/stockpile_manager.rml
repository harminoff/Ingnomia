<rml>
<head><link type="text/rcss" href="../styles/base.rcss"/><link type="text/rcss" href="../styles/components.rcss"/><link type="text/rcss" href="../styles/accessibility.rcss"/><link type="text/rcss" href="../screens/management6a.rcss"/></head>
<body id="stockpile_manager_root" class="l-m6a-root is-hidden">
  <section id="stockpile_workbench" class="l-m6a-panel l-stockpile-panel">
    <header class="l-m6a-title">
      <handle class="l-m6a-drag-handle" move_target="stockpile_workbench" edge_margin="76dp 12dp 58dp 12dp"><div class="l-m6a-title__copy"><small data-l10n="management.stockpile.storage_management">Storage management</small><h2 id="stockpile_title" data-l10n="management.stockpile.stockpile_title">Stockpile</h2></div></handle>
      <button id="stockpile_locate" class="c-button" data-l10n="management.stockpile.stockpile_locate">Locate</button><button id="stockpile_refresh" class="c-button" data-l10n="management.stockpile.stockpile_refresh">Refresh</button><button id="stockpile_close" class="c-button" data-l10n="management.stockpile.stockpile_close">Close</button>
    </header>
    <div class="l-stockpile-settings">
      <label class="c-stockpile-field c-stockpile-name"><span data-l10n="management.stockpile.name_label">Name</span><input id="stockpile_name" class="text" type="text" value="" /></label>
      <label class="c-stockpile-field c-stockpile-priority"><span data-l10n="management.stockpile.priority_label">Priority</span><span class="c-stockpile-priority-stepper"><button id="stockpile_priority_up" class="c-stockpile-priority-button" type="button" aria-describedby="stockpile_tooltip" aria-label="Raise priority" title="Raise priority">^</button><input id="stockpile_priority" class="text" type="number" value="1" min="1" step="1" inputmode="numeric" title="1 is highest" /><button id="stockpile_priority_down" class="c-stockpile-priority-button" type="button" aria-describedby="stockpile_tooltip" aria-label="Lower priority" title="Lower priority">v</button></span></label>
      <button id="stockpile_apply_basics" class="c-button" data-l10n="management.stockpile.stockpile_apply_basics">Apply</button><button id="stockpile_toggle_suspended" class="c-check-button is-unchecked" aria-describedby="stockpile_tooltip" data-l10n="management.stockpile.stockpile_toggle_suspended">Suspend</button><p id="stockpile_summary" class="c-stockpile-summary"></p>
    </div>
    <div class="l-stockpile-hauling"><button id="stockpile_hauling_toggle" class="c-disclosure-button" aria-expanded="false"><span id="stockpile_hauling_disclosure" class="c-stockpile-disclosure">&gt;</span><span data-l10n="management.stockpile.hauling_options">Hauling options</span></button><div id="stockpile_hauling_options" class="is-hidden"><button id="stockpile_toggle_pull" class="c-check-button is-unchecked" aria-describedby="stockpile_tooltip">Take from lower-priority stockpiles</button><button id="stockpile_toggle_allow_pull" class="c-check-button is-unchecked" aria-describedby="stockpile_tooltip">Let higher-priority stockpiles take from here</button></div></div>
    <nav class="c-tabs l-stockpile-view-tabs" role="tablist" aria-label="Stockpile views"><button id="stockpile_view_contents" class="c-button c-tabs__tab is-selected" role="tab" aria-selected="true" data-l10n="management.stockpile.view_contents">Contents</button><button id="stockpile_view_allow" class="c-button c-tabs__tab" role="tab" aria-selected="false" data-l10n="management.stockpile.view_allow">Allow list</button></nav>
    <div class="l-stockpile-state"><div id="stockpile_loading" class="c-m6a-state" data-l10n="management.stockpile.stockpile_loading">Loading stockpile data...</div><div id="stockpile_empty" class="c-m6a-state is-hidden" data-l10n="management.stockpile.stockpile_empty">No stockpile data is available.</div><div id="stockpile_error" class="c-m6a-state is-error is-hidden"></div></div>
    <div id="stockpile_content" class="l-stockpile-panes is-hidden">
      <section id="stockpile_contents_pane" class="l-stockpile-pane l-stockpile-contents-pane"><div class="c-m6a-section-heading"><div><h3 data-l10n="management.stockpile.current_contents">Contents</h3><p class="c-m6a-help" data-l10n="management.stockpile.current_contents_help">What is physically stored here.</p></div><span id="stockpile_content_count" class="c-m6a-count"></span></div><label class="c-stockpile-search"><span data-l10n="management.stockpile.contents_search_label">Find stored items</span><input id="stockpile_content_search" class="text" type="text" placeholder="Find stored items..." data-l10n-placeholder="management.stockpile.contents_search.placeholder" /></label><div class="c-stockpile-table-header"><button id="stockpile_content_sort_item" class="c-sort-button" data-l10n="management.stockpile.item_header">Item</button><span data-l10n="management.stockpile.material_header">Material</span><button id="stockpile_content_sort_qty" class="c-sort-button" data-l10n="management.stockpile.qty_header">Qty</button><span data-l10n="management.stockpile.rule_header">Rule</span></div><div id="stockpile_rows" class="c-m6a-list c-m6a-content-list"></div><p id="stockpile_content_selection" class="c-m6a-selection"></p></section>
      <section id="stockpile_allow_pane" class="l-stockpile-pane l-stockpile-allow-pane"><div class="c-m6a-section-heading"><div><h3 data-l10n="management.stockpile.allowed_contents">Allow list</h3><p class="c-m6a-help" data-l10n="management.stockpile.allowed_contents_help">Choose what this stockpile accepts.</p></div><span id="stockpile_filter_count" class="c-m6a-count"></span></div><label class="c-stockpile-search"><span data-l10n="management.stockpile.rules_search_label">Find rules</span><input id="stockpile_filter_search" class="text" type="text" placeholder="Find item, material, or category..." data-l10n-placeholder="management.stockpile.rules_search.placeholder" /></label><div class="c-stockpile-bulk"><span id="stockpile_bulk_caption" class="c-m6a-selection"></span><button id="stockpile_allow_bulk" class="c-button" data-l10n="management.stockpile.allow_matches">Allow matches</button><button id="stockpile_block_bulk" class="c-button" data-l10n="management.stockpile.block_matches">Block matches</button><button id="stockpile_restore_filter_search" class="c-button is-hidden" data-l10n="management.stockpile.restore_rule_search">Back to rule search</button></div><div id="stockpile_filters" class="c-m6a-list c-m6a-filter-list"></div><p id="stockpile_filter_selection" class="c-m6a-selection"></p><p id="stockpile_nothing_allowed" class="c-stockpile-empty-hint is-hidden" data-l10n="management.stockpile.nothing_allowed">Nothing allowed. Enable a category or item to accept deliveries.</p></section>
    </div>
    <p id="stockpile_status" class="c-m6a-status"></p><span class="c-window__resize-grip" aria-hidden="true"></span>
  </section>
  <div id="stockpile_tooltip" class="c-tooltip c-stockpile-tooltip" role="tooltip" aria-hidden="true"></div>
</body></rml>
