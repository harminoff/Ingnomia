<rml>
<head><title>Stockpile</title><link type="text/template" href="/templates/management_window.rml"/><link type="text/rcss" href="../screens/management6a.rcss"/><link type="text/rcss" href="/screens/win98_classic.rcss"/><link type="text/rcss" href="/styles/accessibility.rcss"/></head>
<body id="stockpile_manager_root" class="l-m6a-root is-hidden">
<template src="management-window">
<!-- Windows 98 property sheet (252 x 218 DLU): pages never scroll; OK / Cancel / Apply apply to the whole window.
     Name, priority, the General check boxes and every Allow List check box stay pending until Apply or OK. -->
<section id="stockpile_workbench" class="c-window l-m6a-panel w98-sheet">
  <header class="w98-caption"><handle class="c-title-bar__drag-handle l-m6a-drag-handle" move_target="stockpile_workbench"><h2 id="stockpile_title" class="c-title-bar__title"></h2></handle><button id="stockpile_close" class="w98-caption__close" title="Close" data-l10n-title="win98.stockpile.close.title" aria-label="Close">&#x00D7;</button></header>
  <div class="w98-sheet__body">
    <nav id="stockpile_tabs" class="c-tabs c-connected-tabs w98-tabs" role="tablist"><button id="stockpile_view_contents" class="c-tabs__tab" role="tab" aria-controls="stockpile_contents_pane" data-l10n="win98.stockpile.view_contents">Contents</button><button id="stockpile_view_allow" class="c-tabs__tab" role="tab" aria-controls="stockpile_allow_pane" data-l10n="win98.stockpile.view_allow">Allow List</button><button id="stockpile_view_settings" class="c-tabs__tab" role="tab" aria-controls="stockpile_settings_pane" data-l10n="win98.stockpile.view_settings">General</button></nav>
    <div id="stockpile_scroll" class="w98-page-frame">
      <p id="stockpile_loading" class="w98-text" data-l10n="win98.stockpile.loading">Loading stockpile data...</p><p id="stockpile_empty" class="w98-text is-hidden" data-l10n="win98.stockpile.empty">No stockpile data is available.</p><p id="stockpile_error" class="w98-text is-hidden"></p>
      <div id="stockpile_content" class="w98-page is-hidden">

        <section id="stockpile_contents_pane" class="w98-page w98-col" role="tabpanel" aria-labelledby="stockpile_view_contents">
          <div class="w98-line"><label class="w98-label" for="stockpile_content_search" data-l10n="win98.stockpile.content_search">Find:</label><input id="stockpile_content_search" class="w98-field l-sp-find" type="text"/><label class="w98-label" for="stockpile_content_category" data-l10n="win98.stockpile.content_category">Category:</label><select id="stockpile_content_category" class="w98-select l-sp-category"><option value="" data-l10n="win98.stockpile.all">(All)</option></select></div>
          <div class="w98-gap"></div>
          <label class="w98-label" for="stockpile_rows" data-l10n="win98.stockpile.rows">Items stored here:</label>
          <div class="w98-listview w98-grow"><div class="w98-listview__header"><button id="stockpile_content_sort_item" class="w98-listview__heading w98-cell--grow">Item<span id="stockpile_content_mark_item" class="w98-sort-mark"></span></button><button id="stockpile_content_sort_material" class="w98-listview__heading l-sp-w-material">Material<span id="stockpile_content_mark_material" class="w98-sort-mark is-hidden"></span></button><button id="stockpile_content_sort_stock" class="w98-listview__heading l-sp-w-number">Stored<span id="stockpile_content_mark_stock" class="w98-sort-mark is-hidden"></span></button><button id="stockpile_content_sort_total" class="w98-listview__heading l-sp-w-number">Total<span id="stockpile_content_mark_total" class="w98-sort-mark is-hidden"></span></button></div><div id="stockpile_rows" class="w98-list" role="listbox" tab-index="0" aria-label="Items stored here"></div></div>
          <div class="w98-gap"></div>
          <p id="stockpile_content_status" class="w98-text"></p>
        </section>

        <section id="stockpile_allow_pane" class="w98-page w98-col is-hidden" role="tabpanel" aria-labelledby="stockpile_view_allow">
          <div class="w98-line"><label class="w98-label" for="stockpile_allow_search" data-l10n="win98.stockpile.allow_search">Find:</label><input id="stockpile_allow_search" class="w98-field l-sp-find" type="text"/><label class="w98-label" for="stockpile_allow_category" data-l10n="win98.stockpile.allow_category">Category:</label><select id="stockpile_allow_category" class="w98-select l-sp-category"><option value="" data-l10n="win98.stockpile.all">(All)</option></select></div>
          <div class="w98-gap"></div>
          <label class="w98-label" for="stockpile_filters" data-l10n="win98.stockpile.filters">Items this stockpile accepts:</label>
          <div class="w98-listview w98-grow"><div class="w98-listview__header"><button id="stockpile_allow_sort_item" class="w98-listview__heading w98-cell--grow">Item<span id="stockpile_allow_mark_item" class="w98-sort-mark"></span></button><button id="stockpile_allow_sort_material" class="w98-listview__heading l-sp-w-material">Material<span id="stockpile_allow_mark_material" class="w98-sort-mark is-hidden"></span></button><button id="stockpile_allow_sort_group" class="w98-listview__heading l-sp-w-type">Type<span id="stockpile_allow_mark_group" class="w98-sort-mark is-hidden"></span></button></div><div id="stockpile_filters" class="w98-list" role="listbox" aria-multiselectable="true" tab-index="0" aria-label="Items this stockpile accepts"></div></div>
          <div class="w98-gap"></div>
          <div class="w98-line"><p id="stockpile_rule_scope" class="w98-text w98-grow"></p><button id="stockpile_allow_bulk" class="w98-button" data-l10n="win98.stockpile.allow_bulk">Allow All</button><button id="stockpile_block_bulk" class="w98-button" data-l10n="win98.stockpile.block_bulk">Block All</button></div>
          <div class="w98-gap"></div>
          <div class="w98-line"><label class="w98-label" for="stockpile_template_name" data-l10n="win98.stockpile.template_name">Template:</label><div class="w98-combo w98-grow"><input id="stockpile_template_name" class="w98-combo__field" type="text" maxlength="48" role="combobox" aria-autocomplete="list" aria-controls="stockpile_template_options" aria-expanded="false"/><button id="stockpile_template_toggle" class="w98-combo__arrow" type="button" title="Saved templates" data-l10n-title="win98.stockpile.template_toggle.title" aria-label="Saved templates" aria-controls="stockpile_template_options" aria-expanded="false"></button></div><button id="stockpile_template_load" class="w98-button" data-l10n="win98.stockpile.template_load">Load</button><button id="stockpile_template_save" class="w98-button" data-l10n="win98.stockpile.template_save">Save</button></div>
          <p id="stockpile_template_note" class="w98-text"></p>
        </section>

        <section id="stockpile_settings_pane" class="w98-page w98-col is-hidden" role="tabpanel" aria-labelledby="stockpile_view_settings">
          <div class="w98-line"><label class="w98-label" for="stockpile_name" data-l10n="win98.stockpile.name">Name:</label><input id="stockpile_name" class="w98-field w98-field--wide" type="text"/></div>
          <div class="w98-gap"></div>
          <div class="w98-line"><label class="w98-label" for="stockpile_priority" data-l10n="win98.stockpile.priority">Priority:</label><div class="c-numeric-editor w98-spin"><input id="stockpile_priority" class="w98-field c-numeric-editor__input" type="text" value="1" min="1" step="1" inputmode="numeric" aria-describedby="stockpile_priority-error"/><div class="c-numeric-editor__arrows"><button id="stockpile_priority_up" class="c-numeric-editor__up" aria-label="Raise priority" title="Raise priority" data-l10n-title="win98.stockpile.priority_up.title"/><button id="stockpile_priority_down" class="c-numeric-editor__down" aria-label="Lower priority" title="Lower priority" data-l10n-title="win98.stockpile.priority_down.title"/></div></div><span id="stockpile_priority-error" class="c-field__error u-hidden" role="status"/><p class="w98-text" data-l10n="win98.stockpile.1_is_the_highest_priority">(1 is the highest priority)</p></div>
          <div class="w98-separator"></div>
          <div class="w98-group"><span class="w98-group__title" data-l10n="win98.stockpile.hauling">Hauling</span>
            <label class="w98-check" for="stockpile_toggle_pull"><input id="stockpile_toggle_pull" class="checkbox" type="checkbox"/><span data-l10n="win98.stockpile.toggle_pull">Take items from lower-priority stockpiles</span></label>
            <label class="w98-check" for="stockpile_toggle_allow_pull"><input id="stockpile_toggle_allow_pull" class="checkbox" type="checkbox"/><span data-l10n="win98.stockpile.toggle_allow_pull">Let higher-priority stockpiles take items from here</span></label>
          </div>
          <div class="w98-group"><span class="w98-group__title" data-l10n="win98.stockpile.status">Status</span>
            <div class="w98-line"><label class="w98-check w98-grow" for="stockpile_toggle_suspended"><input id="stockpile_toggle_suspended" class="checkbox" type="checkbox"/><span data-l10n="win98.stockpile.toggle_suspended">Suspend deliveries</span></label><button id="stockpile_locate" class="w98-button" data-l10n="win98.stockpile.locate">Center on Map</button></div>
          </div>
          <div class="w98-gap w98-gap--wide"></div>
          <p id="stockpile_summary" class="w98-text"></p>
        </section>

      </div>
    </div>
    <div class="w98-buttonbar"><button id="stockpile_ok" class="w98-button w98-button--default" data-l10n="win98.common.ok">OK</button><button id="stockpile_cancel" class="w98-button" data-l10n="win98.common.cancel">Cancel</button><button id="stockpile_apply" class="w98-button" data-l10n="win98.common.apply">Apply</button></div>
  </div>
  <div id="stockpile_template_options" class="w98-combo__list is-hidden" role="listbox" aria-label="Saved templates"></div>
</section>
</template>
</body></rml>
