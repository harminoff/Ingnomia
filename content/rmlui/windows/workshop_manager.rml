<rml>
<head><link type="text/rcss" href="../styles/base.rcss"/><link type="text/rcss" href="../styles/components.rcss"/><link type="text/rcss" href="../styles/accessibility.rcss"/><link type="text/rcss" href="../screens/management6a.rcss"/></head>
<body id="workshop_manager_root" class="l-m6a-root is-hidden">
<section id="workshop_workbench" class="l-m6a-panel">
  <header class="l-m6a-title"><handle class="l-m6a-drag-handle" move_target="workshop_workbench" edge_margin="76dp 12dp 58dp 12dp"><div class="l-m6a-title__copy"><small id="workshop_subtype" data-l10n="management.workshop.workshop_subtype">Production</small><h2 id="workshop_title" data-l10n="management.workshop.workshop_title">Workshop</h2></div></handle><button id="workshop_locate" class="c-button" data-l10n="management.workshop.workshop_locate">Locate</button><button id="workshop_close" class="c-button" data-l10n="management.workshop.workshop_close">Close</button></header>
  <div class="l-m6a-toolbar"><input id="workshop_search" class="text" type="text" value=""  placeholder="Filter loaded crafts and queue" data-l10n-placeholder="management.workshop.workshop_search.placeholder"/><button id="workshop_sort" class="c-dropdown-button" data-l10n="management.workshop.workshop_sort">Sort A-Z v</button><button id="workshop_page_previous" class="c-button" data-l10n="management.workshop.workshop_page_previous">Previous rows</button><button id="workshop_page_next" class="c-button" data-l10n="management.workshop.workshop_page_next">Next rows</button><button id="workshop_refresh" class="c-button" data-l10n="management.workshop.workshop_refresh">Refresh</button></div>
  <div id="workshop_scroll" class="l-m6a-scroll">
    <div id="workshop_loading" class="c-m6a-state" data-l10n="management.workshop.workshop_loading">Loading workshop data...</div><div id="workshop_empty" class="c-m6a-state is-hidden" data-l10n="management.workshop.workshop_empty">No craft products or queued jobs are available for this workshop.</div><div id="workshop_error" class="c-m6a-state is-error is-hidden"></div>
    <section id="workshop_content" class="is-hidden">
      <div class="l-m6a-section"><h3 data-l10n="management.workshop.workshop_controls">Workshop controls</h3><div class="l-m6a-grid"><input id="workshop_name" class="text" type="text" value=""/><input id="workshop_priority" class="text" type="number" value="1" min="1"/></div><p id="workshop_summary"></p><div class="l-m6a-actions"><button id="workshop_apply_basics" class="c-button" data-l10n="management.workshop.workshop_apply_basics">Apply name and priority</button><button id="workshop_toggle_suspended" class="c-check-button is-unchecked" data-l10n="management.workshop.workshop_toggle_suspended">☐ Suspend</button><button id="workshop_toggle_generated" class="c-check-button is-unchecked" data-l10n="management.workshop.workshop_toggle_generated">☐ Accept generated</button><button id="workshop_toggle_auto_missing" class="c-check-button is-unchecked" data-l10n="management.workshop.workshop_toggle_auto_missing">☐ Auto-craft missing</button><button id="workshop_toggle_linked" class="c-check-button is-unchecked" data-l10n="management.workshop.workshop_toggle_linked">☐ Link stockpile</button></div></div>
      <section class="l-m6a-section"><h3 data-l10n="management.workshop.craft_catalog">Craft catalog</h3><p id="workshop_product_selection"></p><div id="workshop_products" class="c-m6a-list"></div><div class="l-m6a-actions"><button id="workshop_next_product" class="c-button" data-l10n="management.workshop.workshop_next_product">Next craft</button><button id="workshop_queue_once" class="c-button" data-l10n="management.workshop.workshop_queue_once">Queue one with available materials</button></div></section>
      <section class="l-m6a-section"><h3 data-l10n="management.workshop.production_queue">Production queue</h3><p id="workshop_job_selection"></p><div id="workshop_queue" class="c-m6a-list"></div><div class="l-m6a-actions"><button id="workshop_next_job" class="c-button" data-l10n="management.workshop.workshop_next_job">Next order</button><button id="workshop_toggle_job" class="c-button" data-l10n="management.workshop.workshop_toggle_job">Pause/resume order</button><button id="workshop_move_up" class="c-button" data-l10n="management.workshop.workshop_move_up">Move up</button><button id="workshop_move_down" class="c-button" data-l10n="management.workshop.workshop_move_down">Move down</button><button id="workshop_cancel_job" class="c-button c-button--danger" data-l10n="management.workshop.workshop_cancel_job">Cancel order</button></div><p class="c-m6a-warning" data-l10n="management.workshop.craft_progress_and_eta_are_intentionally_omitted">Craft progress and ETA are intentionally omitted because no accepted presentation source exists.</p></section>
      <section id="workshop_special" class="l-m6a-section"><h3 data-l10n="management.workshop.special_production">Special production</h3><div id="workshop_butcher_actions" class="l-m6a-actions is-hidden"><button id="workshop_toggle_corpses" class="c-button" data-l10n="management.workshop.workshop_toggle_corpses">Butcher corpses</button><button id="workshop_toggle_excess" class="c-button" data-l10n="management.workshop.workshop_toggle_excess">Butcher excess animals</button></div><div id="workshop_fisher_actions" class="l-m6a-actions is-hidden"><button id="workshop_toggle_catch" class="c-button" data-l10n="management.workshop.workshop_toggle_catch">Catch fish</button><button id="workshop_toggle_process" class="c-button" data-l10n="management.workshop.workshop_toggle_process">Process fish</button></div></section>
      <section id="workshop_trade" class="l-m6a-section is-hidden"><h3 data-l10n="management.workshop.trade_ledger">Trade ledger</h3><p id="workshop_trade_totals"></p><div id="workshop_trade_rows" class="c-m6a-list"></div><div class="l-m6a-actions"><button id="workshop_trade_refresh" class="c-button" data-l10n="management.workshop.workshop_trade_refresh">Refresh trade</button><button id="workshop_next_trade" class="c-button" data-l10n="management.workshop.workshop_next_trade">Next trade row</button><button id="workshop_trade_less" class="c-button" data-l10n="management.workshop.workshop_trade_less">Offer one less</button><button id="workshop_trade_more" class="c-button" data-l10n="management.workshop.workshop_trade_more">Offer one more</button><button id="workshop_trade_execute" class="c-button c-button--danger" data-l10n="management.workshop.workshop_trade_execute">Review trade</button></div></section>
    </section><p id="workshop_status" class="c-m6a-status"></p>
  </div>
</section>
<div id="workshop_trade_confirmation" class="c-m6a-blocker is-hidden"><section class="c-m6a-dialog"><h3 data-l10n="management.workshop.complete_this_trade">Complete this trade?</h3><p data-l10n="management.workshop.this_immediately_exchanges_the_displayed_offers">This immediately exchanges the displayed offers. Review both values before continuing.</p><div class="l-m6a-actions"><button id="workshop_trade_confirm" class="c-button c-button--danger" data-l10n="management.workshop.workshop_trade_confirm">Confirm irreversible trade</button><button id="workshop_trade_cancel" class="c-button" data-l10n="management.workshop.workshop_trade_cancel">Cancel</button></div></section></div>
</body></rml>
