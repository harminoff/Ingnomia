<rml>
<head><link type="text/template" href="/templates/management_window.rml"/><link type="text/rcss" href="../screens/management6a.rcss"/></head>
<body id="workshop_manager_root" class="l-m6a-root is-hidden">
<template src="management-window">
<section id="workshop_workbench" class="c-window l-m6a-panel">
  <header class="l-m6a-title"><handle class="l-m6a-drag-handle" move_target="workshop_workbench"><div class="l-m6a-title__copy"><small id="workshop_subtype">Production</small><h2 id="workshop_title">Workshop</h2></div></handle><button id="workshop_close" class="c-button" data-l10n="common.close">Close</button></header>
  <div class="l-workshop-body">
    <aside class="l-stockpile-rail"><div class="l-stockpile-rail-heading">Workshop</div><nav class="l-stockpile-view-tabs" role="tablist" aria-orientation="vertical">
      <button id="workshop_view_craft" data-l10n="management.workshop.view_craft" class="c-button l-stockpile-rail-button" role="tab">Craft</button>
      <button id="workshop_view_queue" data-l10n="management.workshop.view_queue" class="c-button l-stockpile-rail-button" role="tab">Queue</button>
      <button id="workshop_view_settings" data-l10n="management.workshop.view_settings" class="c-button l-stockpile-rail-button" role="tab">Settings</button>
      <button id="workshop_view_trade" data-l10n="management.workshop.view_trade" class="c-button l-stockpile-rail-button is-hidden" role="tab">Trade</button>
    </nav><button id="workshop_locate" data-l10n="management.workshop.locate" class="c-button l-stockpile-rail-button">Center on map</button><p id="workshop_rail_status" class="c-m6a-help"></p></aside>
    <main id="workshop_scroll" class="l-workshop-main">
      <div id="workshop_loading" class="c-m6a-state">Loading workshop data...</div><div id="workshop_empty" class="c-m6a-state is-hidden">No craft products are available.</div><div id="workshop_error" class="c-m6a-state is-error is-hidden"></div>
      <div id="workshop_content" class="is-hidden">
        <section id="workshop_craft_pane" class="l-workshop-pane" role="tabpanel" aria-labelledby="workshop_view_craft">
          <div class="l-workshop-list-pane"><h3 data-l10n="management.workshop.available_crafts">Available crafts</h3><div class="l-workshop-search"><input id="workshop_search" class="text" type="text" placeholder="Find a craft" data-l10n-placeholder="management.workshop.find_craft"/><button id="workshop_sort" class="c-button">A-Z</button></div><div id="workshop_products" class="c-list c-scroll-region c-m6a-list"></div><div class="l-workshop-pager"><button id="workshop_page_previous" data-l10n="management.workshop.previous" class="c-button">Previous</button><button id="workshop_page_next" data-l10n="management.workshop.next" class="c-button">Next</button></div></div>
          <div class="l-workshop-detail"><h3 data-l10n="management.workshop.new_order">New order</h3><div id="workshop_product_selection" class="c-workshop-editor"></div><div class="c-workshop-count-row"><label for="workshop_order_count" id="workshop_order_count_label">Quantity</label><input id="workshop_order_count" class="text" type="number" min="1" max="999" value="1"/></div><p id="workshop_order_help" class="c-m6a-help"></p><button id="workshop_queue_once" class="c-button c-workshop-add" data-l10n="management.workshop.workshop_add_order">Add order</button><p id="workshop_order_feedback" class="c-m6a-help" role="status"></p></div>
        </section>
        <section id="workshop_queue_pane" class="l-workshop-pane is-hidden" role="tabpanel" aria-labelledby="workshop_view_queue">
          <div class="l-workshop-list-pane"><h3>Production queue</h3><p class="c-m6a-help" data-l10n="management.workshop.queue_help">Orders run from top to bottom.</p><div id="workshop_queue" class="c-list c-scroll-region c-m6a-list"></div></div>
          <div id="workshop_job_editor" class="l-workshop-detail"><h3 data-l10n="management.workshop.edit_order">Edit order</h3><div id="workshop_job_selection" class="c-workshop-editor"></div><div id="workshop_job_quantity" class="c-workshop-count-row"><label for="workshop_job_count" id="workshop_job_count_label">Quantity</label><input id="workshop_job_count" class="text" type="number" min="1" max="999" value="1"/><button id="workshop_job_apply" data-l10n="management.workshop.apply" class="c-button" data-job-action="apply-count">Apply</button></div><p id="workshop_job_help" class="c-m6a-help"></p></div>
        </section>
        <section id="workshop_settings_pane" class="l-workshop-settings is-hidden" role="tabpanel" aria-labelledby="workshop_view_settings">
          <div class="c-m6a-section-heading"><div><h3>Workshop settings</h3><p class="c-m6a-help">Set the name and production priority.</p></div></div>
          <div class="l-stockpile-settings">
            <label class="c-stockpile-field c-stockpile-name"><span>Name</span><input id="workshop_name" class="text" type="text" /></label>
            <div class="c-stockpile-field c-stockpile-priority"><label for="workshop_priority">Priority</label><span class="c-stockpile-priority-stepper"><button id="workshop_priority_up" class="c-stockpile-priority-button" title="Raise priority">^</button><input id="workshop_priority" class="text" type="text" value="1" title="1 is highest"/><button id="workshop_priority_down" class="c-stockpile-priority-button" title="Lower priority">v</button></span></div>
            <button id="workshop_apply_basics" class="c-button">Apply</button><p id="workshop_summary" class="c-stockpile-summary"></p>
          </div>
          <div class="c-m6a-section-heading"><div><h3>Production options</h3><p class="c-m6a-help">Control automatic orders and material storage.</p></div></div>
          <div class="l-workshop-options">
            <label class="c-stockpile-checkbox" for="workshop_toggle_generated"><input id="workshop_toggle_generated" class="checkbox" type="checkbox"/><span>Accept generated orders</span></label>
            <label class="c-stockpile-checkbox" for="workshop_toggle_auto_missing"><input id="workshop_toggle_auto_missing" class="checkbox" type="checkbox"/><span>Auto-craft missing components</span></label>
          </div>
          <div class="c-m6a-section-heading"><div><h3>Linked stockpiles</h3><p class="c-m6a-help">Materials are collected from linked stockpiles nearest to this workshop first, then from other locations.</p></div></div>
          <div class="l-workshop-options">
            <div class="c-workshop-link-picker"><select id="workshop_stockpile_choice"/><button id="workshop_link_add" class="c-button">Link</button></div>
            <div id="workshop_linked_stockpiles" class="c-workshop-links"></div>
            <p id="workshop_link_help" class="c-m6a-help"></p>
          </div>
          <div class="c-m6a-section-heading"><div><h3>Workshop status</h3><p class="c-m6a-help">Pause or resume production at this workshop.</p></div></div>
          <div class="l-workshop-options"><button id="workshop_toggle_suspended" class="c-button">Suspend</button></div>
      <section id="workshop_special" class="l-m6a-section"><h3 data-l10n="management.workshop.special_production">Special production</h3><div id="workshop_butcher_actions" class="l-m6a-actions is-hidden"><button id="workshop_toggle_corpses" class="c-button" data-l10n="management.workshop.workshop_toggle_corpses">Butcher corpses</button><button id="workshop_toggle_excess" class="c-button" data-l10n="management.workshop.workshop_toggle_excess">Butcher excess animals</button></div><div id="workshop_fisher_actions" class="l-m6a-actions is-hidden"><button id="workshop_toggle_catch" class="c-button" data-l10n="management.workshop.workshop_toggle_catch">Catch fish</button><button id="workshop_toggle_process" class="c-button" data-l10n="management.workshop.workshop_toggle_process">Process fish</button></div></section>
        </section>
        <section id="workshop_trade_pane" class="l-workshop-settings is-hidden" role="tabpanel" aria-labelledby="workshop_view_trade">
      <section id="workshop_trade" class="l-m6a-section is-hidden"><h3 data-l10n="management.workshop.trade_ledger">Trade ledger</h3><p id="workshop_trade_totals"></p><div id="workshop_trade_rows" class="c-m6a-list"></div><div class="l-m6a-actions"><button id="workshop_trade_refresh" class="c-button" data-l10n="management.workshop.workshop_trade_refresh">Refresh trade</button><button id="workshop_next_trade" class="c-button" data-l10n="management.workshop.workshop_next_trade">Next trade row</button><button id="workshop_trade_less" class="c-button" data-l10n="management.workshop.workshop_trade_less">Offer one less</button><button id="workshop_trade_more" class="c-button" data-l10n="management.workshop.workshop_trade_more">Offer one more</button><button id="workshop_trade_execute" class="c-button c-button--danger" data-l10n="management.workshop.workshop_trade_execute">Review trade</button></div></section>
        </section>
      </div><p id="workshop_status" class="c-m6a-status"></p>
    </main>
  </div><span class="c-window__resize-grip" aria-hidden="true"></span>
</section>
<div id="workshop_trade_confirmation" class="c-m6a-blocker is-hidden"><section class="c-m6a-dialog"><h3 data-l10n="management.workshop.complete_this_trade">Complete this trade?</h3><p data-l10n="management.workshop.this_immediately_exchanges_the_displayed_offers">This immediately exchanges the displayed offers. Review both values before continuing.</p><div class="l-m6a-actions"><button id="workshop_trade_confirm" class="c-button c-button--danger" data-l10n="management.workshop.workshop_trade_confirm">Confirm irreversible trade</button><button id="workshop_trade_cancel" class="c-button" data-l10n="management.workshop.workshop_trade_cancel">Cancel</button></div></section></div>
</template>
</body></rml>
