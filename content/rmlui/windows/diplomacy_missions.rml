<rml>
<head>
  <title data-l10n="management.diplomacy.window_title">Diplomacy</title>
  <link type="text/template" href="/templates/management_window.rml" />
  <link type="text/rcss" href="/windows/management6c.rcss" />
</head>
<body id="diplomacy_root" class="m6c-root is-hidden">
  <template src="management-window">
  <div id="diplomacy_workbench" class="c-window m6c-workbench">
    <div class="c-title-bar">
      <handle class="c-title-bar__drag-handle" move_target="diplomacy_workbench" edge_margin="64dp 12dp 52dp 12dp"><div class="c-title-bar__mark"></div>
      <h1 class="c-title-bar__title" data-l10n="management.diplomacy.window_title">Diplomacy</h1></handle>
      <button id="diplomacy_close" class="c-button" data-l10n="management.diplomacy.close">Close</button>
    </div>
    <div id="diplomacy_body" class="c-window__body m6c-body">
      <div id="diplomacy_shell" class="c-management-shell">
        <aside id="diplomacy_rail" class="c-management-rail" aria-label="Diplomacy views" data-l10n-aria-label="management.diplomacy.views_label"><span class="c-management-rail__heading" data-l10n="management.navigation.views">Views</span>
          <nav id="diplomacy_tabs" class="c-management-rail__nav" role="tablist" aria-label="Diplomacy views" aria-orientation="vertical">
            <button id="diplomacy_tab_squads" class="c-button c-management-rail__button is-hidden" role="tab" aria-selected="false" data-l10n="management.military.squads">Squads</button><button id="diplomacy_tab_roles" class="c-button c-management-rail__button is-hidden" role="tab" aria-selected="false" data-l10n="management.military.roles_uniforms">Roles &amp; Uniforms</button><button id="diplomacy_tab_priorities" class="c-button c-management-rail__button is-hidden" role="tab" aria-selected="false" data-l10n="management.military.target_priorities">Target priorities</button><button id="diplomacy_tab_neighbors" class="c-button c-management-rail__button" role="tab" aria-selected="false" data-l10n="management.diplomacy.neighbors" title="Review discovered neighbors and prepare a mission." data-l10n-title="management.diplomacy.neighbors_help">Neighbors</button><button id="diplomacy_tab_missions" class="c-button c-management-rail__button" role="tab" aria-selected="false" data-l10n="management.diplomacy.mission_activity" title="Review active and completed mission details." data-l10n-title="management.diplomacy.missions_help">Missions</button>
          </nav>
        </aside>
        <div class="c-management-main"><button id="diplomacy_views_toggle" class="c-button c-management-views-toggle" aria-expanded="false" title="Open the Diplomacy views menu" data-l10n-title="management.diplomacy.views_help">Views: Neighbors</button>

      <button id="diplomacy_back" class="c-button m6c-back" data-l10n="management.military.back">Back to list</button>
      <div id="diplomacy_loading" class="c-state-panel is-hidden"><h2 data-l10n="management.diplomacy.loading_title">Loading neighbors and missions</h2></div>
      <div id="diplomacy_empty" class="c-state-panel m6c-empty is-hidden"><h2 id="diplomacy_empty_title"></h2><p id="diplomacy_empty_detail"></p><button data-l10n="management.diplomacy.go_neighbors" id="diplomacy_empty_neighbors" class="c-button">Go to Neighbors</button></div>
      <div id="diplomacy_error" class="c-state-panel is-hidden"><h2 data-l10n="management.diplomacy.error_title">Diplomacy data unavailable</h2><button data-l10n="management.diplomacy.retry" id="diplomacy_error_retry" class="c-button">Retry</button></div>
      <div id="diplomacy_main" class="m6c-layout is-hidden">
        <section class="m6c-list-pane"><div class="m6c-actions m6c-add-actions"><button id="diplomacy_list_tools" class="c-button m6c-filter-toggle" data-l10n="management.flow.list_tools">Filter / sort</button></div>
          <div id="diplomacy_primary_toolbar" class="m6c-primary-toolbar">
      <label class="m6c-search-field"><span data-l10n="common.search">Search</span><input id="diplomacy_search" class="text m6c-search" type="text" data-l10n-placeholder="management.diplomacy.search_placeholder" /></label>
      <div class="m6c-actions"><button data-l10n="management.military.sort" id="diplomacy_sort_source" class="c-button">Sort: original order</button><button data-l10n="management.military.refresh" id="diplomacy_refresh" class="c-button">Refresh</button></div>
    </div>
          <p id="diplomacy_selection_status" class="m6c-status is-hidden"></p>
          <div id="diplomacy_neighbor_rows" class="c-list m6c-scroll m6c-rail-rows"></div>
          <div id="diplomacy_mission_rows" class="c-list m6c-scroll m6c-rail-rows is-hidden"></div>
        </section>
        <section id="diplomacy_neighbor_detail" class="m6c-detail-pane">
          <h2 id="neighbor_name"></h2>
          <div id="neighbor_discovered_detail">
<div class="m6c-field"><span class="m6c-field__label"><span data-l10n="management.diplomacy.distance">Distance</span></span><span id="neighbor_distance" class="m6c-field__value"></span></div>
<div class="m6c-field"><span class="m6c-field__label"><span data-l10n="management.diplomacy.attitude">Attitude</span></span><span id="neighbor_attitude" class="m6c-field__value"></span></div>
<div class="m6c-field"><span class="m6c-field__label"><span data-l10n="management.diplomacy.wealth">Wealth</span></span><span id="neighbor_wealth" class="m6c-field__value"></span></div>
<div class="m6c-field"><span class="m6c-field__label"><span data-l10n="management.diplomacy.economy">Economy</span></span><span id="neighbor_economy" class="m6c-field__value"></span></div>
<div class="m6c-field"><span class="m6c-field__label"><span data-l10n="management.diplomacy.military">Military</span></span><span id="neighbor_military" class="m6c-field__value"></span></div>
</div>
          <div id="neighbor_undiscovered_detail" class="c-state-panel is-hidden"><h3 data-l10n="management.diplomacy.undiscovered_neighbor">Undiscovered neighbor</h3><p data-l10n="management.diplomacy.discovery_help">Discover this kingdom to see its details and send missions.</p></div>
          <div id="mission_builder" class="m6c-section is-hidden">
            <h3 data-l10n="management.diplomacy.start_supported_mission">New mission</h3>
            <div class="m6c-actions" id="mission_type_group"><button data-l10n="management.diplomacy.spy" id="mission_type_spy" class="c-button">Spy</button><button data-l10n="management.diplomacy.emissary" id="mission_type_emissary" class="c-button">Emissary</button><button data-l10n="management.diplomacy.raid" id="mission_type_raid" class="c-button">Raid</button><button data-l10n="management.diplomacy.sabotage" id="mission_type_sabotage" class="c-button">Sabotage</button></div>
            <div id="mission_action_group" class="m6c-actions"><button data-l10n="management.diplomacy.improve_relations" id="mission_action_improve" class="c-button">Improve relations</button><button data-l10n="management.diplomacy.insult" id="mission_action_insult" class="c-button">Insult</button><button data-l10n="management.diplomacy.invite_trader" id="mission_action_trader" class="c-button">Invite trader</button><button data-l10n="management.diplomacy.invite_ambassador" id="mission_action_ambassador" class="c-button">Invite ambassador</button></div>
            <h3 data-l10n="management.diplomacy.eligible_gnome">Citizen</h3><div id="diplomacy_gnome_rows" class="c-list m6c-scroll m6c-gnome-rows"></div>
            <div class="m6c-actions"><button data-l10n="management.diplomacy.start_mission" id="mission_start" class="c-button c-button--primary">Start mission</button><button data-l10n="management.diplomacy.view_missions" id="diplomacy_view_missions" class="c-button">View missions</button></div>
          </div>
        </section>
        <section id="diplomacy_mission_detail" class="m6c-detail-pane is-hidden">
          <h2 id="mission_title"></h2>
<div class="m6c-field" id="mission_action_field"><span class="m6c-field__label"><span data-l10n="management.diplomacy.action">Action</span></span><span id="mission_action" class="m6c-field__value"></span></div>
<div class="m6c-field" id="mission_step_field"><span class="m6c-field__label"><span data-l10n="management.diplomacy.step">Status</span></span><span id="mission_step" class="m6c-field__value"></span></div>
<div class="m6c-field" id="mission_target_field"><span class="m6c-field__label"><span data-l10n="management.diplomacy.target">Destination</span></span><span id="mission_target" class="m6c-field__value"></span></div>
<div class="m6c-field" id="mission_participants_field"><span class="m6c-field__label"><span data-l10n="management.diplomacy.participants">Participants</span></span><span id="mission_participants" class="m6c-field__value"></span></div>
<div class="m6c-field" id="mission_timing_field"><span class="m6c-field__label"><span data-l10n="management.diplomacy.current_timing">Time</span></span><span id="mission_timing" class="m6c-field__value"></span></div>
<div class="m6c-field" id="mission_result_field"><span class="m6c-field__label"><span data-l10n="management.diplomacy.result_reported">Result</span></span><span id="mission_result" class="m6c-field__value"></span></div>
<div class="m6c-actions"><button data-l10n="management.diplomacy.go_neighbors" id="diplomacy_new_mission" class="c-button">Go to Neighbors</button></div>
        </section>
      </div>
      <div id="diplomacy_footer" class="m6c-footer is-hidden"><span id="diplomacy_status"></span></div>
        </div>
      </div>
    </div>
    <span class="c-window__resize-grip" aria-hidden="true"></span>
  </div>
  <div id="diplomacy_tooltip" class="c-tooltip c-management-tooltip" role="tooltip" aria-hidden="true"></div>
  </template>
</body>
</rml>
