.is-hidden { display: none; }

.m6c-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    padding: 12dp;
    background-color: transparent;
    pointer-events: none;
}

.m6c-workbench {
    position: absolute;
    right: 12dp;
    top: 64dp;
    bottom: 52dp;
    width: 94%;
    max-width: 840dp;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    pointer-events: auto;
}

.m6c-body {
    flex: 1;
    align-self: stretch;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

.m6c-workbench .c-title-bar__title { min-width: 0; }

.m6c-body .c-tabs,
.m6c-body .c-toolbar,
.m6c-layout {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
}

.m6c-tabs {
    min-height: 34dp;
    align-items: stretch;
    gap: 2dp;
    padding: 3dp 4dp 0;
    background-color: #6d7f87;
    border-width: 1dp;
    border-color: #405662;
}

.m6c-tab {
    flex: 0 0 auto;
    min-width: 108dp;
    min-height: 29dp;
    margin: 0;
    padding: 4dp 10dp;
    color: #1b344b;
    background-color: #b9c7cb;
    border-width: 2dp;
    border-top-color: #edf3f3;
    border-left-color: #edf3f3;
    border-right-color: #536b78;
    border-bottom-color: #536b78;
    border-radius: 1dp;
    font-size: 11dp;
}

.m6c-tab:hover {
    color: #142333;
    background-color: #d6e8f2;
}

.m6c-tab.is-selected {
    color: #142333;
    background-color: #f1ca4f;
    border-top-color: #fff0a2;
    border-left-color: #fff0a2;
    border-right-color: #855d19;
    border-bottom-color: #855d19;
}

.m6c-primary-toolbar {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
}

.m6c-primary-toolbar .m6c-search {
    flex: 0 0 280dp;
    width: 280dp;
    min-width: 280dp;
}

.m6c-primary-toolbar button {
    flex: 0 0 112dp;
    width: 112dp;
    min-width: 112dp;
    white-space: nowrap;
}

.m6c-layout {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    gap: 12dp;
    flex: 1;
    min-height: 0;
    overflow: hidden;
}

.m6c-list-pane {
    flex: 0 0 300dp;
    width: 300dp;
    min-width: 300dp;
    max-width: 300dp;
}

.m6c-detail-pane {
    flex: 0 0 auto;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    color: #142333;
    overflow-y: auto;
}

.m6c-detail-pane h2 { color: #142333; font-size: 19dp; line-height: 24dp; }
.m6c-detail-pane h3 { color: #24415a; }
.m6c-detail-pane .m6c-field { display: flex; flex-direction: row; align-items: baseline; min-height: 26dp; margin-bottom: 2dp; padding: 3dp 5dp; background-color: #f3f5ef; border-bottom: 1dp #b3c0c5; }
.m6c-detail-pane .m6c-field__label { color: #4d6476; font-size: 12dp; line-height: 16dp; }
.m6c-detail-pane .m6c-field__label { flex: 0 0 122dp; }
.m6c-detail-pane .m6c-field__value { display: block; width: 280dp; min-width: 280dp; color: #142333; line-height: 18dp; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.m6c-detail-pane .m6c-section { margin-top: 4dp; padding: 8dp; }
.m6c-detail-pane .m6c-section h3 { font-size: 15dp; line-height: 20dp; }
#mission_builder { position: relative; display: block; width: 408dp; min-width: 408dp; max-width: 408dp; height: 150dp; min-height: 150dp; max-height: 150dp; overflow-y: auto; margin-top: 6dp; padding: 7dp; background-color: #d9e2e5; border-width: 1dp; border-top-color: #f7faf8; border-left-color: #f7faf8; border-right-color: #718591; border-bottom-color: #718591; }
#mission_builder .c-toolbar { display: block; width: 360dp; min-width: 360dp; max-width: 360dp; padding: 2dp; }
#mission_builder .c-toolbar button { display: inline-block; width: 106dp; min-width: 106dp; min-height: 30dp; margin: 0 3dp 3dp 0; padding: 3dp 6dp; vertical-align: top; }
#mission_builder .c-dropdown-button { min-width: 106dp; background-color: #e5e9e5; border-color: #718591; }
#mission_builder .c-dropdown-button.is-selected { color: #142333; background-color: #f1ca4f; border-color: #855d19; }
#military_priority_detail .c-dropdown-button { min-width: 78dp; padding: 3dp 5dp; }
#mission_builder #mission_action_group { display: none; }
#mission_builder h3 { margin: 2dp 0 5dp; white-space: nowrap; }
#mission_builder .m6c-scroll { width: auto; max-width: 100%; max-height: 72dp; }
#mission_builder #mission_start { position: absolute; right: 8dp; bottom: 8dp; display: block; width: 132dp; }

.m6c-scroll {
    max-height: 300dp;
    overflow-y: auto;
}

.m6c-footer { flex: 0 0 auto; min-height: 30dp; margin-top: 6dp; }

.m6c-row {
    display: flex;
    width: 100%;
    min-height: 40dp;
    text-align: left;
    border-radius: 0;
}

.m6c-row__id {
    width: 80dp;
    color: #9fa4a1;
    font-size: 13dp;
}

.m6c-section {
    margin-top: 12dp;
    padding: 12dp;
    background-color: #171b1d;
    border-width: 1dp;
    border-color: #30373a;
}

.m6c-field { margin-bottom: 8dp; }
.m6c-field__label { display: block; color: #9fa4a1; font-size: 13dp; }
.m6c-field__value { display: block; color: #f1eee6; }
.m6c-search { flex: 1; min-width: 220dp; }
.m6c-status { min-height: 30dp; margin-top: 8dp; }
.m6c-hidden-selection { color: #ffd27a; }
.m6c-page-row { width: 100%; min-height: 40dp; }
.m6c-modal-layer { pointer-events: auto; }

/* This sheet is loaded after the shared component skin, so repeat the
   classic-surface overrides here rather than allowing the fixture's dark
   section defaults to leak into the released military/diplomacy windows. */
.m6c-section {
    color: #142333;
    background-color: #e5e9e5;
    border-width: 1dp;
    border-top-color: #f7faf8;
    border-left-color: #f7faf8;
    border-right-color: #718591;
    border-bottom-color: #718591;
}
.m6c-row .c-list__primary,
.m6c-row .c-list__meta {
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.m6c-row .c-list__primary { flex: 1 1 auto; }
.m6c-row .c-list__meta { flex: 0 0 auto; margin-left: 8dp; }
.m6c-scroll scrollbarvertical { width: 14dp; background-color: #d5dde0; }
.m6c-scroll scrollbarvertical track { background-color: #cbd5d9; border-left-width: 1dp; border-left-color: #718591; }
.m6c-scroll scrollbarvertical slider { min-height: 28dp; background-color: #8a9aa3; border-width: 1dp; border-top-color: #f7faf8; border-left-color: #f7faf8; border-right-color: #4d6476; border-bottom-color: #4d6476; border-radius: 0dp; }
.m6c-scroll scrollbarvertical slider:hover { background-color: #f1ca4f; }
.m6c-detail-pane input.text,
.m6c-detail-pane input[type="text"] {
    color: #142333;
    background-color: #f3f5ef;
    border-width: 2dp;
    border-top-color: #4d6476;
    border-left-color: #4d6476;
    border-right-color: #f7faf8;
    border-bottom-color: #f7faf8;
}
.m6c-detail-pane .c-state-panel {
    padding: 8dp;
    color: #2f4659;
    text-align: left;
    background-color: #e5e9e5;
    border-width: 1dp;
    border-color: #718591;
}

/* Detail panes contain compact toolbars and form sections as well as lists.
   Keep controls at readable widths instead of allowing flex shrink to turn
   labels/buttons into one-character columns when a live payload adds rows. */
.m6c-detail-pane > .c-toolbar,
.m6c-detail-pane > .m6c-section,
.m6c-detail-pane > .m6c-section > .c-toolbar {
    width: 100%;
    min-width: 0;
    max-width: 100%;
}
.m6c-detail-pane {
    display: flex;
    flex-direction: column;
    align-items: stretch;
}
.m6c-detail-pane > h2,
.m6c-detail-pane > .c-toolbar,
.m6c-detail-pane > .m6c-section {
    display: block;
    flex: 0 0 auto;
}
.m6c-detail-pane > .m6c-section > * {
    max-width: 100%;
}
.m6c-detail-pane .c-toolbar > button {
    flex: 0 0 auto;
    min-width: 82dp;
    white-space: nowrap;
}
.m6c-detail-pane .m6c-section > h3,
.m6c-detail-pane .m6c-section > p,
.m6c-detail-pane .m6c-section > label {
    display: block;
    width: 100%;
    min-width: 0;
    white-space: normal;
}
.m6c-detail-pane .m6c-section > input.text,
.m6c-detail-pane .m6c-section > input[type="text"] {
    width: 100%;
    min-width: 0;
    max-width: 100%;
}
