<rml>
<head>
  <title>Population</title>
  <link type="text/template" href="/templates/management_window.rml" />
  <link type="text/rcss" href="/windows/management6b.rcss" />
  <link type="text/rcss" href="/screens/win98_classic.rcss"/><link type="text/rcss" href="/styles/accessibility.rcss" />
</head>
<body id="population_root" class="c-fixture-page l-m6b-root is-hidden">
  <template src="management-window">
  <!-- Windows 98 property sheet (252 x 218 DLU). Changes on these pages take effect at once, so the
       only commit button is Close; the profession editor keeps its own Save Changes / Discard Changes. -->
  <main id="population_workbench" class="c-window l-m6b-window w98-sheet" role="dialog" aria-labelledby="population_heading">
    <header class="w98-caption"><handle id="population_drag_handle" class="c-title-bar__drag-handle" move_target="population_workbench"><h1 id="population_heading" class="c-title-bar__title" tab-index="-1" data-l10n="win98.population.heading">Population</h1></handle><button id="population_help" class="w98-caption__close w98-caption__help" title="Help" data-l10n-title="win98.common.help.title" aria-label="What's This?"><span class="w98-caption__glyph w98-caption__glyph--help"></span></button><button id="population_close" class="w98-caption__close" title="Close" data-l10n-title="win98.population.close.title" aria-label="Close"><span class="w98-caption__glyph w98-caption__glyph--close"></span></button></header>
    <div class="w98-sheet__body">
      <nav id="population_tabs" class="c-tabs c-connected-tabs w98-tabs" role="tablist"><button id="population_tab_citizens" class="c-tabs__tab" role="tab" aria-selected="false" aria-controls="population_citizens" data-l10n="win98.population.tab_citizens">Citizens</button><button id="population_tab_skills" class="c-tabs__tab" role="tab" aria-selected="false" aria-controls="population_skills" data-l10n="win98.population.tab_skills">Skills</button><button id="population_tab_professions" class="c-tabs__tab" role="tab" aria-selected="false" aria-controls="population_professions" data-l10n="win98.population.tab_professions">Professions</button><button id="population_tab_schedules" class="c-tabs__tab" role="tab" aria-selected="false" aria-controls="population_schedules" data-l10n="win98.population.tab_schedules">Schedules</button></nav>
      <div id="population_scroll" class="w98-page-frame">
        <p id="population_loading" class="w98-text is-hidden" data-l10n="win98.population.loading">Loading citizens...</p>

        <section id="population_citizens" class="w98-page w98-col" role="tabpanel" aria-labelledby="population_tab_citizens">
          <div class="w98-line"><label class="w98-label" for="population_search" data-l10n="win98.population.search">Find:</label><input id="population_search" class="w98-field w98-field--wide" type="text" value=""/></div>
          <div class="w98-gap"></div>
          <div class="w98-listview w98-grow"><div class="w98-listview__header"><button id="population_sort_name" class="w98-listview__heading w98-cell--grow" data-l10n="win98.population.sort_name">Name</button><button id="population_sort_profession" class="w98-listview__heading w98-w-profession" data-l10n="win98.population.sort_profession">Profession</button></div><div id="population_rows" class="w98-list" role="listbox" tab-index="0" aria-label="Citizens"></div></div>
          <div class="w98-gap"></div>
          <div class="w98-line"><p id="population_page_status" class="w98-text w98-grow"></p><button id="population_refresh" class="w98-button" data-l10n="win98.population.refresh">Refresh</button><button id="population_open_citizen" class="w98-button" data-l10n="win98.population.open_citizen">Properties</button></div>
        </section>

        <section id="population_skills" class="w98-page w98-row w98-row--fill is-hidden" role="tabpanel" aria-labelledby="population_tab_skills">
          <div class="w98-col w98-skill-list">
            <label class="w98-label" for="skills_catalog_rows" data-l10n="win98.population.skills_catalog_rows">Skills:</label>
            <div id="skills_catalog_rows" class="w98-list w98-grow" role="listbox" aria-label="Skills"></div>
          </div>
          <div class="w98-col w98-grow">
            <p id="skill_focus_title" class="w98-label"></p>
            <div class="w98-listview w98-grow"><div class="w98-listview__header"><span class="w98-cell--grow" style="flex: 1 1 auto;" data-l10n="win98.population.name">Name</span><span class="w98-w-amount" style="text-align: right;" data-l10n="win98.population.level">Level</span></div><div id="skill_citizen_rows" class="w98-list" role="listbox" aria-multiselectable="true" aria-label="Citizens with this skill"></div></div>
            <div class="w98-gap"></div>
            <p id="skill_focus_group" class="w98-text"></p>
            <div class="w98-line w98-line--end"><button id="skill_enable_all" class="w98-button" data-l10n="win98.population.skill_enable_all">Enable for All</button><button id="skill_disable_all" class="w98-button" data-l10n="win98.population.skill_disable_all">Disable for All</button></div>
          </div>
        </section>

        <section id="population_professions" class="w98-page w98-col is-hidden" role="tabpanel" aria-labelledby="population_tab_professions">
          <div class="w98-line"><label class="w98-label" for="profession_rows" data-l10n="win98.population.profession_rows">Profession:</label><select id="profession_rows" class="w98-select w98-grow"></select><button id="profession_create" class="w98-button" data-l10n="win98.population.profession_create">New</button><button id="profession_delete" class="w98-button" data-l10n="win98.population.profession_delete">Delete</button></div>
          <div class="w98-line"><label class="w98-label" for="profession_name" data-l10n="win98.population.profession_name">Name:</label><input id="profession_name" class="w98-field w98-field--wide" type="text"/></div>
          <p id="profession_editor_help" class="w98-text"></p>
          <div class="w98-gap"></div>
          <div class="w98-row w98-row--fill w98-grow">
            <div class="w98-col w98-grow"><label class="w98-label" for="profession_available_skills" data-l10n="win98.population.profession_available_skills">Available skills:</label><div id="profession_available_skills" class="w98-list w98-grow" role="listbox" aria-label="Available skills"></div></div>
            <div class="w98-stack w98-transfer"><div class="w98-gap--wide"></div><button id="profession_skill_add" class="w98-button" data-l10n="win98.population.profession_skill_add">Add -&gt;</button><button id="profession_skill_remove" class="w98-button" data-l10n="win98.population.profession_skill_remove">&lt;- Remove</button><div class="w98-gap"></div><button id="profession_skill_up" class="w98-button" data-l10n="win98.population.profession_skill_up">Move Up</button><button id="profession_skill_down" class="w98-button" data-l10n="win98.population.profession_skill_down">Move Down</button></div>
            <div class="w98-col w98-grow"><label class="w98-label" for="profession_selected_skills" data-l10n="win98.population.profession_selected_skills">Profession skills:</label><div id="profession_selected_skills" class="w98-list w98-grow" role="listbox" aria-label="Profession skills in priority order"></div></div>
          </div>
          <div class="w98-gap"></div>
          <div class="w98-line"><p id="profession_feedback" class="w98-text w98-grow" role="status"></p><button id="profession_save" class="w98-button" data-l10n="win98.population.profession_save">Save Changes</button><button id="profession_discard" class="w98-button" data-l10n="win98.population.profession_discard">Discard</button></div>
        </section>

        <section id="population_schedules" class="w98-page w98-col is-hidden" role="tabpanel" aria-labelledby="population_tab_schedules">
          <div class="w98-line"><span class="w98-text" data-l10n="win98.population.activity">Activity:</span><label class="w98-check" for="schedule_set_none"><input id="schedule_set_none" class="radio" type="radio" name="schedule_activity"/><span data-l10n="win98.population.schedule_set_none">None</span></label><label class="w98-check" for="schedule_set_eat"><input id="schedule_set_eat" class="radio" type="radio" name="schedule_activity"/><span data-l10n="win98.population.schedule_set_eat">Eat (E)</span></label><label class="w98-check" for="schedule_set_sleep"><input id="schedule_set_sleep" class="radio" type="radio" name="schedule_activity"/><span data-l10n="win98.population.schedule_set_sleep">Sleep (S)</span></label><label class="w98-check" for="schedule_set_training"><input id="schedule_set_training" class="radio" type="radio" name="schedule_activity"/><span data-l10n="win98.population.schedule_set_training">Train (T)</span></label></div>
          <!-- Excel 97 style grid: frozen hour and citizen headings, a Select All corner, one active cell. -->
          <div id="schedule_grid" class="w98-grid w98-grow">
            <div class="w98-grid__top"><button id="schedule_select_all" class="w98-grid__corner" title="Select All" data-l10n-title="win98.population.schedule_select_all.title" aria-label="Select all cells"></button><div id="schedule_hours" class="w98-grid__colheads"></div></div>
            <div class="w98-grid__main"><div id="schedule_names" class="w98-grid__rowheads"></div><div id="schedule_rows" class="w98-grid__cells" role="grid" tab-index="0" aria-label="Schedule, 24 hours per citizen"></div></div>
          </div>
          <div class="w98-gap"></div>
          <div class="w98-line"><p id="schedule_scope_label" class="w98-text w98-grow" role="status"></p><button id="schedule_apply" class="w98-button" data-l10n="win98.population.schedule_apply">Set Activity</button></div>
        </section>

      </div>
      <div class="w98-buttonbar"><p id="population_status" class="w98-text w98-grow" role="status"></p><span id="population_revision" class="is-hidden"></span><button id="population_close_button" class="w98-button w98-button--default" data-l10n="win98.common.close">Close</button></div>
    </div>
  </main>

  <div id="population_tooltip" class="c-tooltip c-management-tooltip" role="tooltip" aria-hidden="true"></div>
  </template>
</body>
</rml>
