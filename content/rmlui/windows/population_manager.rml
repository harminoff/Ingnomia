<rml>
<head>
  <title>Population and Work</title>
  <link type="text/template" href="/templates/management_window.rml" />
  <link type="text/rcss" href="/windows/management6b.rcss" />
</head>
<body id="population_root" class="c-fixture-page l-m6b-root is-hidden">
  <template src="management-window">
  <main id="population_workbench" class="c-window l-m6b-window" role="dialog" aria-labelledby="population_heading">
    <header class="c-title-bar"><handle id="population_drag_handle" class="c-title-bar__drag-handle" move_target="population_workbench" edge_margin="76dp 12dp 58dp 12dp"><div class="c-title-bar__mark"></div><h1 id="population_heading" class="c-title-bar__title" tab-index="-1" data-l10n="management.population.title">Population &amp; Work</h1></handle><button id="population_close" class="c-button" data-l10n="common.close">Close</button></header>
    <div class="c-window__body l-m6b-body">
      <div id="population_shell" class="c-management-shell">
        <aside id="population_rail" class="c-management-rail" aria-label="Population views" data-l10n-aria-label="management.population.views_label"><span class="c-management-rail__heading" data-l10n="management.navigation.views">Views</span>
          <nav class="c-management-rail__nav" role="tablist" aria-label="Population views" data-l10n-aria-label="management.population.views_label" aria-orientation="vertical">
            <button id="population_tab_citizens" class="c-button c-management-rail__button" role="tab" aria-selected="false" data-l10n="management.population.citizens" title="Review citizens, assignments, activity, needs, and equipment" data-l10n-title="management.population.citizens_help">Citizens</button>
            <button id="population_tab_skills" class="c-button c-management-rail__button" role="tab" aria-selected="false" data-l10n="management.population.skills" title="Compare one skill across citizens" data-l10n-title="management.population.skills_help">Skills</button>
            <button id="population_tab_professions" class="c-button c-management-rail__button" role="tab" aria-selected="false" data-l10n="management.population.professions" title="Create professions and edit ordered skills" data-l10n-title="management.population.professions_help">Professions</button>
            <button id="population_tab_schedules" class="c-button c-management-rail__button" role="tab" aria-selected="false" data-l10n="management.population.schedules" title="Set hourly duties at the chosen scope" data-l10n-title="management.population.schedules_help">Schedules</button>
          </nav>
        </aside>
        <div class="c-management-main l-population-main"><div class="l-population-navigation"><button id="population_views_toggle" class="c-button c-management-views-toggle" aria-expanded="false" title="Open Population views" data-l10n-title="management.population.views_help">Views: Citizens</button><button id="population_refresh_view" class="c-button" data-l10n="common.refresh">Refresh</button></div>
      <div id="population_toolbar" class="c-toolbar l-m6b-toolbar"><label class="l-m6b-search-field"><span data-l10n="common.search">Search</span><input id="population_search" class="text l-m6b-search" type="text" value="" placeholder="Search citizens" data-l10n-placeholder="management.population.search.placeholder"/></label><button id="population_refresh" class="c-button" data-l10n="common.refresh">Refresh</button><button id="population_sort_name" class="c-button" data-l10n="management.population.sort_name">Name</button><button id="population_sort_profession" class="c-button" data-l10n="management.population.sort_profession">Profession</button><span class="c-key-hint" data-l10n="management.population.keyboard_hint">Up/Down select | Enter opens details</span></div>
      <div id="population_loading" class="c-m6b-state" data-l10n="status.refreshing">Refreshing…</div>
      <section id="population_citizens" class="l-m6b-section"><h2 data-l10n="management.population.citizen_roster">Citizen roster</h2><div id="population_rows" class="c-list c-scroll-region l-m6b-roster" role="listbox" tab-index="0"></div><footer class="l-m6b-footer"><span id="population_page_status"></span><button id="population_page_previous" class="c-button" data-l10n="common.previous_rows">Previous rows</button><button id="population_page_next" class="c-button" data-l10n="common.next_rows">Next rows</button></footer></section>
      <section id="population_skills" class="l-m6b-section l-population-split is-hidden"><div class="l-population-list-pane"><h2 data-l10n="management.population.skills">Skills</h2><div id="skills_catalog_rows" class="c-list c-scroll-region" role="listbox"></div></div><div class="l-population-detail-pane"><h2 id="skill_focus_title">Choose a skill</h2><p id="skill_focus_group"></p><div class="c-toolbar"><button id="skill_enable_all" class="c-button" data-l10n="management.population.enable_skill_all" title="Enable this skill for every citizen" data-l10n-title="management.population.enable_skill_all_help">Enable for all citizens</button><button id="skill_disable_all" class="c-button" data-l10n="management.population.disable_skill_all" title="Disable this skill for every citizen" data-l10n-title="management.population.disable_skill_all_help">Disable for all citizens</button></div><div id="skill_citizen_rows" class="c-list c-scroll-region" role="listbox"></div></div></section>
      <section id="population_professions" class="l-m6b-section l-population-split is-hidden"><div class="l-population-list-pane"><h2 data-l10n="management.population.profession_roster">Professions</h2><div id="profession_rows" class="c-list c-scroll-region" role="listbox"></div><div class="c-toolbar"><label class="l-population-create-label" for="profession_create_name" data-l10n="management.population.new_profession">New profession</label><input id="profession_create_name" class="text" type="text" aria-label="New profession name" data-l10n-aria-label="management.population.new_profession_name" placeholder="New profession name" data-l10n-placeholder="management.population.new_profession_name"/><button id="profession_create" class="c-button" data-l10n="management.population.create">Create</button></div></div><div class="l-population-detail-pane"><h2 id="profession_editor_title">Choose a profession</h2><label for="profession_name" data-l10n="management.population.name">Name</label><input id="profession_name" class="text" type="text"/><p id="profession_editor_help">Choose and order the skills this profession uses.</p><div class="l-profession-skill-columns"><section><h3 data-l10n="management.population.profession_skills">Profession skills</h3><div id="profession_selected_skills" class="c-list c-scroll-region" role="listbox"></div><div class="c-toolbar"><button id="profession_skill_up" class="c-button" data-l10n="management.population.move_up">Move up</button><button id="profession_skill_down" class="c-button" data-l10n="management.population.move_down">Move down</button><button id="profession_skill_remove" class="c-button" data-l10n="management.population.remove_skill">Remove</button></div></section><section><h3 data-l10n="management.population.available_skills">Available skills</h3><div id="profession_available_skills" class="c-list c-scroll-region" role="listbox"></div><button id="profession_skill_add" class="c-button" data-l10n="management.population.add_skill">Add skill</button></section></div><div class="c-toolbar"><button id="profession_save" class="c-button c-button--primary" data-l10n="management.population.save_profession">Save profession</button><button id="profession_delete" class="c-button c-button--danger" data-l10n="management.population.delete_profession">Delete profession</button></div></div></section>
      <section id="population_schedules" class="l-m6b-section is-hidden"><h2 data-l10n="management.population.schedule_title">24-hour duty board</h2><p data-l10n="management.population.schedule_note">Choose a citizen and hour, then choose an activity and scope.</p><div class="c-toolbar"><button id="schedule_set_none" class="c-check-button is-unchecked" data-l10n="management.population.schedule_none">None</button><button id="schedule_set_eat" class="c-check-button" data-l10n="management.population.schedule_eat">Eat</button><button id="schedule_set_sleep" class="c-check-button" data-l10n="management.population.schedule_sleep">Sleep</button><button id="schedule_set_training" class="c-check-button" data-l10n="management.population.schedule_train">Train</button></div><div class="c-toolbar"><span id="schedule_scope_label">Choose a cell</span><button id="schedule_apply_cell" class="c-button" data-l10n="management.population.set_cell" title="Only this citizen and hour" data-l10n-title="management.population.set_cell_help">Set cell</button><button id="schedule_apply_row" class="c-button" data-l10n="management.population.set_day" title="All 24 hours for this citizen" data-l10n-title="management.population.set_day_help">Set citizen's day</button><button id="schedule_apply_column" class="c-button" data-l10n="management.population.set_hour_all" title="This hour for every citizen" data-l10n-title="management.population.set_hour_all_help">Set hour for all</button></div><div id="schedule_rows" class="l-m6b-schedule" role="grid" tab-index="0"></div></section>
      <section id="creature_detail" class="l-m6b-section is-hidden"><div class="m6b-creature-scroll"><button id="creature_back" class="c-button" data-l10n="management.population.back">Back to citizens</button><h2 id="creature_name">Creature</h2><p id="creature_profession"></p><div id="creature_professions" class="c-toolbar m6b-profession-picker"></div><p id="creature_activity"></p><div class="m6b-section-heading"><h3 data-l10n="management.population.skills">Skills</h3><span class="m6b-section-heading__hint" data-l10n="management.population.active_hint">[x] active</span></div><div class="c-toolbar"><button id="creature_skills_enable_all" class="c-button" title="Enable every skill for this citizen" data-l10n-title="management.population.enable_person_skills_help" data-l10n="management.population.enable_person_skills">Enable all skills</button><button id="creature_skills_disable_all" class="c-button" title="Disable every skill for this citizen" data-l10n-title="management.population.disable_person_skills_help" data-l10n="management.population.disable_person_skills">Disable all skills</button></div><div id="creature_skills" class="l-m6b-skill-list" role="group" aria-label="Skills"></div><h3 data-l10n="management.population.attributes">Attributes</h3><p id="creature_attributes"></p><h3 data-l10n="management.population.needs">Needs</h3><p id="creature_needs"></p><h3 data-l10n="management.population.equipment">Equipment</h3><div id="creature_equipment" class="c-list"></div></div></section>
      <footer id="population_status_footer" class="l-m6b-status"><span id="population_revision" class="c-status-chip c-status-chip--info"></span><span id="population_status" role="status"></span></footer>
        </div>
      </div>
    </div>
    <span class="c-window__resize-grip" aria-hidden="true"></span>
  </main>
  <div id="population_delete_confirm" class="c-modal-scrim is-hidden"><div class="c-modal c-modal--danger" role="dialog" aria-modal="true" aria-labelledby="population_delete_heading"><h2 id="population_delete_heading" data-l10n="management.population.delete_confirm_title">Delete profession?</h2><p id="population_delete_name"></p><div class="c-modal__actions"><button id="population_delete_cancel" class="c-button" data-l10n="common.cancel">Cancel</button><button id="population_delete_accept" class="c-button c-button--danger" data-l10n="management.population.delete">Delete</button></div></div></div>
  <div id="population_tooltip" class="c-tooltip c-management-tooltip" role="tooltip" aria-hidden="true"></div>
  </template>
</body>
</rml>
