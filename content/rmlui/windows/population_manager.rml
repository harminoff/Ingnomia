<rml>
<head>
  <title>Population and Work</title>
  <link type="text/rcss" href="/styles/base.rcss" />
  <link type="text/rcss" href="/styles/components.rcss" />
  <link type="text/rcss" href="/styles/accessibility.rcss" />
  <link type="text/rcss" href="/windows/management6b.rcss" />
</head>
<body id="population_root" class="c-fixture-page l-m6b-root is-hidden">
  <main id="population_workbench" class="c-window l-m6b-window" role="dialog" aria-labelledby="population_heading">
    <header class="c-title-bar"><handle id="population_drag_handle" class="c-title-bar__drag-handle" move_target="population_workbench" edge_margin="76dp 12dp 58dp 12dp"><div class="c-title-bar__mark"></div><h1 id="population_heading" class="c-title-bar__title" tab-index="-1" data-l10n="management.population.title">Population &amp; Work</h1></handle><button id="population_close" class="c-button" data-l10n="common.close">Close</button></header>
    <div class="c-window__body l-m6b-body">
      <nav class="c-tabs l-m6b-tabs" aria-label="Population views">
        <button id="population_tab_citizens" class="c-tabs__tab l-m6b-tab" data-l10n="management.population.citizens">Citizens</button>
        <button id="population_tab_professions" class="c-tabs__tab l-m6b-tab" data-l10n="management.population.professions">Professions &amp; Skills</button>
        <button id="population_tab_schedules" class="c-tabs__tab l-m6b-tab" data-l10n="management.population.schedules">Schedules</button>
      </nav>
      <div class="c-toolbar l-m6b-toolbar"><input id="population_search" class="text l-m6b-search" type="text" value="" placeholder="Search citizens or professions" data-l10n-placeholder="management.population.search.placeholder"/><button id="population_refresh" class="c-button" data-l10n="common.refresh">Refresh</button><button id="population_sort_name" class="c-dropdown-button" data-l10n="management.population.sort_name">Sort: name ▾</button><button id="population_sort_profession" class="c-dropdown-button" data-l10n="management.population.sort_profession">Sort: profession ▾</button><span class="c-key-hint" data-l10n="management.population.keyboard_hint">Up/Down select | Enter opens details</span></div>
      <div id="population_loading" class="c-m6b-state" data-l10n="status.refreshing">Refreshing authoritative data...</div>
      <section id="population_citizens" class="l-m6b-section"><h2 data-l10n="management.population.citizen_roster">Citizen roster</h2><div id="population_rows" class="c-list c-scroll-region l-m6b-roster" role="listbox" tab-index="0"></div><footer class="l-m6b-footer"><span id="population_page_status"></span><button id="population_page_previous" class="c-button" data-l10n="common.previous_rows">Previous rows</button><button id="population_page_next" class="c-button" data-l10n="common.next_rows">Next rows</button></footer></section>
      <section id="population_professions" class="l-m6b-section is-hidden"><h2 data-l10n="management.population.profession_roster">Profession roster</h2><p data-l10n="management.population.profession_note">Skill membership is authoritative. Edit a citizen's assignment from their detail card.</p><div id="profession_rows" class="c-list c-scroll-region l-m6b-roster" role="listbox"></div></section>
      <section id="population_schedules" class="l-m6b-section is-hidden"><h2 data-l10n="management.population.schedule_title">24-hour duty board</h2><p data-l10n="management.population.schedule_note">Each cell is authoritative. Arrow keys move; Enter or Space cycles the focused cell.</p><div class="c-toolbar"><button id="schedule_set_none" class="c-check-button is-unchecked" data-l10n="management.population.schedule_none">☐ None</button><button id="schedule_set_eat" class="c-check-button" data-l10n="management.population.schedule_eat">☐ Eat</button><button id="schedule_set_sleep" class="c-check-button" data-l10n="management.population.schedule_sleep">☐ Sleep</button><button id="schedule_set_training" class="c-check-button" data-l10n="management.population.schedule_train">☐ Train</button><span class="c-key-hint" data-l10n="management.population.schedule_keyboard_hint">Home/End hour | Page Up/Down citizen</span></div><div id="schedule_rows" class="l-m6b-schedule" role="grid" tab-index="0"></div></section>
      <section id="creature_detail" class="l-m6b-section is-hidden"><div class="m6b-creature-scroll"><button id="creature_back" class="c-button" data-l10n="management.population.back">Back to citizens</button><h2 id="creature_name">Creature</h2><p id="creature_profession"></p><div id="creature_professions" class="c-toolbar m6b-profession-picker"></div><p id="creature_activity"></p><div class="m6b-section-heading"><h3 data-l10n="management.population.skills">Skills</h3><span class="m6b-section-heading__hint">[x] active</span></div><div id="creature_skills" class="l-m6b-skill-list" role="group" aria-label="Skills"></div><h3 data-l10n="management.population.attributes">Attributes</h3><p id="creature_attributes"></p><h3 data-l10n="management.population.needs">Needs</h3><p id="creature_needs"></p><h3 data-l10n="management.population.equipment">Equipment</h3><div id="creature_equipment" class="c-list"></div></div></section>
      <footer id="population_status_footer" class="l-m6b-status"><span id="population_revision" class="c-status-chip c-status-chip--info"></span><span id="population_status" role="status"></span></footer>
    </div>
  </main>
</body>
</rml>
