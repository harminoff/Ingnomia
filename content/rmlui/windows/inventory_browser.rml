<rml>
<head>
  <title>Inventory and Resources</title>
  <link type="text/rcss" href="/styles/base.rcss" />
  <link type="text/rcss" href="/styles/components.rcss" />
  <link type="text/rcss" href="/styles/accessibility.rcss" />
  <link type="text/rcss" href="/windows/management6b.rcss" />
</head>
<body id="inventory_root" class="c-fixture-page l-m6b-root is-hidden">
  <main id="inventory_workbench" class="c-window l-m6b-window" role="dialog" aria-labelledby="inventory_heading">
    <header class="c-title-bar"><handle class="c-title-bar__drag-handle" move_target="inventory_workbench" edge_margin="76dp 12dp 58dp 12dp"><div class="c-title-bar__mark"></div><h1 id="inventory_heading" class="c-title-bar__title" tab-index="-1" data-l10n="management.inventory.title">Inventory &amp; Resources</h1></handle><button id="inventory_close" class="c-button" data-l10n="common.close">Close</button></header>
    <div class="c-window__body l-m6b-body">
      <div class="l-m6b-inventory-layout">
        <aside class="l-m6b-inventory-rail">
          <section class="l-m6b-rail-section"><div id="inventory_filters_heading" class="l-m6b-rail-heading" data-l10n="management.inventory.filters">Filters</div><button id="inventory_filter_owned" class="c-check-button l-m6b-rail-button l-m6b-filter-owned is-unchecked" aria-pressed="false" data-l10n="management.inventory.filter_owned">Items we have</button><button id="inventory_sort_name" class="c-button l-m6b-rail-button l-m6b-sort-button" aria-pressed="true" data-l10n="management.inventory.sort_name">Name</button><button id="inventory_sort_stock" class="c-button l-m6b-rail-button l-m6b-sort-button" aria-pressed="false" data-l10n="management.inventory.sort_stock">In Stock</button><button id="inventory_sort_total" class="c-button l-m6b-rail-button l-m6b-sort-button" aria-pressed="false" data-l10n="management.inventory.sort_total">Total</button></section>
          <section class="l-m6b-rail-section l-m6b-rail-section--categories"><div id="inventory_categories_heading" class="l-m6b-rail-heading" data-l10n="management.inventory.categories">Categories</div><nav id="inventory_category_tabs" class="c-tabs l-m6b-tabs l-m6b-inventory-tabs" role="tablist" aria-orientation="vertical" aria-label="Inventory categories"></nav></section>
        </aside>
        <section class="l-m6b-inventory-main">
          <div class="c-toolbar l-m6b-toolbar"><label class="l-m6b-search-field"><span data-l10n="common.search">Search</span><input id="inventory_search" class="text l-m6b-search" type="text" value="" placeholder="Filter inventory by name" data-l10n-placeholder="management.inventory.search.placeholder"/></label></div>
          <div id="inventory_column_head" class="l-m6b-column-head" role="row"><span class="l-m6b-inventory__name-head" data-l10n="management.inventory.column.resource">Item</span><span class="l-m6b-inventory__metric-head" data-l10n="management.inventory.column.stock">In Stock</span><span class="l-m6b-inventory__metric-head" data-l10n="management.inventory.column.total">Total</span></div>
          <div id="inventory_rows" class="c-list c-scroll-region l-m6b-inventory" role="tree" tab-index="0"></div>
        </section>
      </div>

    </div>
    <span class="c-window__resize-grip" aria-hidden="true"></span>
  </main>
</body>
</rml>
