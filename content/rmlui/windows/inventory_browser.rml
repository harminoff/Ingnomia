<rml>
<head>
  <title>Inventory and Resources</title>
  <link type="text/rcss" href="/styles/base.rcss" />
  <link type="text/rcss" href="/styles/components.rcss" />
  <link type="text/rcss" href="/styles/accessibility.rcss" />
  <link type="text/rcss" href="/windows/management6b.rcss" />
</head>
<body id="inventory_root" class="c-fixture-page l-m6b-root is-hidden">
  <main id="inventory_workbench" class="c-window l-m6b-window" role="dialog" aria-labelledby="inventory_heading">
    <header class="c-title-bar"><handle class="c-title-bar__drag-handle" move_target="inventory_workbench" edge_margin="76dp 12dp 58dp 12dp"><div class="c-title-bar__mark"></div><h1 id="inventory_heading" class="c-title-bar__title" tab-index="-1" data-l10n="management.inventory.title">Inventory &amp; Resources</h1></handle><button id="inventory_close" class="c-button" data-l10n="common.close">Close</button></header>
    <div class="c-window__body l-m6b-body">
      <nav id="inventory_category_tabs" class="l-m6b-tabs l-m6b-inventory-tabs" role="tablist" aria-label="Inventory sections"></nav>
      <div class="c-toolbar l-m6b-toolbar"><input id="inventory_search" class="text l-m6b-search" type="text" value="" placeholder="Filter inventory by name" data-l10n-placeholder="management.inventory.search.placeholder"/><button id="inventory_filter_owned" class="c-check-button l-m6b-filter-owned is-unchecked" aria-pressed="false" data-l10n="management.inventory.filter_owned">Items we have</button><button id="inventory_refresh" class="c-button" data-l10n="common.refresh">Refresh</button><button id="inventory_sort_name" class="c-dropdown-button" data-l10n="management.inventory.sort_name">Sort: name ▾</button><button id="inventory_sort_total" class="c-dropdown-button" data-l10n="management.inventory.sort_total">Sort: total ▾</button><button id="inventory_sort_value" class="c-dropdown-button" data-l10n="management.inventory.sort_value">Sort: value ▾</button></div>
      <div id="inventory_column_head" class="l-m6b-column-head" role="row"><span class="l-m6b-inventory__sprite-head" aria-hidden="true"></span><span class="l-m6b-inventory__watch-head" aria-hidden="true"></span><span class="l-m6b-inventory__name-head" data-l10n="management.inventory.column.resource">Resource</span><span class="l-m6b-inventory__metric-head" data-l10n="management.inventory.column.total">Total</span><span class="l-m6b-inventory__metric-head" data-l10n="management.inventory.column.jobs">Jobs</span><span class="l-m6b-inventory__metric-head" data-l10n="management.inventory.column.stock">Stock</span><span class="l-m6b-inventory__metric-head" data-l10n="management.inventory.column.equipped">Equipped</span><span class="l-m6b-inventory__metric-head" data-l10n="management.inventory.column.built">Built</span><span class="l-m6b-inventory__metric-head" data-l10n="management.inventory.column.loose">Loose</span><span class="l-m6b-inventory__metric-head" data-l10n="management.inventory.column.value">Value</span></div>
      <div id="inventory_rows" class="c-list c-scroll-region l-m6b-inventory" role="tree" tab-index="0"></div>
      <div class="l-m6b-history-launch"><button id="inventory_request_history" class="c-button" data-l10n="management.inventory.history">History</button></div>
      <section id="inventory_history" class="l-m6b-history is-hidden" aria-live="polite"><header class="l-m6b-history__header"><strong data-l10n="management.inventory.history">History</strong><span id="inventory_history_target"></span></header><div id="inventory_history_rows" class="l-m6b-history__rows"></div></section>
      <footer class="l-m6b-footer"><span id="inventory_page_status"></span><button id="inventory_page_previous" class="c-button" data-l10n="common.previous_rows">Previous rows</button><button id="inventory_page_next" class="c-button" data-l10n="common.next_rows">Next rows</button><button id="inventory_toggle_watch" class="c-check-button is-unchecked" aria-pressed="false" aria-disabled="true" disabled="disabled" data-l10n="management.inventory.toggle_watch">☐ Watch selected</button></footer>
    </div>
  </main>
</body>
</rml>
