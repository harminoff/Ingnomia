<rml>
<head>
  <title>Military</title>
  <link type="text/template" href="/templates/management_window.rml" />
  <link type="text/rcss" href="/windows/management6c.rcss" />
  <link type="text/rcss" href="/screens/win98_classic.rcss"/><link type="text/rcss" href="/styles/accessibility.rcss" />
</head>
<body id="military_root" class="m6c-root is-hidden">
  <template src="management-window">
  <!-- Windows 98 property sheet (252 x 218 DLU). Military commands take effect at once, so Close is the only
       commit button; deletions ask in a message box that names the squad or role. -->
  <div id="military_workbench" class="c-window m6c-workbench w98-sheet">
    <div class="w98-caption">
      <handle class="c-title-bar__drag-handle" move_target="military_workbench"><h1 class="c-title-bar__title" data-l10n="win98.military.military">Military</h1></handle>
      <button id="military_help" class="w98-caption__close w98-caption__help" title="Help" data-l10n-title="win98.common.help.title" aria-label="What's This?"><span class="w98-caption__glyph w98-caption__glyph--help"></span></button><button id="military_close" class="w98-caption__close" title="Close" data-l10n-title="win98.military.close.title" aria-label="Close"><span class="w98-caption__glyph w98-caption__glyph--close"></span></button>
    </div>
    <div id="military_body" class="w98-sheet__body">
      <nav id="military_tabs" class="c-tabs c-connected-tabs w98-tabs" role="tablist"><button id="military_tab_squads" class="c-tabs__tab" role="tab" aria-selected="false" aria-controls="military_squads_page" data-l10n="win98.military.tab_squads">Squads</button><button id="military_tab_members" class="c-tabs__tab" role="tab" aria-selected="false" aria-controls="military_members_page" data-l10n="win98.military.tab_members">Members</button><button id="military_tab_roles" class="c-tabs__tab" role="tab" aria-selected="false" aria-controls="military_roles_page" data-l10n="win98.military.tab_roles">Roles</button><button id="military_tab_uniforms" class="c-tabs__tab" role="tab" aria-selected="false" aria-controls="military_uniforms_page" data-l10n="win98.military.tab_uniforms">Uniforms</button><button id="military_tab_priorities" class="c-tabs__tab" role="tab" aria-selected="false" aria-controls="military_priority_page" data-l10n="win98.military.tab_priorities">Targets</button><button id="military_tab_neighbors" class="c-tabs__tab is-hidden" role="tab" data-l10n="win98.military.tab_neighbors">Neighbors</button><button id="military_tab_missions" class="c-tabs__tab is-hidden" role="tab" data-l10n="win98.military.tab_missions">Missions</button></nav>
      <div id="military_scroll" class="w98-page-frame">
        <p id="military_loading" class="w98-text is-hidden" data-l10n="win98.military.loading">Loading military records...</p>
        <div id="military_error" class="w98-line is-hidden"><p id="military_error_text" class="w98-text w98-grow" data-l10n="win98.military.error_text">Military data is unavailable.</p><button id="military_error_retry" class="w98-button" data-l10n="win98.military.error_retry">Retry</button></div>

        <section id="military_squads_page" class="w98-page w98-col" role="tabpanel" aria-labelledby="military_tab_squads">
          <label class="w98-label" for="military_squad_rows" data-l10n="win98.military.squad_rows">Squads:</label>
          <div class="w98-row w98-row--fill w98-grow">
            <div id="military_squad_rows" class="w98-list w98-grow" role="listbox" aria-label="Squads"></div>
            <div class="w98-stack"><button id="squad_add" class="w98-button" data-l10n="win98.military.squad_add">New</button><div class="w98-gap"></div><button id="squad_move_up" class="w98-button" data-l10n="win98.military.squad_move_up">Move Up</button><button id="squad_move_down" class="w98-button" data-l10n="win98.military.squad_move_down">Move Down</button><div class="w98-gap--wide"></div><button id="squad_remove" class="w98-button" data-l10n="win98.military.squad_remove">Delete</button></div>
          </div>
          <p id="squad_order_help" class="w98-text" data-l10n="win98.military.squad_order_help">Move Up and Move Down change only the order of squads in this list.</p>
          <div class="w98-gap"></div>
          <div class="w98-line"><label class="w98-label" for="squad_name_input" data-l10n="win98.military.squad_name_input">Name:</label><input id="squad_name_input" class="w98-field w98-field--wide" type="text"/><button id="squad_rename" class="w98-button" data-l10n="win98.military.squad_rename">Rename</button></div>
        </section>

        <section id="military_members_page" class="w98-page w98-col is-hidden" role="tabpanel" aria-labelledby="military_tab_members">
          <div class="w98-line"><label class="w98-label" for="military_member_squad" data-l10n="win98.military.member_squad">Squad:</label><select id="military_member_squad" class="w98-select w98-grow"></select></div>
          <div class="w98-gap"></div>
          <div class="w98-row w98-row--fill w98-grow">
            <div class="w98-col w98-grow"><label class="w98-label" for="military_unassigned_rows" data-l10n="win98.military.unassigned_rows">Not in a squad:</label><div id="military_unassigned_rows" class="w98-list w98-grow" role="listbox" aria-label="Citizens not in a squad"></div></div>
            <div class="w98-stack w98-transfer"><div class="w98-gap--wide"></div><button id="member_assign_squad" class="w98-button" data-l10n="win98.military.member_assign_squad">Add -&gt;</button><button id="member_remove" class="w98-button" data-l10n="win98.military.member_remove">&lt;- Remove</button></div>
            <div class="w98-col w98-grow"><label id="military_members_label" class="w98-label" for="military_member_rows"></label><div id="military_member_rows" class="w98-list w98-grow" role="listbox" aria-label="Squad members"></div></div>
          </div>
          <div class="w98-gap"></div>
          <div id="military_member_group" class="w98-group"><span id="role_member_assignment_status" class="w98-group__title"></span>
            <div class="w98-line"><label class="w98-label" for="military_member_role" data-l10n="win98.military.member_role">Role:</label><select id="military_member_role" class="w98-select w98-grow"></select></div>
            <div class="w98-line"><label class="w98-label" for="military_member_destination" data-l10n="win98.military.member_destination">Move to:</label><select id="military_member_destination" class="w98-select w98-grow"></select><button id="member_move_to" class="w98-button" data-l10n="win98.military.member_move_to">Move</button></div>
          </div>
        </section>

        <section id="military_roles_page" class="w98-page w98-col is-hidden" role="tabpanel" aria-labelledby="military_tab_roles">
          <label class="w98-label" for="military_role_rows" data-l10n="win98.military.role_rows">Roles:</label>
          <div class="w98-row w98-row--fill w98-grow">
            <div id="military_role_rows" class="w98-list w98-grow" role="listbox" aria-label="Roles"></div>
            <div class="w98-stack"><button id="role_add" class="w98-button" data-l10n="win98.military.role_add">New</button><div class="w98-gap--wide"></div><button id="role_remove" class="w98-button" data-l10n="win98.military.role_remove">Delete</button></div>
          </div>
          <div class="w98-gap"></div>
          <div class="w98-line"><label class="w98-label" for="role_name_input" data-l10n="win98.military.role_name_input">Name:</label><input id="role_name_input" class="w98-field w98-field--wide" type="text"/><button id="role_rename" class="w98-button" data-l10n="win98.military.role_rename">Rename</button></div>
          <label class="w98-check" for="role_civilian"><input id="role_civilian" class="checkbox" type="checkbox"/><span data-l10n="win98.military.role_civilian">Civilian (retreats to safety during an alarm)</span></label>
          <p id="role_usage" class="w98-text"></p>
        </section>

        <section id="military_uniforms_page" class="w98-page w98-col is-hidden" role="tabpanel" aria-labelledby="military_tab_uniforms">
          <div class="w98-line"><label class="w98-label" for="military_uniform_role" data-l10n="win98.military.uniform_role">Role:</label><select id="military_uniform_role" class="w98-select w98-grow"></select></div>
          <div class="w98-gap"></div>
          <div class="w98-listview w98-grow"><div class="w98-listview__header"><span class="w98-w-slot" data-l10n="win98.military.slot">Slot</span><span style="flex: 1 1 auto;" data-l10n="win98.military.equipment">Equipment</span><span class="w98-w-profession" data-l10n="win98.military.material">Material</span></div><div id="military_uniform_rows" class="w98-list" role="listbox" aria-label="Uniform slots"></div></div>
          <div class="w98-gap"></div>
          <div class="w98-group"><span id="military_uniform_title" class="w98-group__title"></span>
            <div class="w98-line"><label class="w98-label" for="military_uniform_type" data-l10n="win98.military.uniform_type">Equipment:</label><select id="military_uniform_type" class="w98-select w98-grow"></select></div>
            <div class="w98-line"><label class="w98-label" for="military_uniform_material" data-l10n="win98.military.uniform_material">Material:</label><select id="military_uniform_material" class="w98-select w98-grow"></select></div>
          </div>
          <p id="military_uniform_scope" class="w98-text"></p>
        </section>

        <section id="military_priority_page" class="w98-page w98-col is-hidden" role="tabpanel" aria-labelledby="military_tab_priorities">
          <div class="w98-line"><label class="w98-label" for="military_priority_squad" data-l10n="win98.military.priority_squad">Squad:</label><select id="military_priority_squad" class="w98-select w98-grow"></select></div>
          <div class="w98-gap"></div>
          <div class="w98-row w98-row--fill w98-grow">
            <div class="w98-listview w98-grow"><div class="w98-listview__header"><span style="flex: 1 1 auto;" data-l10n="win98.military.target">Target</span><span class="w98-w-state" data-l10n="win98.military.response">Response</span></div><div id="military_priority_rows" class="w98-list" role="listbox" aria-label="Targets in priority order"></div></div>
            <div class="w98-stack"><button id="priority_move_up" class="w98-button" data-l10n="win98.military.priority_move_up">Move Up</button><button id="priority_move_down" class="w98-button" data-l10n="win98.military.priority_move_down">Move Down</button></div>
          </div>
          <div class="w98-gap"></div>
          <div class="w98-group"><span id="military_priority_selection" class="w98-group__title"></span>
            <div class="w98-line"><label class="w98-check" for="attitude_flee"><input id="attitude_flee" class="radio" type="radio" name="military_attitude"/><span data-l10n="win98.military.attitude_flee">Flee</span></label><label class="w98-check" for="attitude_defend"><input id="attitude_defend" class="radio" type="radio" name="military_attitude"/><span data-l10n="win98.military.attitude_defend">Defend</span></label><label class="w98-check" for="attitude_attack"><input id="attitude_attack" class="radio" type="radio" name="military_attitude"/><span data-l10n="win98.military.attitude_attack">Attack</span></label><label class="w98-check" for="attitude_hunt"><input id="attitude_hunt" class="radio" type="radio" name="military_attitude"/><span data-l10n="win98.military.attitude_hunt">Hunt</span></label></div>
            <p id="military_attitude_help" class="w98-text" data-l10n="win98.military.attitude_help">What the squad does when it meets this target. Choosing a response does not start an attack.</p>
          </div>
        </section>
      </div>
      <div class="w98-buttonbar"><p id="military_status" class="w98-text w98-grow" role="status"></p><button id="military_close_button" class="w98-button w98-button--default" data-l10n="win98.common.close">Close</button></div>
    </div>
  </div>
  <div id="military_tooltip" class="c-tooltip c-management-tooltip" role="tooltip" aria-hidden="true"></div>
  </template>
</body>
</rml>
