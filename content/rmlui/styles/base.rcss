/* Generated-value companion to tokens.json. Keep values synchronized through
   tests/ui-design-system/verify-design-system.cmake. */

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    color: #f1eee6;
    background-color: #101315;
    font-family: LatoLatin;
    font-size: 15dp;
    line-height: 22dp;
    nav: auto;
}

h1, h2, h3, p, ul {
    display: block;
    margin: 0;
}

h1 {
    color: #f1eee6;
    font-size: 26dp;
    line-height: 34dp;
}

h2 {
    color: #f1eee6;
    font-size: 20dp;
    line-height: 28dp;
}

h3 {
    color: #c8c7bf;
    font-size: 17dp;
    line-height: 24dp;
}

p {
    color: #c8c7bf;
    margin-bottom: 8dp;
}

button, input, select, textarea {
    color: #f1eee6;
    font-family: LatoLatin;
    font-size: 14dp;
    tab-index: auto;
    nav: auto;
}

button {
    min-height: 40dp;
    padding: 8dp 12dp;
    background-color: #2d373b;
    border-width: 1dp;
    border-color: #596166;
    border-radius: 4dp;
    cursor: pointer;
}

button:hover {
    background-color: #344046;
    border-color: #7a858a;
}

button:active {
    background-color: #182024;
    border-color: #c69456;
}

button:focus-visible,
input:focus-visible,
select:focus-visible,
textarea:focus-visible,
[tab-index]:focus-visible {
    border-width: 2dp;
    border-color: #ffd27a;
}

button:disabled,
input:disabled,
select:disabled,
textarea:disabled {
    color: #7f8583;
    background-color: #171b1d;
    border-color: #30373a;
    cursor: unavailable;
}

input.text,
input.password,
textarea,
select {
    min-height: 40dp;
    padding: 8dp 12dp;
    color: #f1eee6;
    background-color: #13191b;
    border-width: 1dp;
    border-color: #596166;
    border-radius: 4dp;
}

textarea {
    min-height: 96dp;
    cursor: text;
}

select {
    width: 100%;
}

select selectvalue {
    width: auto;
    height: 38dp;
    margin-right: 36dp;
    padding: 9dp 12dp;
    background-color: #13191b;
}

select selectarrow {
    width: 36dp;
    height: 38dp;
    background-color: #2d373b;
    border-left-width: 1dp;
    border-left-color: #596166;
}

select selectarrow:hover,
select selectarrow:checked {
    background-color: #493a2b;
}

select selectbox {
    width: 100%;
    margin-top: 2dp;
    padding: 4dp;
    background-color: #252d31;
    border-width: 1dp;
    border-color: #7a858a;
}

select selectbox option {
    min-height: 36dp;
    padding: 8dp 12dp;
    background-color: #252d31;
}

select selectbox option:hover {
    background-color: #344046;
}

select selectbox option:checked {
    color: #f1eee6;
    background-color: #493a2b;
    border-left-width: 3dp;
    border-left-color: #d19a55;
}

input.checkbox,
input.radio {
    width: 24dp;
    height: 24dp;
    margin-right: 8dp;
    vertical-align: -6dp;
    background-color: #13191b;
    border-width: 2dp;
    border-color: #7a858a;
}

input.radio {
    border-radius: 12dp;
}

input.checkbox:checked,
input.radio:checked {
    background-color: #d19a55;
    border-width: 5dp;
    border-color: #493a2b;
}

.u-muted { color: #9fa4a1; }
.u-secondary { color: #c8c7bf; }
.u-danger { color: #e27b70; }
.u-success { color: #77be78; }
.u-row { display: flex; flex-direction: row; align-items: center; gap: 8dp; }
.u-column { display: flex; flex-direction: column; gap: 8dp; }
.u-grow { flex: 1; }
.u-right { text-align: right; }
.u-hidden { display: none; }

/* Classic park-management skin. This is intentionally centralized: the
   application keeps the typed routes and action wiring, while the visual
   language moves toward compact, beveled Windows-era management panels. */
body {
    color: #142333;
    background-color: transparent;
    font-size: 13dp;
    line-height: 18dp;
}

h1 { color: #142333; font-size: 24dp; line-height: 30dp; }
h2 { color: #142333; font-size: 17dp; line-height: 22dp; }
h3 { color: #24415a; font-size: 14dp; line-height: 19dp; }
p { color: #2f4659; margin-bottom: 6dp; }

button, input, select, textarea {
    color: #142333;
    font-size: 13dp;
}

button {
    min-height: 30dp;
    padding: 5dp 9dp;
    background-color: #d5dde0;
    border-width: 2dp;
    border-top-color: #f7faf8;
    border-left-color: #f7faf8;
    border-right-color: #4d6476;
    border-bottom-color: #4d6476;
    border-radius: 2dp;
}

button:hover {
    color: #142333;
    background-color: #e9d36e;
    border-top-color: #fffbe3;
    border-left-color: #fffbe3;
    border-right-color: #855d19;
    border-bottom-color: #855d19;
}

button:active {
    background-color: #efb648;
    border-top-color: #4d6476;
    border-left-color: #4d6476;
    border-right-color: #f7faf8;
    border-bottom-color: #f7faf8;
}

button:focus-visible,
input:focus-visible,
select:focus-visible,
textarea:focus-visible,
[tab-index]:focus-visible {
    border-width: 2dp;
    border-color: #d47a20;
}

button:disabled,
input:disabled,
select:disabled,
textarea:disabled {
    color: #74818a;
    background-color: #b9c3c8;
    border-top-color: #dbe1e2;
    border-left-color: #dbe1e2;
    border-right-color: #7b8991;
    border-bottom-color: #7b8991;
}

input.text,
input.password,
textarea,
select {
    min-height: 30dp;
    padding: 5dp 8dp;
    color: #142333;
    background-color: #f3f5ef;
    border-width: 2dp;
    border-top-color: #4d6476;
    border-left-color: #4d6476;
    border-right-color: #f7faf8;
    border-bottom-color: #f7faf8;
    border-radius: 1dp;
}

input.checkbox {
    width: 20dp;
    height: 20dp;
    margin-right: 7dp;
    vertical-align: middle;
    background-color: #f3f5ef;
    border-width: 2dp;
    border-top-color: #4d6476;
    border-left-color: #4d6476;
    border-right-color: #f7faf8;
    border-bottom-color: #f7faf8;
    border-radius: 1dp;
}
input.checkbox:checked {
    background-color: #f1ca4f;
    border-width: 4dp;
    border-color: #855d19;
}

/* Keep the historical token strings discoverable for the migration verifier;
   active declarations above are the classic-park skin values. */
/* legacy tokens: #101315 #252d31 #13191b #f1eee6 #ffd27a #d19a55 #71b7d3 #77be78 #e0b45d #e27b70 */
