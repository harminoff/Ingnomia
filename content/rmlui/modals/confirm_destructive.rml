<rml>
<head>
    <title data-l10n="shell.confirm.confirm_action">Confirm action</title>
    <link type="text/rcss" href="/styles/base.rcss" /><link type="text/rcss" href="/styles/components.rcss" /><link type="text/rcss" href="/styles/accessibility.rcss" />
</head>
<body class="c-modal-stage">
    <div class="c-modal-scrim"></div>
    <section class="c-modal c-modal--danger">
        <header class="c-modal__header"><h2 id="confirm-title" data-l10n="shell.confirm.confirm-title">Confirm action</h2></header>
        <div class="c-modal__body"><div class="c-alert-row c-alert-row--danger"><span class="c-alert-row__marker">!</span><span class="c-alert-row__body"><span id="confirm-detail" class="c-alert-row__detail" data-l10n="shell.confirm.confirm-detail">This action may discard unsaved progress.</span></span></div></div>
        <footer class="c-modal__actions"><button id="confirm-cancel" class="c-button c-button--primary" data-l10n="shell.confirm.confirm-cancel">Cancel</button><button id="confirm-accept" class="c-button c-button--danger" data-l10n="shell.confirm.confirm-accept">Confirm</button></footer>
    </section>
</body>
</rml>
