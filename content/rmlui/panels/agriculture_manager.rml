<rml>
<head><link type="text/template" href="/templates/management_window.rml"/><link type="text/rcss" href="../screens/management6a.rcss"/></head>
<body id="agriculture_manager_root" class="l-m6a-root is-hidden"><template src="management-window"><main id="agriculture_workbench" class="c-window l-m6a-panel l-agriculture-panel">
  <header class="c-title-bar l-m6a-title"><handle class="c-title-bar__drag-handle l-m6a-drag-handle" move_target="agriculture_workbench" edge_margin="76dp 12dp 58dp 12dp"><span class="c-title-bar__mark" aria-hidden="true"></span><div class="l-m6a-title__copy"><small id="agriculture_kind" data-l10n="management.agriculture.agriculture_kind">Agriculture</small><h2 id="agriculture_title" data-l10n="management.agriculture.agriculture_title">Designation</h2></div></handle><button id="agriculture_close" class="c-button" data-l10n="management.agriculture.agriculture_close">Close</button></header>
<div class="c-window__body l-agriculture-body">
<aside class="l-stockpile-rail" aria-label="Agriculture navigation"><section class="l-stockpile-rail-section"><h3 class="l-stockpile-rail-heading" data-l10n="management.agriculture.views">Views</h3><nav class="l-stockpile-view-tabs" role="tablist" aria-label="Agriculture views" aria-orientation="vertical"><button id="agriculture_view_overview" class="c-button l-stockpile-rail-button is-selected" role="tab" aria-selected="true" data-l10n="management.agriculture.view_overview">Overview</button><button id="agriculture_view_products" class="c-button l-stockpile-rail-button" role="tab" aria-selected="false" data-l10n="management.agriculture.view_products">Products</button><button id="agriculture_view_settings" class="c-button l-stockpile-rail-button" role="tab" aria-selected="false" data-l10n="management.agriculture.view_settings">Settings</button><button id="agriculture_view_work" class="c-button l-stockpile-rail-button" role="tab" aria-selected="false" data-l10n="management.agriculture.view_harvest">Harvest</button></nav><button id="agriculture_locate" class="c-button l-stockpile-rail-button" data-l10n="management.agriculture.agriculture_locate">Locate</button></section></aside>
<div class="l-agriculture-main">
  <div id="agriculture_loading" class="c-m6a-state" data-l10n="management.agriculture.agriculture_loading">Loading designation data...</div><div id="agriculture_empty" class="c-m6a-state is-hidden" data-l10n="management.agriculture.agriculture_empty">No data is available for this designation.</div><div id="agriculture_error" class="c-m6a-state is-error is-hidden"></div>
<div id="agriculture_content" class="l-agriculture-panes is-hidden">
<section id="agriculture_overview_pane" class="l-agriculture-pane" role="tabpanel" aria-labelledby="agriculture_view_overview"><h3 id="agriculture_overview_heading" data-l10n="management.agriculture.farm_overview">Farm overview</h3><p id="agriculture_overview_product" class="l-agriculture-current-product"></p><div id="agriculture_farm_counts" class="l-agriculture-stats"><div><span data-l10n="management.agriculture.plots">Plots</span><strong id="agriculture_plots">0</strong></div><div><span data-l10n="management.agriculture.tilled">Tilled</span><strong id="agriculture_tilled">0</strong></div><div><span data-l10n="management.agriculture.planted">Planted</span><strong id="agriculture_planted">0</strong></div><div><span data-l10n="management.agriculture.ready">Ready to harvest</span><strong id="agriculture_ready">0</strong></div></div><p id="agriculture_overview_summary"></p></section>
<section id="agriculture_products_pane" class="l-agriculture-pane is-hidden" role="tabpanel" aria-labelledby="agriculture_view_products"><h3 data-l10n="management.agriculture.view_products">Products</h3><p id="agriculture_current_product"></p><div id="agriculture_product_counts" class="l-agriculture-stats"><div><span data-l10n="management.agriculture.seeds_available">Seeds available</span><strong id="agriculture_product_seeds">0</strong></div><div><span data-l10n="management.agriculture.items_in_storage">Items in storage</span><strong id="agriculture_product_items">0</strong></div><div><span data-l10n="management.agriculture.plants_on_map">Plants on map</span><strong id="agriculture_product_plants">0</strong></div></div><div id="agriculture_farm_planner" class="l-farm-planner is-hidden">
<div class="l-farm-planner__grid-panel">
<div class="l-farm-planner__heading"><h3 data-l10n="management.agriculture.plots">Plots</h3><span id="agriculture_plot_selection_count"></span></div>
<div class="l-farm-planner__toolbar"><button id="agriculture_plot_select_all" class="c-button" data-l10n="management.agriculture.plot_select_all">Select all</button><button id="agriculture_plot_clear" class="c-button" data-l10n="management.agriculture.plot_clear">Clear</button></div>
<div id="agriculture_plot_grid" class="l-farm-plot-grid" role="group" aria-label="Farm plots"></div>
<p class="l-farm-planner__legend" data-l10n="management.agriculture.plot_legend">Gray: empty · Brown: tilled · Green: planted · Gold: ready</p>
</div>
<div class="l-farm-planner__editor">
<h3 data-l10n="management.agriculture.crop_plan">Crop plan</h3><p id="agriculture_plot_detail"></p>
<input id="agriculture_farm_search" class="text" type="text" value="" placeholder="Find a crop" data-l10n-placeholder="management.agriculture.crop_search"/>
<div id="agriculture_farm_catalog" class="l-farm-crop-list" role="listbox" aria-label="Crops"></div>
<p id="agriculture_farm_chosen_crop"></p><p id="agriculture_farm_crop_counts"></p>
<div class="l-farm-planner__toolbar"><button id="agriculture_plot_assign" class="c-button" data-l10n="management.agriculture.assign_crop">Assign crop</button><button id="agriculture_plot_default" class="c-button" data-l10n="management.agriculture.use_default_crop">Use farm default</button><button id="agriculture_farm_default_crop" class="c-button" data-l10n="management.agriculture.set_farm_default" title="Sets the fallback crop for plots without an assigned crop or queued planting." data-l10n-title="management.agriculture.set_farm_default_help">Set farm default</button></div>
<label class="l-farm-planner__count"><span data-l10n="management.agriculture.plantings_per_plot">Plantings per plot</span><input id="agriculture_plot_count" class="text" type="number" min="1" max="9999" value="1"/></label>
<div class="l-farm-planner__toolbar"><button id="agriculture_plot_queue" class="c-button" data-l10n="management.agriculture.queue_plantings">Queue plantings</button><button id="agriculture_plot_repeat" class="c-button" data-l10n="management.agriculture.queue_repeat">Queue repeat</button></div>
<p class="l-farm-planner__help" data-l10n="management.agriculture.queue_help">Count means plantings on each selected plot. After the queue, its assigned crop or farm default resumes. Repeat moves behind later orders.</p>
<h3 data-l10n="management.agriculture.plot_queue">Plot queue</h3><div id="agriculture_plot_orders" class="l-farm-order-list"></div>
</div></div>
  <div class="l-m6a-toolbar"><input id="agriculture_search" class="text" type="text" value=""  placeholder="Filter loaded products or animals" data-l10n-placeholder="management.agriculture.agriculture_search.placeholder"/><button id="agriculture_sort" class="c-dropdown-button" data-l10n="management.agriculture.agriculture_sort">Sort A-Z v</button><button id="agriculture_page_previous" class="c-button" data-l10n="management.agriculture.agriculture_page_previous">Previous rows</button><button id="agriculture_page_next" class="c-button" data-l10n="management.agriculture.agriculture_page_next">Next rows</button><button id="agriculture_refresh" class="c-button" data-l10n="management.agriculture.agriculture_refresh">Refresh</button></div>      <section class="l-agriculture-section"><h3 data-l10n="management.agriculture.product">Product</h3><p id="agriculture_product_selection"></p><div id="agriculture_products" class="c-m6a-list"></div><div class="l-m6a-actions"><button id="agriculture_next_product" class="c-button" data-l10n="management.agriculture.agriculture_next_product">Next product</button><button id="agriculture_apply_product" class="c-button" data-l10n="management.agriculture.agriculture_apply_product">Use selected product</button></div></section></section>
<section id="agriculture_settings_pane" class="l-agriculture-pane is-hidden" role="tabpanel" aria-labelledby="agriculture_view_settings">    <div class="l-agriculture-section"><h3 data-l10n="management.agriculture.designation_controls">Designation controls</h3><div class="l-agriculture-fields"><label><span data-l10n="management.agriculture.name">Name</span><input id="agriculture_name" class="text" type="text" value=""/></label><label><span data-l10n="management.agriculture.priority">Priority</span><input id="agriculture_priority" class="text" type="number" value="1" min="1"/></label></div><p id="agriculture_summary"></p><div class="l-m6a-actions"><button id="agriculture_apply_basics" class="c-button" data-l10n="management.agriculture.agriculture_apply_basics">Apply name and priority</button><button id="agriculture_toggle_suspended" class="c-check-button is-unchecked" data-l10n="management.agriculture.agriculture_toggle_suspended">☐ Suspend</button></div></div></section>
<section id="agriculture_work_pane" class="l-agriculture-pane is-hidden" role="tabpanel" aria-labelledby="agriculture_view_work">
      <section id="agriculture_farm" class="l-m6a-section is-hidden"><h3 data-l10n="management.agriculture.farm_harvest">Farm harvest</h3><p id="agriculture_farm_harvest_summary"></p><button id="agriculture_toggle_harvest" class="c-check-button is-unchecked" data-l10n="management.agriculture.agriculture_toggle_harvest">☐ Harvest</button></section>
      <section id="agriculture_grove" class="l-m6a-section is-hidden"><h3 data-l10n="management.agriculture.grove_work">Grove work</h3><div class="l-m6a-actions"><button id="agriculture_toggle_pick" class="c-check-button is-unchecked" data-l10n="management.agriculture.agriculture_toggle_pick">☐ Pick fruit</button><button id="agriculture_toggle_plant" class="c-check-button is-unchecked" data-l10n="management.agriculture.agriculture_toggle_plant">☐ Plant trees</button><button id="agriculture_toggle_fell" class="c-check-button is-unchecked" data-l10n="management.agriculture.agriculture_toggle_fell">☐ Fell trees</button></div></section>
      <section id="agriculture_pasture" class="l-m6a-section is-hidden"><h3 data-l10n="management.agriculture.pasture">Pasture</h3><p id="agriculture_pasture_summary"></p><div class="l-m6a-actions"><button id="agriculture_toggle_pasture_harvest" class="c-check-button is-unchecked" data-l10n="management.agriculture.agriculture_toggle_pasture_harvest">☐ Harvest products</button><button id="agriculture_toggle_hay" class="c-check-button is-unchecked" data-l10n="management.agriculture.agriculture_toggle_hay">☐ Harvest hay</button><button id="agriculture_toggle_tame" class="c-check-button is-unchecked" data-l10n="management.agriculture.agriculture_toggle_tame">☐ Tame wild animals</button></div><p id="agriculture_animal_selection"></p><div id="agriculture_animals" class="c-m6a-list"></div><div class="l-m6a-actions"><button id="agriculture_next_animal" class="c-button" data-l10n="management.agriculture.agriculture_next_animal">Next animal</button><button id="agriculture_toggle_butcher" class="c-check-button c-button--danger is-unchecked" data-l10n="management.agriculture.agriculture_toggle_butcher">☐ Toggle butchering</button><button id="agriculture_male_cap_down" class="c-dropdown-button" data-l10n="management.agriculture.agriculture_male_cap_down">Male cap −</button><button id="agriculture_male_cap_up" class="c-dropdown-button" data-l10n="management.agriculture.agriculture_male_cap_up">Male cap +</button><button id="agriculture_female_cap_down" class="c-dropdown-button" data-l10n="management.agriculture.agriculture_female_cap_down">Female cap −</button><button id="agriculture_female_cap_up" class="c-dropdown-button" data-l10n="management.agriculture.agriculture_female_cap_up">Female cap +</button></div><div id="agriculture_foods" class="c-m6a-list"></div><button id="agriculture_toggle_first_food" class="c-check-button is-unchecked" data-l10n="management.agriculture.agriculture_toggle_first_food">☐ Toggle first food rule</button></section>
</section></div><p id="agriculture_status" class="c-m6a-status"></p></div></div></main></template></body></rml>
