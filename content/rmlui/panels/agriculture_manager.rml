<rml>
<head><link type="text/rcss" href="../styles/base.rcss"/><link type="text/rcss" href="../styles/components.rcss"/><link type="text/rcss" href="../styles/accessibility.rcss"/><link type="text/rcss" href="../screens/management6a.rcss"/></head>
<body id="agriculture_manager_root" class="l-m6a-root is-hidden"><section id="agriculture_workbench" class="l-m6a-panel">
  <header class="l-m6a-title"><handle class="l-m6a-drag-handle" move_target="agriculture_workbench" edge_margin="76dp 12dp 58dp 12dp"><div class="l-m6a-title__copy"><small id="agriculture_kind" data-l10n="management.agriculture.agriculture_kind">Agriculture</small><h2 id="agriculture_title" data-l10n="management.agriculture.agriculture_title">Designation</h2></div></handle><button id="agriculture_locate" class="c-button" data-l10n="management.agriculture.agriculture_locate">Locate</button><button id="agriculture_close" class="c-button" data-l10n="management.agriculture.agriculture_close">Close</button></header>
  <div class="l-m6a-toolbar"><input id="agriculture_search" class="text" type="text" value=""  placeholder="Filter loaded products or animals" data-l10n-placeholder="management.agriculture.agriculture_search.placeholder"/><button id="agriculture_sort" class="c-dropdown-button" data-l10n="management.agriculture.agriculture_sort">Sort A-Z v</button><button id="agriculture_page_previous" class="c-button" data-l10n="management.agriculture.agriculture_page_previous">Previous rows</button><button id="agriculture_page_next" class="c-button" data-l10n="management.agriculture.agriculture_page_next">Next rows</button><button id="agriculture_refresh" class="c-button" data-l10n="management.agriculture.agriculture_refresh">Refresh</button></div>
  <div class="l-m6a-scroll"><div id="agriculture_loading" class="c-m6a-state" data-l10n="management.agriculture.agriculture_loading">Loading designation data...</div><div id="agriculture_empty" class="c-m6a-state is-hidden" data-l10n="management.agriculture.agriculture_empty">No data is available for this designation.</div><div id="agriculture_error" class="c-m6a-state is-error is-hidden"></div>
    <section id="agriculture_content" class="is-hidden"><div class="l-m6a-section"><h3 data-l10n="management.agriculture.designation_controls">Designation controls</h3><div class="l-m6a-grid"><input id="agriculture_name" class="text" type="text" value=""/><input id="agriculture_priority" class="text" type="number" value="1" min="1"/></div><p id="agriculture_summary"></p><div class="l-m6a-actions"><button id="agriculture_apply_basics" class="c-button" data-l10n="management.agriculture.agriculture_apply_basics">Apply name and priority</button><button id="agriculture_toggle_suspended" class="c-check-button is-unchecked" data-l10n="management.agriculture.agriculture_toggle_suspended">☐ Suspend</button></div></div>
      <section class="l-m6a-section"><h3 data-l10n="management.agriculture.product">Product</h3><p id="agriculture_product_selection"></p><div id="agriculture_products" class="c-m6a-list"></div><div class="l-m6a-actions"><button id="agriculture_next_product" class="c-button" data-l10n="management.agriculture.agriculture_next_product">Next product</button><button id="agriculture_apply_product" class="c-button" data-l10n="management.agriculture.agriculture_apply_product">Use selected product</button></div></section>
      <section id="agriculture_farm" class="l-m6a-section is-hidden"><h3 data-l10n="management.agriculture.farm_harvest">Farm harvest</h3><button id="agriculture_toggle_harvest" class="c-check-button is-unchecked" data-l10n="management.agriculture.agriculture_toggle_harvest">☐ Harvest</button></section>
      <section id="agriculture_grove" class="l-m6a-section is-hidden"><h3 data-l10n="management.agriculture.grove_work">Grove work</h3><div class="l-m6a-actions"><button id="agriculture_toggle_pick" class="c-check-button is-unchecked" data-l10n="management.agriculture.agriculture_toggle_pick">☐ Pick fruit</button><button id="agriculture_toggle_plant" class="c-check-button is-unchecked" data-l10n="management.agriculture.agriculture_toggle_plant">☐ Plant trees</button><button id="agriculture_toggle_fell" class="c-check-button is-unchecked" data-l10n="management.agriculture.agriculture_toggle_fell">☐ Fell trees</button></div></section>
      <section id="agriculture_pasture" class="l-m6a-section is-hidden"><h3 data-l10n="management.agriculture.pasture">Pasture</h3><p id="agriculture_pasture_summary"></p><div class="l-m6a-actions"><button id="agriculture_toggle_pasture_harvest" class="c-check-button is-unchecked" data-l10n="management.agriculture.agriculture_toggle_pasture_harvest">☐ Harvest products</button><button id="agriculture_toggle_hay" class="c-check-button is-unchecked" data-l10n="management.agriculture.agriculture_toggle_hay">☐ Harvest hay</button><button id="agriculture_toggle_tame" class="c-check-button is-unchecked" data-l10n="management.agriculture.agriculture_toggle_tame">☐ Tame wild animals</button></div><p id="agriculture_animal_selection"></p><div id="agriculture_animals" class="c-m6a-list"></div><div class="l-m6a-actions"><button id="agriculture_next_animal" class="c-button" data-l10n="management.agriculture.agriculture_next_animal">Next animal</button><button id="agriculture_toggle_butcher" class="c-check-button c-button--danger is-unchecked" data-l10n="management.agriculture.agriculture_toggle_butcher">☐ Toggle butchering</button><button id="agriculture_male_cap_down" class="c-dropdown-button" data-l10n="management.agriculture.agriculture_male_cap_down">Male cap −</button><button id="agriculture_male_cap_up" class="c-dropdown-button" data-l10n="management.agriculture.agriculture_male_cap_up">Male cap +</button><button id="agriculture_female_cap_down" class="c-dropdown-button" data-l10n="management.agriculture.agriculture_female_cap_down">Female cap −</button><button id="agriculture_female_cap_up" class="c-dropdown-button" data-l10n="management.agriculture.agriculture_female_cap_up">Female cap +</button></div><div id="agriculture_foods" class="c-m6a-list"></div><button id="agriculture_toggle_first_food" class="c-check-button is-unchecked" data-l10n="management.agriculture.agriculture_toggle_first_food">☐ Toggle first food rule</button></section>
      <p class="c-m6a-warning" data-l10n="management.agriculture.growth_forecasts_yield_trends_and_soil_quality_a">Growth forecasts, yield trends, and soil quality are omitted because no accepted source exists.</p>
    </section><p id="agriculture_status" class="c-m6a-status"></p></div>
</section></body></rml>
