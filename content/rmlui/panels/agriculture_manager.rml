<rml>
<head><title>Agriculture</title><link type="text/template" href="/templates/management_window.rml"/><link type="text/rcss" href="../screens/management6a.rcss"/><link type="text/rcss" href="/screens/win98_classic.rcss"/><link type="text/rcss" href="/styles/accessibility.rcss"/></head>
<body id="agriculture_manager_root" class="l-m6a-root is-hidden">
<template src="management-window">
<!-- Windows 98 property sheet (252 x 218 DLU): pages never scroll; OK / Cancel / Apply apply the pending settings.
     Plot commands (Assign Crop, Queue ...) act immediately on the named plots, like a command button on a page. -->
<section id="agriculture_workbench" class="c-window l-m6a-panel w98-sheet">
  <header class="w98-caption"><handle class="c-title-bar__drag-handle l-m6a-drag-handle" move_target="agriculture_workbench"><h2 id="agriculture_title" class="c-title-bar__title"></h2></handle><button id="agriculture_close" class="w98-caption__close" title="Close" data-l10n-title="win98.agriculture.close.title" aria-label="Close">&#x00D7;</button></header>
  <div class="w98-sheet__body">
    <nav id="agriculture_tabs" class="c-tabs c-connected-tabs w98-tabs" role="tablist"><button id="agriculture_view_general" class="c-tabs__tab" role="tab" aria-controls="agriculture_general_pane" data-l10n="win98.agriculture.view_general">General</button><button id="agriculture_view_plots" class="c-tabs__tab" role="tab" aria-controls="agriculture_plots_pane" data-l10n="win98.agriculture.view_plots">Plots</button><button id="agriculture_view_queue" class="c-tabs__tab" role="tab" aria-controls="agriculture_queue_pane" data-l10n="win98.agriculture.view_queue">Plot Queue</button><button id="agriculture_view_crops" class="c-tabs__tab" role="tab" aria-controls="agriculture_crops_pane"></button><button id="agriculture_view_animals" class="c-tabs__tab" role="tab" aria-controls="agriculture_animals_pane" data-l10n="win98.agriculture.view_animals">Animals</button><button id="agriculture_view_food" class="c-tabs__tab" role="tab" aria-controls="agriculture_food_pane" data-l10n="win98.agriculture.view_food">Food</button></nav>
    <div id="agriculture_scroll" class="w98-page-frame">
      <p id="agriculture_loading" class="w98-text" data-l10n="win98.agriculture.loading">Loading designation data...</p><p id="agriculture_empty" class="w98-text is-hidden" data-l10n="win98.agriculture.empty">No data is available for this designation.</p><p id="agriculture_error" class="w98-text is-hidden"></p>
      <div id="agriculture_content" class="w98-page is-hidden">

        <section id="agriculture_general_pane" class="w98-page w98-col" role="tabpanel" aria-labelledby="agriculture_view_general">
          <div class="w98-line"><label class="w98-label" for="agriculture_name" data-l10n="win98.agriculture.name">Name:</label><input id="agriculture_name" class="w98-field w98-field--wide" type="text"/></div>
          <div class="w98-separator"></div>
          <div id="agriculture_work_farm" class="w98-group"><span class="w98-group__title" data-l10n="win98.agriculture.work">Work</span>
            <label class="w98-check" for="agriculture_toggle_harvest"><input id="agriculture_toggle_harvest" class="checkbox" type="checkbox"/><span data-l10n="win98.agriculture.toggle_harvest">Harvest ripe crops</span></label>
          </div>
          <div id="agriculture_work_grove" class="w98-group"><span class="w98-group__title" data-l10n="win98.agriculture.work">Work</span>
            <label class="w98-check" for="agriculture_toggle_pick"><input id="agriculture_toggle_pick" class="checkbox" type="checkbox"/><span data-l10n="win98.agriculture.toggle_pick">Pick fruit</span></label>
            <label class="w98-check" for="agriculture_toggle_plant"><input id="agriculture_toggle_plant" class="checkbox" type="checkbox"/><span data-l10n="win98.agriculture.toggle_plant">Plant trees</span></label>
            <label class="w98-check" for="agriculture_toggle_fell"><input id="agriculture_toggle_fell" class="checkbox" type="checkbox"/><span data-l10n="win98.agriculture.toggle_fell">Fell trees (removes the trees for wood)</span></label>
          </div>
          <div id="agriculture_work_pasture" class="w98-group"><span class="w98-group__title" data-l10n="win98.agriculture.work">Work</span>
            <label class="w98-check" for="agriculture_toggle_pasture_harvest"><input id="agriculture_toggle_pasture_harvest" class="checkbox" type="checkbox"/><span data-l10n="win98.agriculture.toggle_pasture_harvest">Harvest animal products</span></label>
            <label class="w98-check" for="agriculture_toggle_hay"><input id="agriculture_toggle_hay" class="checkbox" type="checkbox"/><span data-l10n="win98.agriculture.toggle_hay">Harvest hay</span></label>
            <label class="w98-check" for="agriculture_toggle_tame"><input id="agriculture_toggle_tame" class="checkbox" type="checkbox"/><span data-l10n="win98.agriculture.toggle_tame">Tame wild animals</span></label>
          </div>
          <div class="w98-group"><span class="w98-group__title" data-l10n="win98.agriculture.status">Status</span>
            <p id="agriculture_summary" class="w98-text"></p>
            <div class="w98-gap"></div>
            <div class="w98-line"><label class="w98-check w98-grow" for="agriculture_toggle_suspended"><input id="agriculture_toggle_suspended" class="checkbox" type="checkbox"/><span data-l10n="win98.agriculture.toggle_suspended">Suspend all work</span></label><button id="agriculture_locate" class="w98-button" data-l10n="win98.agriculture.locate">Center on Map</button></div>
          </div>
        </section>

        <section id="agriculture_plots_pane" class="w98-page w98-col is-hidden" role="tabpanel" aria-labelledby="agriculture_view_plots">
          <div class="w98-line"><span id="agriculture_plot_selection_count" class="w98-text w98-grow"></span><button id="agriculture_plot_select_all" class="w98-button" data-l10n="win98.agriculture.plot_select_all">Select All</button><button id="agriculture_plot_clear" class="w98-button" data-l10n="win98.agriculture.plot_clear">Clear</button></div>
          <div id="agriculture_plot_grid" class="w98-list w98-plot-grid w98-grow" role="listbox" aria-multiselectable="true" aria-label="Plots" tabindex="0"></div>
          <p class="w98-text w98-plot-legend"><span class="w98-plot-swatch"></span>Untilled<span class="w98-plot-swatch is-tilled"></span>Tilled<span class="w98-plot-swatch is-ready"></span>Ready  (faded icon: planned crop)</p>
          <p id="agriculture_plot_detail" class="w98-text" role="status"></p>
          <div class="w98-gap"></div>
          <div class="w98-group"><span id="agriculture_selected_title" class="w98-group__title"></span>
            <div class="w98-line"><label class="w98-label" for="agriculture_plot_crop" data-l10n="win98.agriculture.plot_crop">Crop:</label><select id="agriculture_plot_crop" class="w98-select w98-grow"></select><button id="agriculture_plot_assign" class="w98-button" data-l10n="win98.agriculture.plot_assign">Assign</button><button id="agriculture_plot_default" class="w98-button" data-l10n="win98.agriculture.plot_default">Use Default</button></div>
            <div class="w98-line"><label class="w98-label" for="agriculture_plot_count" title="Plantings to queue on each selected plot" data-l10n="win98.agriculture.plot_count">data-l10n-title="win98.agriculture.plantings_to_queue_on_each.title">Per plot:</label><div class="c-numeric-editor w98-spin"><input id="agriculture_plot_count" class="w98-field c-numeric-editor__input" type="text" value="1" min="1" max="99" step="1" inputmode="numeric"/><div class="c-numeric-editor__arrows"><button id="agriculture_plot_count-up" class="c-numeric-editor__up" aria-label="Increase plantings" title="Increase plantings" data-l10n-title="win98.agriculture.plot_count_up.title"/><button id="agriculture_plot_count-down" class="c-numeric-editor__down" aria-label="Decrease plantings" title="Decrease plantings" data-l10n-title="win98.agriculture.plot_count_down.title"/></div></div><button id="agriculture_plot_queue" class="w98-button" data-l10n="win98.agriculture.plot_queue">Queue</button><button id="agriculture_plot_repeat" class="w98-button" data-l10n="win98.agriculture.plot_repeat">Queue Repeat</button></div>
          </div>
        </section>

        <section id="agriculture_queue_pane" class="w98-page w98-col is-hidden" role="tabpanel" aria-labelledby="agriculture_view_queue">
          <p id="agriculture_queue_plot" class="w98-text"></p>
          <div class="w98-gap"></div>
          <label class="w98-label" for="agriculture_plot_orders" data-l10n="win98.agriculture.plot_orders">Plantings (run from top to bottom):</label>
          <div class="w98-row w98-row--fill w98-grow">
            <div class="w98-listview"><div class="w98-listview__header"><span style="flex: 1 1 auto;" data-l10n="win98.agriculture.crop">Crop</span><span class="w98-w-state" style="text-align: right;" data-l10n="win98.agriculture.plantings">Plantings</span></div><div id="agriculture_plot_orders" class="w98-list" role="listbox" aria-label="Plantings"></div></div>
            <div class="w98-stack"><button id="agriculture_order_up" class="w98-button" data-l10n="win98.agriculture.order_up">Move Up</button><button id="agriculture_order_down" class="w98-button" data-l10n="win98.agriculture.order_down">Move Down</button><button id="agriculture_order_remove" class="w98-button" data-l10n="win98.agriculture.order_remove">Remove</button></div>
          </div>
          <div class="w98-gap"></div>
          <p class="w98-text" data-l10n="win98.agriculture.when_the_queue_is_empty">When the queue is empty, the plot's assigned crop is planted, or the farm's default crop if none is assigned. A repeat planting moves behind later plantings each time it is planted.</p>
        </section>

        <section id="agriculture_crops_pane" class="w98-page w98-col is-hidden" role="tabpanel" aria-labelledby="agriculture_view_crops">
          <label id="agriculture_crops_label" class="w98-label" for="agriculture_farm_catalog"></label>
          <div class="w98-listview w98-grow"><div class="w98-listview__header"><span style="flex: 1 1 auto;" data-l10n="win98.agriculture.name_2">Name</span><span class="w98-w-stock" style="text-align: right;" data-l10n="win98.agriculture.seeds">Seeds</span><span class="w98-w-stock" style="text-align: right;" data-l10n="win98.agriculture.plants">Plants</span><span class="w98-w-stock" style="text-align: right;" data-l10n="win98.agriculture.stored">Stored</span></div><div id="agriculture_farm_catalog" class="w98-list" role="listbox" aria-label="Crops"></div></div>
          <div class="w98-gap"></div>
          <p id="agriculture_default_crop" class="w98-text" role="status"></p>
        </section>

        <section id="agriculture_animals_pane" class="w98-page w98-col is-hidden" role="tabpanel" aria-labelledby="agriculture_view_animals">
          <div class="w98-line"><label class="w98-label" for="agriculture_animal_type" data-l10n="win98.agriculture.animal_type">Type:</label><select id="agriculture_animal_type" class="w98-select w98-grow"></select></div>
          <div class="w98-gap"></div>
          <label class="w98-label" for="agriculture_animals" data-l10n="win98.agriculture.animals">Animals (check an animal to butcher it):</label>
          <div class="w98-listview w98-grow"><div class="w98-listview__header"><span style="flex: 1 1 auto;" data-l10n="win98.agriculture.name_2">Name</span><span class="w98-w-amount" data-l10n="win98.agriculture.sex">Sex</span><span class="w98-w-amount" data-l10n="win98.agriculture.age">Age</span></div><div id="agriculture_animals" class="w98-list" role="listbox" aria-multiselectable="true" aria-label="Animals"></div></div>
          <div class="w98-gap"></div>
          <div class="w98-group"><span class="w98-group__title" data-l10n="win98.agriculture.population_limits">Population limits</span>
            <div class="w98-line"><label class="w98-label" for="agriculture_male_cap" data-l10n="win98.agriculture.male_cap">Males:</label><div class="c-numeric-editor w98-spin"><input id="agriculture_male_cap" class="w98-field c-numeric-editor__input" type="text" value="0" min="0" max="99" step="1" inputmode="numeric"/><div class="c-numeric-editor__arrows"><button id="agriculture_male_cap-up" class="c-numeric-editor__up" aria-label="Increase male limit" title="Increase male limit" data-l10n-title="win98.agriculture.male_cap_up.title"/><button id="agriculture_male_cap-down" class="c-numeric-editor__down" aria-label="Decrease male limit" title="Decrease male limit" data-l10n-title="win98.agriculture.male_cap_down.title"/></div></div><label class="w98-label" for="agriculture_female_cap" data-l10n="win98.agriculture.female_cap">Females:</label><div class="c-numeric-editor w98-spin"><input id="agriculture_female_cap" class="w98-field c-numeric-editor__input" type="text" value="0" min="0" max="99" step="1" inputmode="numeric"/><div class="c-numeric-editor__arrows"><button id="agriculture_female_cap-up" class="c-numeric-editor__up" aria-label="Increase female limit" title="Increase female limit" data-l10n-title="win98.agriculture.female_cap_up.title"/><button id="agriculture_female_cap-down" class="c-numeric-editor__down" aria-label="Decrease female limit" title="Decrease female limit" data-l10n-title="win98.agriculture.female_cap_down.title"/></div></div></div>
            <p id="agriculture_pasture_summary" class="w98-text"></p>
          </div>
        </section>

        <section id="agriculture_food_pane" class="w98-page w98-col is-hidden" role="tabpanel" aria-labelledby="agriculture_view_food">
          <p id="agriculture_food_summary" class="w98-text"></p>
          <div class="w98-gap"></div>
          <label class="w98-label" for="agriculture_foods" data-l10n="win98.agriculture.foods">Animals may eat these foods:</label>
          <div id="agriculture_foods" class="w98-list w98-grow" role="listbox" aria-multiselectable="true" aria-label="Foods"></div>
        </section>

      </div>
    </div>
    <div class="w98-buttonbar"><button id="agriculture_ok" class="w98-button w98-button--default" data-l10n="win98.common.ok">OK</button><button id="agriculture_cancel" class="w98-button" data-l10n="win98.common.cancel">Cancel</button><button id="agriculture_apply" class="w98-button" data-l10n="win98.common.apply">Apply</button></div>
  </div>
</section>
</template>
</body></rml>
